@page "/master/rute"
@* Master Data -> Rute (revisi 13 Okt 2026): area pick up & destinasi dari Master Alamat, nama rute kesimpulan keduanya, No. Rute tetap.
   Klien tidak lagi di rute: dipilih di form trip. Panel "kode area mirip" dihapus (Baldy 19 Okt 2026): nama yang mirip memang tempat berbeda. *@
@inherits KomponenData
<PageTitle>Rute — BJM Logistik</PageTitle>

<PageHeader Title="Rute" Crumbs="@(new List<Crumb> { new("Master Data"), new("Rute") })">
    <Description>Area pick up &amp; destinasi diambil dari Master Alamat; nama rute kesimpulan keduanya. Klien dipilih di form trip. Nominal yang belum ada di data trip bertanda perkiraan.</Description>
    <Actions>
        <Tombol Icon="Ikon.Print" OnClick="() => _preview = true">Cetak</Tombol>
        <Tombol Variant="primary" Icon="Ikon.Plus" Disabled="@(!Bisa("master"))" OnClick="BukaTambah">Tambah Rute</Tombol>
    </Actions>
</PageHeader>

@{
    var baris = Baris;
    var pakai = KodeArea.Pemakaian(Db.Data.Rute);
    _pakaiKode = pakai;
    _namaArea = NamaArea();
}

<Kartu>
    <Toolbar>
        <Left>
            <SearchInput Value="@_tabel.Query" ValueChanged="v => _tabel.SetQuery(v)" Placeholder="Cari No. Rute, nama, atau kode area..." />
            <PanelFilter T="FilterRute" Filter="_filter" Chips="Chips">
                <Field Label="Area (pick up atau destinasi)">
                    <Pilihan Id="@context" Options="OpsiKode(pakai)" Value="@_filter.Draf.Kode" ValueChanged="v => _filter.Ubah(d => d.Kode = v ?? string.Empty)" Clearable="false" />
                </Field>
                @if (PakaiFeet)
                {
                    <Field Label="Feet">
                        <Pilihan Id="@context" Options="OpsiFeetFilter" Value="@_filter.Draf.Feet" ValueChanged="v => _filter.Ubah(d => d.Feet = v ?? string.Empty)" Cari="false" Clearable="false" />
                    </Field>
                }
                <Field Label="Nominal">
                    <Pilihan Id="@context" Options="OpsiKira" Value="@_filter.Draf.Kira" ValueChanged="v => _filter.Ubah(d => d.Kira = v ?? string.Empty)" Cari="false" Clearable="false" />
                </Field>
            </PanelFilter>
        </Left>
        <Right>
            <span class="fs-12-5 text-ink-3">
                @Db.Data.Rute.Count rute terdaftar@(JumlahKira > 0 ? $" · {JumlahKira} bernominal perkiraan" : "")
            </span>
        </Right>
    </Toolbar>
    @{
        _tabel.ExtraFilterActive = _filter.Aktif;
        var tersaring = _tabel.Saring(baris);
        var halaman = _tabel.Halaman(tersaring);
    }
    <DataTable T="BarisRute" Columns="Kolom" Rows="halaman" RowKey="r => r.R.Id" SortKey="@_tabel.SortKey" SortNaik="_tabel.Naik" OnSortChange="k => _tabel.ToggleSort(k)"
               IsFiltered="_tabel.IsFiltered" Footer="@(_tabel.Total > 0 ? BarisTotal(tersaring) : null)">
        <Empty><EmptyState Entity="rute" /></Empty>
        <NotFound><NotFoundState OnReset="ResetFilter" /></NotFound>
    </DataTable>
    @if (_tabel.Total > 0)
    {
        <Pagination Page="_tabel.Page" PageSize="_tabel.PageSize" Total="_tabel.Total" OnPageChange="p => _tabel.SetPage(p)" />
    }
</Kartu>

@* Form rute dipakai bersama form trip (tambah rute di tempat). *@
<FormRute Open="_formOpen" Rute="_editing" OnClose="() => _formOpen = false" />

<KonfirmasiDialog Open="_hapus is not null" Title="Hapus Data?" Message="Data yang sudah dihapus mungkin tidak dapat dikembalikan." ConfirmLabel="Hapus" Tone="danger"
                  OnCancel="() => _hapus = null" OnConfirm="HapusSekarang">
    <p class="m-0 mt-2 fs-13 fw-medium text-ink">@_hapus?.RouteCode — @_hapus?.RouteName</p>
</KonfirmasiDialog>

@if (_preview)
{
    <ReportPreview OnClose="() => _preview = false">
        @{
            var cetak = _tabel.Saring(Baris);
            var per = PrintDocument.BarisPerLembar(context, 24);
            var lembar = PrintDocument.Bagi(cetak, per);
            var kolomCetak = new List<(string, string, string?)> { ("No.", "right", "28px"), ("No. Rute", "left", null), ("Nama Rute", "left", null), ("Area Pick Up", "left", null), ("Area Destinasi", "left", null) };
            if (PakaiFeet) kolomCetak.Add(("Feet", "left", null));
            kolomCetak.AddRange([("Uang Jalan Rute", "right", null), ("Uang Tol", "right", null), ("Harga", "right", null)]);
            var subjudul = string.Join(" · ", new[] { PakaiFeet && _filter.Nilai.Feet != "" ? $"Feet: {_filter.Nilai.Feet}" : "", _filter.Nilai.Kode != "" ? $"Area: {_filter.Nilai.Kode}" : "" }.Where(x => x != ""));
            var meta = new List<(string, string)> { ("Jumlah rute", $"{Format.Angka(cetak.Count)} rute"), ("Total Harga", Format.Rupiah(cetak.Sum(b => b.R.Price))), ("Total Uang Tol", Format.Rupiah(cetak.Sum(b => b.R.Toll))) };
        }
        <PrintDocument>
            @for (var i = 0; i < lembar.Count; i++)
            {
                var ii = i; var isi = lembar[ii];
                <PrintPage Title="Daftar Rute" Subtitle="@(subjudul == "" ? "Seluruh rute terdaftar" : subjudul)" Page="@(ii + 1)" TotalPages="lembar.Count" Meta="meta">
                    <PrintTable Cols="kolomCetak">
                        @for (var r = 0; r < isi.Count; r++)
                        {
                            var rr = r; var x = isi[rr];
                            <tr>
                                <td class="p-sel text-end">@(ii * per + rr + 1)</td>
                                <td class="p-sel fw-medium">@x.R.RouteCode</td>
                                <td class="p-sel">@x.R.RouteName</td>
                                <td class="p-sel text-nowrap">@(x.AreaAsal == "" ? "—" : x.AreaAsal)</td>
                                <td class="p-sel text-nowrap">@(x.AreaTujuan == "" ? "—" : x.AreaTujuan)</td>
                                @if (PakaiFeet) { <td class="p-sel">@(x.R.Feet == "" ? "—" : x.R.Feet)</td> }
                                <td class="p-sel text-end">@Format.Angka(x.R.Ujroute)</td>
                                <td class="p-sel text-end">@Format.Angka(x.R.Toll)</td>
                                <td class="p-sel text-end">@Format.Angka(x.R.Price)</td>
                            </tr>
                        }
                        @if (ii == lembar.Count - 1)
                        {
                            <tr class="fw-bold" style="background:#f3f4f6">
                                <td class="p-sel text-end" colspan="@(kolomCetak.Count - 3)">TOTAL</td>
                                <td class="p-sel text-end">@Format.Angka(cetak.Sum(b => b.R.Ujroute))</td>
                                <td class="p-sel text-end">@Format.Angka(cetak.Sum(b => b.R.Toll))</td>
                                <td class="p-sel text-end">@Format.Angka(cetak.Sum(b => b.R.Price))</td>
                            </tr>
                        }
                    </PrintTable>
                </PrintPage>
            }
        </PrintDocument>
    </ReportPreview>
}

@code {
    public sealed class FilterRute { public string Kode { get; set; } = ""; public string Feet { get; set; } = ""; public string Kira { get; set; } = ""; }

    /// <summary>Baris tabel rute: rute beserta area pick up & destinasinya (dipilih di form rute, atau turunan nama lama).</summary>
    public sealed record BarisRute(Model.Rute R, string AreaAsal, string AreaTujuan);

    private readonly KendaliTabel<BarisRute> _tabel = new(10, "route_code");
    private KendaliFilter<FilterRute> _filter = default!;
    private Model.Rute? _editing;
    private bool _formOpen;
    private Model.Rute? _hapus;
    private bool _preview;
    private Dictionary<string, PakaiKode> _pakaiKode = [];
    private Dictionary<string, string> _namaArea = [];

    private static readonly List<Opsi> OpsiKira = [new("", "Semua"), new("ya", "Masih ada perkiraan"), new("tidak", "Sudah pasti")];
    private static readonly List<Opsi> OpsiFeetFilter = [new("", "Semua"), .. FormRute.PilihanFeet.Select(f => new Opsi(f, f)), new("-", "Belum diisi")];

    /// <summary>Feet = ukuran container, hanya untuk rute container Priok.</summary>
    private bool PakaiFeet => Sesi.Workspace == WorkspaceKode.Priok;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _filter = new KendaliFilter<FilterRute>(() => new FilterRute(), StateHasChanged);
        _tabel.Search = (r, q) => Util.CocokCari(q, r.R.RouteCode, r.R.RouteCodeLama ?? "", r.R.RouteName, r.R.Feet, r.AreaAsal, r.AreaTujuan);
        _tabel.SortAccessor = k => k switch
        {
            "route_name" => r => r.R.RouteName, "area_asal" => r => r.AreaAsal, "area_tujuan" => r => r.AreaTujuan, "feet" => r => r.R.Feet,
            "ujroute" => r => r.R.Ujroute, "toll" => r => r.R.Toll, "price" => r => r.R.Price, _ => r => r.R.RouteCode,
        };
        _tabel.ExtraFilter = r =>
        {
            var f = _filter.Nilai;
            return (f.Feet == "" || (f.Feet == "-" ? r.R.Feet == "" : r.R.Feet == f.Feet))
                && (f.Kode == "" || r.AreaAsal == f.Kode || r.AreaTujuan == f.Kode)
                && (f.Kira == "" || (f.Kira == "ya") == ((r.R.EstimatedFields?.Count ?? 0) > 0));
        };
    }

    protected override void OnAfterRender(bool pertama)
    {
        // Kode yang sudah tidak dipakai rute mana pun (mis. baru dirapikan) dilepas dari filter.
        var kode = _filter.Nilai.Kode;
        if (kode != "" && !_pakaiKode.ContainsKey(kode)) _filter.Lepas((n, a) => n.Kode = a.Kode);
    }

    private List<BarisRute> Baris => Db.Data.Rute.Select(r =>
    {
        var k = TripLogika.KodeArea(r);
        return new BarisRute(r, k.Asal, k.Tujuan);
    }).ToList();

    /// <summary>Nama tempat per kode area dari Master Alamat (alamat pertama; "+N" bila ada beberapa).</summary>
    private Dictionary<string, string> NamaArea() => Db.Data.Alamat
        .Where(a => a.KodeArea.Trim() != "")
        .GroupBy(a => a.KodeArea.Trim().ToUpperInvariant())
        .ToDictionary(g => g.Key, g => g.Count() > 1 ? $"{g.First().Nama} +{g.Count() - 1}" : g.First().Nama);

    private int JumlahKira => Db.Data.Rute.Count(r => (r.EstimatedFields?.Count ?? 0) > 0);

    private static List<Opsi> OpsiKode(Dictionary<string, PakaiKode> pakai) =>
        [new("", "Semua"), .. pakai.OrderBy(p => p.Key, StringComparer.Ordinal).Select(p => new Opsi(p.Key, $"{p.Key} ({p.Value.Rute})"))];

    private List<ChipFilter> Chips
    {
        get
        {
            var f = _filter.Nilai;
            var l = new List<ChipFilter>();
            if (f.Kode != "") l.Add(new($"Area: {f.Kode}", () => _filter.Lepas((n, a) => n.Kode = a.Kode)));
            if (PakaiFeet && f.Feet != "") l.Add(new($"Feet: {(f.Feet == "-" ? "belum diisi" : f.Feet)}", () => _filter.Lepas((n, a) => n.Feet = a.Feet)));
            if (f.Kira != "") l.Add(new(f.Kira == "ya" ? "Nominal masih perkiraan" : "Nominal sudah pasti", () => _filter.Lepas((n, a) => n.Kira = a.Kira)));
            return l;
        }
    }

    /// <summary>Jumlah trip (kedua workspace) yang memakai rute ini.</summary>
    private int DipakaiTrip(string id) => Db.Semua.Trip.Count(t => t.RouteId == id);

    private List<Kolom<BarisRute>> Kolom
    {
        get
        {
            var k = new List<Kolom<BarisRute>>
            {
                new() { Key = "route_code", Header = "No. Rute", Sortable = true, Width = "150px", Render = SelKode },
                new() { Key = "route_name", Header = "Nama Rute", Sortable = true, Render = r => @<span class="fw-medium">@r.R.RouteName</span> },
                new() { Key = "area_asal", Header = "Area Pick Up", Sortable = true, Width = "180px", Render = r => SelArea(r.AreaAsal) },
                new() { Key = "area_tujuan", Header = "Area Destinasi", Sortable = true, Width = "180px", Render = r => SelArea(r.AreaTujuan) },
            };
            if (PakaiFeet) k.Add(new() { Key = "feet", Header = "Feet", Sortable = true, Width = "86px", Render = SelFeet });
            k.Add(new() { Key = "ujroute", Header = "Uang Jalan Rute", Sortable = true, Align = "right", Width = "128px", Render = r => Nominal(r.R.Ujroute, r.R.EstimatedFields?.Contains("ujroute") == true, false) });
            k.Add(new() { Key = "toll", Header = "Uang Tol", Sortable = true, Align = "right", Width = "128px", Render = r => Nominal(r.R.Toll, r.R.EstimatedFields?.Contains("toll") == true, false) });
            k.Add(new() { Key = "price", Header = "Harga", Sortable = true, Align = "right", Width = "134px", Render = r => Nominal(r.R.Price, r.R.EstimatedFields?.Contains("price") == true, true) });
            k.Add(new() { Key = "action", Header = "Action", Align = "right", Width = "92px", NoPrint = true, Render = SelAksi });
            return k;
        }
    }

    private RenderFragment SelKode(BarisRute r) => @<span class="d-block lh-tight">
        <span class="tnum fw-semibold text-ink text-break">@r.R.RouteCode</span>
        @if (r.R.RouteCodeLama is not null)
        {
            <span class="tnum mt-1 d-block fs-11 text-ink-3" title="No. Rute dari aplikasi lama, sebelum dirapikan supaya tidak mirip rute lain. Masih bisa dicari.">dulu @r.R.RouteCodeLama</span>
        }
    </span>;

    /// <summary>Kode area dengan nama tempatnya (dari Master Alamat) di bawahnya.</summary>
    private RenderFragment SelArea(string kode)
    {
        if (kode == "") return @<span class="text-ink-3">—</span>;
        var nama = _namaArea.GetValueOrDefault(kode.ToUpperInvariant());
        return @<span class="d-block lh-tight">
            <span class="fs-12-5 fw-medium text-ink">@kode</span>
            @if (!string.IsNullOrEmpty(nama)) { <span class="mt-1 d-block fs-11-5 text-ink-3 text-truncate" title="@nama">@nama</span> }
        </span>;
    }

    private static RenderFragment SelFeet(BarisRute r)
    {
        if (r.R.Feet == "") return @<span class="text-ink-3">—</span>;
        return @<Badge Tone="neutral">@r.R.Feet</Badge>;
    }

    /// <summary>Nominal rute; yang masih perkiraan diberi keterangan kecil di bawahnya.</summary>
    private static RenderFragment Nominal(long nilai, bool kira, bool tebal) => @<span class="d-block lh-tight">
        <span class="tnum @(tebal ? "fw-semibold text-ink" : "")">@Format.Rupiah(nilai)</span>
        @if (kira)
        {
            <span class="mt-1 d-block fs-11 text-ink-3" title="Belum ada di data trip. Ganti lewat Ubah bila sudah tahu nilai sebenarnya.">perkiraan</span>
        }
    </span>;

    private RenderFragment SelAksi(BarisRute r)
    {
        var dipakai = DipakaiTrip(r.R.Id);
        var bisa = Bisa("master");
        return @<span class="d-inline-flex justify-content-end gap-1">
            <TombolIkon Label="Ubah" Icon="Ikon.Pen" Disabled="@(!bisa)" OnClick="() => BukaUbah(r.R)" />
            <TombolIkon Label="Hapus" Tone="danger" Icon="Ikon.TrashCan" Disabled="@(!bisa || dipakai > 0)" Title="@(bisa && dipakai > 0 ? $"Dipakai {dipakai} trip" : null)" OnClick="() => _hapus = r.R" />
        </span>;
    }

    /// <summary>Baris total: label menutup semua kolom sebelum Uang Jalan Rute, supaya jumlahnya tepat di bawah kolomnya.</summary>
    private RenderFragment BarisTotal(List<BarisRute> rows) => @<tr>
        <td class="px-3 py-2 fs-12 text-ink-2" colspan="@(PakaiFeet ? 5 : 4)">Total @Format.Angka(rows.Count) rute</td>
        <td class="tnum px-3 py-2 text-end fs-12-5">@Format.Rupiah(rows.Sum(x => x.R.Ujroute))</td>
        <td class="tnum px-3 py-2 text-end fs-12-5">@Format.Rupiah(rows.Sum(x => x.R.Toll))</td>
        <td class="tnum px-3 py-2 text-end fs-12-5 text-ink">@Format.Rupiah(rows.Sum(x => x.R.Price))</td>
        <td></td>
    </tr>;

    private void ResetFilter() { _tabel.Reset(); _filter.LepasSemua(); }
    private void BukaTambah() { _editing = null; _formOpen = true; }
    private void BukaUbah(Model.Rute r) { _editing = Db.Cari<Model.Rute>(r.Id) ?? r; _formOpen = true; }

    private void HapusSekarang()
    {
        if (_hapus is null) return;
        Db.Hapus<Model.Rute>(_hapus.Id);
        Toast.Sukses("Data berhasil dihapus.");
        _hapus = null;
    }
}
