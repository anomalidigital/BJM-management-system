@page "/master/klien"
@* Master -> Klien. Tipe layanan klien (Callout / Dedicated, revisi 13 Okt 2026) terbawa langsung ke form trip; kontrak klien Dedicated
   dikelola di halaman tiap klien. *@
@inherits KomponenData
<PageTitle>Klien / Pelanggan — BJM Logistik</PageTitle>

<PageHeader Title="Klien / Pelanggan" Crumbs="@(new List<Crumb> { new("Master Data"), new("Klien / Pelanggan") })">
    <Description>Tipe layanan klien (Callout / Dedicated) terbawa otomatis ke form trip. Kontrak klien Dedicated dikelola di halaman klien.</Description>
    <Actions>
        <Tombol Variant="primary" Icon="Ikon.Plus" Disabled="@(!Bisa("master"))" OnClick="BukaTambah">Tambah Klien</Tombol>
    </Actions>
</PageHeader>

@{
    var baris = Baris;
}
<Kartu>
    <Toolbar>
        <Left>
            <SearchInput Value="@_tabel.Query" ValueChanged="v => _tabel.SetQuery(v)" Placeholder="Cari kode atau nama klien..." />
            <PanelFilter T="FilterKlien" Filter="_filter" Chips="Chips">
                <Field Label="Tipe Layanan">
                    <Pilihan Id="@context" Options="OpsiTipeFilter" Value="@_filter.Draf.Layanan" ValueChanged="v => _filter.Ubah(d => d.Layanan = v ?? string.Empty)" Cari="false" Clearable="false" />
                </Field>
                <Field Label="Alur Dokumen">
                    <Pilihan Id="@context" Options="OpsiDokumen" Value="@_filter.Draf.Dokumen" ValueChanged="v => _filter.Ubah(d => d.Dokumen = v ?? string.Empty)" Cari="false" Clearable="false" />
                </Field>
                <Field Label="Status">
                    <Pilihan Id="@context" Options="OpsiStatusFilter" Value="@_filter.Draf.Status" ValueChanged="v => _filter.Ubah(d => d.Status = v ?? string.Empty)" Cari="false" Clearable="false" />
                </Field>
            </PanelFilter>
        </Left>
        <Right>
            <span class="fs-12-5 text-ink-3">@Db.Data.Klien.Count klien · @baris.Count(p => p.K.ClientType == TipeKlien.Dedicated) Dedicated</span>
        </Right>
    </Toolbar>
    @{
        _tabel.ExtraFilterActive = _filter.Aktif;
        var tersaring = _tabel.Saring(baris);
        var halaman = _tabel.Halaman(tersaring);
    }
    <DataTable T="BarisKlien" Columns="Kolom" Rows="halaman" RowKey="p => p.K.Id" SortKey="@_tabel.SortKey" SortNaik="_tabel.Naik" OnSortChange="k => _tabel.ToggleSort(k)" IsFiltered="_tabel.IsFiltered">
        <Empty><EmptyState Entity="klien" /></Empty>
        <NotFound><NotFoundState OnReset="ResetFilter" /></NotFound>
    </DataTable>
    @if (_tabel.Total > 0)
    {
        <Pagination Page="_tabel.Page" PageSize="_tabel.PageSize" Total="_tabel.Total" OnPageChange="p => _tabel.SetPage(p)" />
    }
</Kartu>

<Modal Open="_formOpen" Title="@(_editing is not null ? "Ubah Klien" : "Tambah Klien")"
       Subtitle="@(_editing?.ProjectCode ?? "Tanda * wajib diisi. Kontrak klien Dedicated ditambahkan setelah klien tersimpan.")" OnClose="() => _formOpen = false">
    <ChildContent>
        @if (_formOpen)
        {
            <div class="row g-3">
                <Field Label="Tipe Layanan" Required Error="@G("tipe")" Class="col-12" Hint="@Teks("Terdeteksi otomatis di form trip saat klien ini dipilih.")">
                    <div class="row g-3">
                        @foreach (var j in TipeKlien.Semua)
                        {
                            var jj = j;
                            <div class="col-sm-6">
                                <Radio Name="jenis-klien" Checked="@(_f.ClientType == jj)" OnChange="() => GantiTipe(jj)" Label="@TipeKlien.Label(jj)" Description="@TipeKlien.Keterangan(jj)" />
                            </div>
                        }
                    </div>
                </Field>
                <Field Label="Nama Klien" Required Error="@G("nama")" Class="col-12">
                    <input id="@context" class="form-control @(G("nama") is not null ? "is-invalid" : "")" value="@_f.ProjectName" placeholder="PT Delta Energi Riau"
                           @oninput="e => { _f.ProjectName = e.Value?.ToString() ?? string.Empty; _galat.Remove(NamaKunci); }" @onfocusout="IsiKodeDariNama" />
                </Field>
                <Field Label="Kode Klien" Required Error="@G("kode")" Class="col-sm-6" Hint="@Teks("Terisi dari singkatan Nama Klien (PT Delta Energi Riau → DER). Boleh diubah.")">
                    <KodeInput Id="@context" Value="@_f.ProjectCode" Invalid="@(G("kode") is not null)" Placeholder="Isi Nama Klien dulu" Uppercase GenerateTitle="Buat kode dari Nama Klien"
                               ValueChanged="@(v => { _f.ProjectCode = v; _galat.Remove("kode"); })" OnGenerate="GenerateKode" />
                </Field>
                <Field Label="Status" Class="col-sm-6">
                    <Pilihan Id="@context" Options="OpsiStatus" Value="@_f.Status" ValueChanged="v => _f.Status = v ?? StatusAktif" Cari="false" Clearable="false" />
                </Field>
                <Field Label="Deskripsi" Class="col-12">
                    <input id="@context" class="form-control" value="@_f.Description" @oninput="e => _f.Description = e.Value?.ToString() ?? string.Empty" />
                </Field>
                <div class="col-12">
                    <Checkbox Label="Trip klien ini memakai alur dokumen (No Referensi / No PI)" Checked="_f.RequiresDocument" CheckedChanged="v => _f.RequiresDocument = v" />
                    <p class="m-0 mt-1 fs-12 text-ink-3">Matikan untuk order tunai yang tidak melalui dokumen.</p>
                </div>
            </div>
        }
    </ChildContent>
    <Footer>
        <Tombol OnClick="() => _formOpen = false">Batal</Tombol>
        <Tombol Variant="primary" OnClick="Simpan">@(_editing is not null ? "Simpan Perubahan" : "Simpan")</Tombol>
    </Footer>
</Modal>

<KonfirmasiDialog Open="_hapus is not null" Title="@(KontrakMilik > 0 ? "Klien masih punya kontrak" : "Hapus Data?")" ConfirmLabel="@(KontrakMilik > 0 ? "Mengerti" : "Hapus")"
                  Tone="@(KontrakMilik > 0 ? "primary" : "danger")"
                  Message="@(KontrakMilik > 0 ? $"{_hapus?.ProjectName} masih punya {KontrakMilik} kontrak. Hapus kontraknya dulu di halaman klien, atau ubah status klien menjadi Nonaktif." : "Data yang sudah dihapus mungkin tidak dapat dikembalikan.")"
                  OnCancel="() => _hapus = null" OnConfirm="KonfirmasiHapus">
    @if (KontrakMilik == 0)
    {
        <p class="m-0 mt-2 fs-13 fw-medium text-ink">@_hapus?.ProjectCode — @_hapus?.ProjectName</p>
    }
</KonfirmasiDialog>

@code {
    public sealed class FilterKlien { public string Layanan { get; set; } = ""; public string Dokumen { get; set; } = ""; public string Status { get; set; } = ""; }

    public sealed record BarisKlien(Model.Klien K, int Trip, long Uj, int KontrakAktif, int KontrakTotal, int KontrakLain, long NilaiAktif);

    private const string StatusAktif = "aktif", NamaKunci = "nama";

    private static readonly List<Opsi> OpsiTipeFilter = [new("", "Semua"), .. TipeKlien.Semua.Select(t => new Opsi(t, TipeKlien.Label(t)))];
    private static readonly List<Opsi> OpsiDokumen = [new("", "Semua"), new("ya", "Pakai TR / No PI"), new("tidak", "Tanpa dokumen")];
    private static readonly List<Opsi> OpsiStatus = [new("aktif", "Aktif"), new("nonaktif", "Nonaktif")];
    private static readonly List<Opsi> OpsiStatusFilter = [new("", "Semua"), .. OpsiStatus];

    private readonly KendaliTabel<BarisKlien> _tabel = new(10, "project_code");
    private KendaliFilter<FilterKlien> _filter = default!;
    private Model.Klien? _editing;
    private bool _formOpen;
    private Model.Klien _f = new();
    private readonly Dictionary<string, string> _galat = [];
    private Model.Klien? _hapus;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _filter = new KendaliFilter<FilterKlien>(() => new FilterKlien(), StateHasChanged);
        _tabel.Search = (p, q) => Util.CocokCari(q, p.K.ProjectCode, p.K.ProjectName, p.K.Description);
        _tabel.SortAccessor = k => k switch
        {
            "project_name" => p => p.K.ProjectName, "client_type" => p => p.K.ClientType, "requires_document" => p => p.K.RequiresDocument,
            "kontrakAktif" => p => p.KontrakAktif, "trip" => p => p.Trip, "uj" => p => p.Uj, "status" => p => p.K.Status, _ => p => p.K.ProjectCode,
        };
        _tabel.ExtraFilter = p =>
        {
            var f = _filter.Nilai;
            return (f.Layanan == "" || p.K.ClientType == f.Layanan) && (f.Status == "" || p.K.Status == f.Status)
                && (f.Dokumen == "" || (f.Dokumen == "ya") == p.K.RequiresDocument);
        };
    }

    private List<BarisKlien> Baris
    {
        get
        {
            var trip = new Dictionary<string, (int N, long Uj)>();
            foreach (var t in Db.Baris)
            {
                // Trip batal hanya arsip, tidak dihitung.
                if (t.T.ProjectId == "" || t.Batal) continue;
                var a = trip.GetValueOrDefault(t.T.ProjectId);
                trip[t.T.ProjectId] = (a.N + 1, a.Uj + t.UjTotal);
            }
            return Db.Data.Klien.Select(p =>
            {
                var kontrak = Db.Data.Kontrak.Where(c => c.ProjectId == p.Id).ToList();
                var aktif = kontrak.Where(c => c.Status == "aktif").ToList();
                var tp = trip.GetValueOrDefault(p.Id);
                // Kontrak dicatat per workspace; yang di workspace lain disebut saja.
                return new BarisKlien(p, tp.N, tp.Uj, aktif.Count, kontrak.Count, Db.Semua.Kontrak.Count(c => c.ProjectId == p.Id) - kontrak.Count, aktif.Sum(c => c.Value));
            }).ToList();
        }
    }

    private List<ChipFilter> Chips
    {
        get
        {
            var f = _filter.Nilai;
            var l = new List<ChipFilter>();
            if (f.Layanan != "") l.Add(new($"Tipe: {TipeKlien.Label(f.Layanan)}", () => _filter.Lepas((n, a) => n.Layanan = a.Layanan)));
            if (f.Dokumen != "") l.Add(new(f.Dokumen == "ya" ? "Pakai TR / No PI" : "Tanpa dokumen", () => _filter.Lepas((n, a) => n.Dokumen = a.Dokumen)));
            if (f.Status != "") l.Add(new($"Status: {(f.Status == "aktif" ? "Aktif" : "Nonaktif")}", () => _filter.Lepas((n, a) => n.Status = a.Status)));
            return l;
        }
    }

    /// <summary>Jumlah trip (kedua workspace) untuk klien ini.</summary>
    private int DipakaiTrip(string id) => Db.Semua.Trip.Count(t => t.ProjectId == id);

    /// <summary>Kontrak di workspace mana pun yang masih milik klien yang akan dihapus.</summary>
    private int KontrakMilik => _hapus is null ? 0 : Db.Semua.Kontrak.Count(c => c.ProjectId == _hapus.Id);

    private List<Kolom<BarisKlien>> Kolom =>
    [
        new() { Key = "project_code", Header = "Kode", Sortable = true, Width = "100px", Render = p => @<span class="tnum fw-semibold text-ink">@p.K.ProjectCode</span> },
        new() { Key = "project_name", Header = "Nama Klien", Sortable = true, Render = SelNama },
        new() { Key = "client_type", Header = "Tipe Layanan", Sortable = true, Width = "124px", Render = SelTipe },
        new() { Key = "requires_document", Header = "Alur Dokumen", Sortable = true, Width = "140px", Render = SelDokumen },
        new() { Key = "kontrakAktif", Header = "Kontrak", Sortable = true, Width = "150px", Render = SelKontrak },
        new() { Key = "trip", Header = "Trip", Sortable = true, Align = "right", Width = "80px", Render = p => @<span class="tnum text-ink-2">@Format.Angka(p.Trip)</span> },
        new() { Key = "uj", Header = "Total Uang Jalan", Sortable = true, Align = "right", Width = "140px", Render = p => @<span class="tnum text-ink-2">@Format.Rupiah(p.Uj)</span> },
        new() { Key = "status", Header = "Status", Sortable = true, Width = "104px", Render = SelStatus },
        new() { Key = "action", Header = "Action", Align = "right", Width = "124px", NoPrint = true, Render = SelAksi },
    ];

    private static RenderFragment SelNama(BarisKlien p) => @<div class="lh-tight">
        <a href="@($"master/klien/{p.K.Id}")" class="fw-medium text-ink text-decoration-none">@p.K.ProjectName</a>
        @if (p.K.Description != "") { <span class="mt-1 d-block fs-12 text-ink-3">@p.K.Description</span> }
    </div>;

    private static RenderFragment SelTipe(BarisKlien p)
    {
        if (p.K.ClientType == TipeKlien.Dedicated) return @<Badge Tone="brand">Dedicated</Badge>;
        return @<Badge Tone="neutral">Callout</Badge>;
    }

    private static RenderFragment SelDokumen(BarisKlien p)
    {
        if (p.K.RequiresDocument) return @<Badge Tone="brand">Pakai No Referensi / No PI</Badge>;
        return @<Badge Tone="neutral">Tanpa dokumen</Badge>;
    }

    private static RenderFragment SelKontrak(BarisKlien p)
    {
        var href = $"master/klien/{p.K.Id}";
        if (p.KontrakTotal == 0)
        {
            if (p.K.ClientType != TipeKlien.Dedicated) return @<span class="text-ink-3">—</span>;
            return @<a href="@href" class="fs-12-5 text-ink-3 text-decoration-none">@(p.KontrakLain > 0 ? $"{p.KontrakLain} di workspace lain" : "Belum ada kontrak")</a>;
        }
        return @<a href="@href" class="d-block lh-tight text-decoration-none">
            <span class="fw-medium">@(p.KontrakAktif > 0 ? $"{p.KontrakAktif} aktif" : $"{p.KontrakTotal} selesai")</span>
            @if (p.KontrakAktif > 0) { <span class="tnum mt-1 d-block fs-11-5 text-ink-3">@Format.RupiahRingkas(p.NilaiAktif)</span> }
        </a>;
    }

    private static RenderFragment SelStatus(BarisKlien p)
    {
        if (p.K.Status == "aktif") return @<Badge Tone="good">Aktif</Badge>;
        return @<Badge Tone="neutral">Nonaktif</Badge>;
    }

    private RenderFragment SelAksi(BarisKlien p)
    {
        var bisa = Bisa("master");
        var dipakai = DipakaiTrip(p.K.Id);
        return @<span class="d-inline-flex justify-content-end gap-1">
            <TombolIkon Label="@($"Lihat detail {p.K.ProjectName} (kontrak & trip)")" Icon="Ikon.FileLines" OnClick="@(() => Ke($"master/klien/{p.K.Id}"))" />
            <TombolIkon Label="Ubah" Icon="Ikon.Pen" Disabled="@(!bisa)" OnClick="() => BukaUbah(p.K)" />
            <TombolIkon Label="Hapus" Tone="danger" Icon="Ikon.TrashCan" Disabled="@(!bisa || dipakai > 0)" Title="@(bisa && dipakai > 0 ? $"Dipakai {dipakai} trip" : null)" OnClick="() => _hapus = p.K" />
        </span>;
    }

    private string? G(string k) => _galat.GetValueOrDefault(k);
    private static RenderFragment? Teks(string? s) => s is null ? null : b => b.AddContent(0, s);

    // Kode klien dibuat dari singkatan nama, jadi saat form dibuka kodenya masih kosong.
    private void BukaTambah()
    {
        _editing = null;
        _f = new Model.Klien { ClientType = TipeKlien.Callout, RequiresDocument = true, Status = "aktif" };
        _galat.Clear();
        _formOpen = true;
    }

    private void BukaUbah(Model.Klien p)
    {
        _editing = p;
        _f = Database.Salin(p);
        _galat.Clear();
        _formOpen = true;
    }

    private void GantiTipe(string t) { _f.ClientType = t; _galat.Remove("tipe"); }

    private string KodeDariNama(string nama) => Kode.KodeKlienBerikut(nama, Db.Data.Klien.Where(p => p.Id != _editing?.Id).Select(p => p.ProjectCode));

    /// <summary>Generate: singkatan Nama Klien (PT Delta Energi Riau -> DER). Butuh nama terisi.</summary>
    private void GenerateKode()
    {
        if (_f.ProjectName.Trim() == "") { _galat["kode"] = "Isi Nama Klien dulu. Kode dibuat dari singkatan nama."; return; }
        _f.ProjectCode = KodeDariNama(_f.ProjectName);
        _galat.Remove("kode");
    }

    /// <summary>Selesai mengisi nama: kode yang masih kosong langsung diisi dari singkatannya.</summary>
    private void IsiKodeDariNama()
    {
        if (_f.ProjectCode.Trim() != "" || _f.ProjectName.Trim() == "") return;
        _f.ProjectCode = KodeDariNama(_f.ProjectName);
        _galat.Remove("kode");
    }

    private bool Validasi()
    {
        _galat.Clear();
        var kode = _f.ProjectCode.Trim();
        if (kode == "") _galat["kode"] = "Kode klien wajib diisi.";
        else if (Db.Data.Klien.Any(p => p.ProjectCode.Equals(kode, StringComparison.OrdinalIgnoreCase) && p.Id != _editing?.Id)) _galat["kode"] = "Kode klien sudah dipakai.";
        if (_f.ProjectName.Trim() == "") _galat["nama"] = "Nama klien wajib diisi.";
        // Klien yang masih punya kontrak tidak bisa dijadikan Callout.
        var kontrakAda = _editing is not null ? Db.Semua.Kontrak.Count(c => c.ProjectId == _editing.Id) : 0;
        if (_f.ClientType == TipeKlien.Callout && kontrakAda > 0)
            _galat["tipe"] = $"Klien ini masih punya {kontrakAda} kontrak. Hapus kontraknya dulu di halaman klien bila ingin menjadikannya Callout.";
        return _galat.Count == 0;
    }

    private void Simpan()
    {
        if (!Validasi()) return;
        var f = _f;
        void Isi(Model.Klien p)
        {
            p.ProjectCode = f.ProjectCode.Trim().ToUpperInvariant(); p.ProjectName = f.ProjectName.Trim(); p.ClientType = f.ClientType;
            p.Description = f.Description; p.RequiresDocument = f.RequiresDocument; p.Status = f.Status;
        }
        if (_editing is not null)
        {
            Db.Ubah<Model.Klien>(_editing.Id, Isi);
            Toast.Sukses("Data berhasil diperbarui.");
        }
        else
        {
            var baru = new Model.Klien();
            Isi(baru);
            Db.Buat(baru);
            Toast.Sukses("Data berhasil disimpan.");
        }
        _formOpen = false;
    }

    private void KonfirmasiHapus()
    {
        if (_hapus is null) return;
        if (KontrakMilik > 0) { _hapus = null; return; }
        Db.Hapus<Model.Klien>(_hapus.Id);
        Toast.Sukses("Data berhasil dihapus.");
        _hapus = null;
    }

    private void ResetFilter() { _tabel.Reset(); _filter.LepasSemua(); }
}
