@page "/master/klien/{Id}"
@* Master -> Klien -> satu klien. Klien Dedicated: kontraknya dan sisanya (nilai kontrak dikurangi uang jalan & biaya trip kontrak itu).
   Klien Callout: ringkasan trip dan pendapatannya. *@
@inherits KomponenData
<PageTitle>@(KlienIni?.ProjectName ?? "Klien") — BJM Logistik</PageTitle>

@if (KlienIni is not { } klien)
{
    <PageHeader Title="Klien tidak ditemukan" Crumbs="@(new List<Crumb> { new("Master Data"), new("Klien / Pelanggan", "master/klien") })" />
    <Kartu>
        <div class="px-4 py-5 text-center">
            <p class="m-0 fs-14 fw-semibold text-ink">Data tidak ditemukan.</p>
            <p class="m-0 mt-1 fs-13 text-ink-3">Klien mungkin sudah dihapus.</p>
            <Tombol Class="mt-3" OnClick="@(() => Ke("master/klien"))">Kembali ke daftar</Tombol>
        </div>
    </Kartu>
}
else
{
    var kontrak = DaftarKontrak;
    var tripKlien = TripKlien;
    var dedicated = klien.ClientType == TipeKlien.Dedicated;
    <PageHeader Title="@klien.ProjectName" Kembali="master/klien" Crumbs="@(new List<Crumb> { new("Master Data"), new("Klien / Pelanggan", "master/klien"), new(klien.ProjectCode) })">
        <Description>@Keterangan(klien)</Description>
        <Actions>
            @if (dedicated)
            {
                <Tombol Variant="primary" Icon="Ikon.Plus" Disabled="@(!Bisa("master"))" OnClick="BukaTambah">Tambah Kontrak</Tombol>
            }
        </Actions>
    </PageHeader>

    <div class="row g-3 mb-4">
        @foreach (var (label, nilai, ket) in Ringkasan(dedicated, kontrak, tripKlien))
        {
            <div class="col-sm-6 col-xl-3">
                <div class="kartu shadow-card p-3 h-100">
                    <p class="m-0 fs-12-5 fw-medium text-ink-3">@label</p>
                    <p class="m-0 mt-2 tnum lh-1 fw-semibold text-ink" style="font-size:19px;letter-spacing:-.01em">@nilai</p>
                    <p class="m-0 mt-2 fs-11-5 text-ink-3">@ket</p>
                </div>
            </div>
        }
    </div>

    <Kartu Class="mb-4">
        <KepalaKartu Title="Data Klien" />
        <div class="p-3">
            <dl class="row row-cols-1 row-cols-md-3 g-3 mb-0">
                <InfoItem Label="Kode Klien" Value="@klien.ProjectCode" Mono />
                <InfoItem Label="Tipe Layanan" Value="@TipeKlien.Label(klien.ClientType)" />
                <InfoItem Label="NPWP" Value="@(klien.Npwp != "" ? klien.Npwp : "—")" Mono />
            </dl>
        </div>
    </Kartu>

    @if (dedicated)
    {
        <Kartu Class="mb-4">
            <KepalaKartu Title="Kontrak Dedicated" Subtitle="@($"Kontrak klien ini di workspace {WorkspaceKode.Label(Sesi.Workspace)}. Trip Dedicated memilih salah satunya.")" />
            <DataTable T="BarisKontrak" Columns="KolomKontrak" Rows="kontrak" RowKey="c => c.C.Id">
                <Empty>
                    <div class="px-4 py-5 text-center">
                        <p class="m-0 fw-semibold text-ink" style="font-size:13.5px">Belum ada kontrak.</p>
                        <p class="m-0 mt-1 fs-12-5 text-ink-3">Tambahkan lewat Tambah Kontrak di kanan atas bila klien ini memakai layanan Dedicated.</p>
                    </div>
                </Empty>
            </DataTable>
        </Kartu>
    }
    else
    {
        <Kartu Class="mb-4 px-3 py-3">
            <p class="m-0 fs-13 fw-semibold text-ink">Klien Callout, tanpa kontrak</p>
            <p class="m-0 mt-1 fs-12-5 text-ink-3" style="line-height:1.6">
                Trip klien ini order per perjalanan. Bila perusahaan ini memakai jasa lewat kontrak,
                ubah tipe layanannya menjadi Dedicated di <a href="master/klien">daftar Klien</a>.
            </p>
        </Kartu>
    }

    <Kartu>
        <KepalaKartu Title="Trip terakhir" Subtitle="@($"{tripKlien.Count} trip tercatat untuk klien ini")" />
        @if (tripKlien.Count == 0)
        {
            <p class="m-0 px-3 py-5 text-center fs-13 text-ink-3">Belum ada trip untuk klien ini.</p>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var t in tripKlien.Take(8))
                {
                    var tt = t;
                    <li class="list-group-item p-0">
                        <a href="@($"transaksi/trip/{tt.Id}")" class="d-flex align-items-center justify-content-between gap-3 px-3 py-2 text-decoration-none">
                            <span class="min-w-0">
                                <span class="tnum d-block fs-13 fw-semibold text-brand">@tt.T.TransactionNo</span>
                                <span class="d-block text-truncate fs-12 text-ink-3">
                                    @Format.Tanggal(tt.T.TransactionDate) · @RuteTrip(tt) · @TipeKlien.Label(tt.T.ServiceType)@(tt.ContractNo != "" ? $" {tt.ContractNo}" : "")
                                </span>
                            </span>
                            <span class="d-flex flex-shrink-0 align-items-center gap-3">
                                <span class="tnum fs-13 text-ink-2">@Format.Rupiah(tt.UjTotal)</span>
                                <Badge Tone="@StatusTrip.Nada(tt.Status)">@StatusTrip.Label(tt.Status)</Badge>
                            </span>
                        </a>
                    </li>
                }
            </ul>
        }
    </Kartu>

    <Modal Open="_formOpen" Title="@(_editing is not null ? "Ubah Kontrak" : "Tambah Kontrak")" Subtitle="@klien.ProjectName" OnClose="() => _formOpen = false">
        <ChildContent>
            @if (_formOpen)
            {
                <div class="row g-3">
                    <Field Label="No. Kontrak" Required Error="@G("no")" Class="col-sm-6" Info="Nomor urut otomatis per tahun; ikon di sampingnya membuat nomor berikutnya, boleh diganti.">
                        <KodeInput Id="@context" Value="@_f.ContractNo" Invalid="@(G("no") is not null)" Uppercase GenerateTitle="Buat nomor kontrak berikutnya"
                                   ValueChanged="@(v => { _f.ContractNo = v; _galat.Remove("no"); })" OnGenerate="GenerateNomor" />
                    </Field>
                    <Field Label="Status" Class="col-sm-6">
                        <Pilihan Id="@context" Options="OpsiStatus" Value="@_f.Status" ValueChanged="v => _f.Status = v ?? StatusAktif" Cari="false" Clearable="false" />
                    </Field>
                    <Field Label="Nilai Kontrak" Required Error="@G("nilai")" Class="col-12">
                        <UangInput Id="@context" Value="_f.Value" Invalid="@(G("nilai") is not null)" ValueChanged="@(v => { _f.Value = v; _galat.Remove("nilai"); })" />
                    </Field>
                    <Field Label="Mulai" Class="col-sm-6">
                        <TanggalInput Id="@context" Value="@_f.StartDate" ValueChanged="v => _f.StartDate = v" />
                    </Field>
                    <Field Label="Selesai" Error="@G("selesai")" Class="col-sm-6">
                        <TanggalInput Id="@context" Value="@_f.EndDate" Invalid="@(G("selesai") is not null)" ValueChanged="@(v => { _f.EndDate = v; _galat.Remove("selesai"); })" />
                    </Field>
                    <Field Label="Catatan" Class="col-12">
                        <textarea id="@context" class="form-control" rows="2" value="@_f.Notes" @oninput="e => _f.Notes = e.Value?.ToString() ?? string.Empty"></textarea>
                    </Field>
                    <Field Label="Dokumen Kontrak" Class="col-12">
                        <LampiranInput Id="@context" Label="Tambah dokumen" Value="_f.Attachments" ValueChanged="v => _f.Attachments = v" />
                    </Field>
                </div>
            }
        </ChildContent>
        <Footer>
            <Tombol OnClick="() => _formOpen = false">Batal</Tombol>
            <Tombol Variant="primary" OnClick="Simpan">@(_editing is not null ? "Simpan Perubahan" : "Simpan")</Tombol>
        </Footer>
    </Modal>

    <KonfirmasiDialog Open="_hapus is not null" Title="@(JumlahDipakai > 0 ? "Kontrak masih dipakai" : "Hapus kontrak?")" ConfirmLabel="@(JumlahDipakai > 0 ? "Mengerti" : "Hapus")"
                      Tone="@(JumlahDipakai > 0 ? "primary" : "danger")"
                      Message="@(JumlahDipakai > 0 ? $"{_hapus?.ContractNo} masih dipakai {JumlahDipakai} trip. Ubah statusnya menjadi Selesai bila kontrak sudah berakhir." : $"{_hapus?.ContractNo} milik {klien.ProjectName} akan dihapus.")"
                      OnCancel="() => _hapus = null" OnConfirm="KonfirmasiHapus" />
}

@code {
    [Parameter] public string Id { get; set; } = "";

    public sealed record BarisKontrak(Kontrak C, int Trip, long Terpakai, long Sisa, long Komisi);

    private const string StatusAktif = "aktif";
    private static readonly List<Opsi> OpsiStatus = [new("aktif", "Aktif"), new("selesai", "Selesai")];

    private Kontrak? _editing;
    private bool _formOpen;
    private Kontrak _f = new();
    private readonly Dictionary<string, string> _galat = [];
    private Kontrak? _hapus;

    private Model.Klien? KlienIni => Db.Data.Klien.FirstOrDefault(p => p.Id == Id);

    private List<BarisKontrak> DaftarKontrak => Db.Data.Kontrak
        .Where(c => c.ProjectId == Id)
        .Select(c =>
        {
            // Trip batal tidak dihitung: catatannya arsip.
            var trip = Db.Baris.Where(t => t.T.ContractId == c.Id && !t.Batal).ToList();
            var terpakai = trip.Sum(t => t.UjTotal + t.ExpenseTotal + t.InternalTotal);
            return new BarisKontrak(c, trip.Count, terpakai, c.Value - terpakai, Komisi.HitungKontrak(Db.Data.AturanKomisi, c.Value)?.Nilai ?? 0);
        })
        .OrderByDescending(b => b.C.StartDate, StringComparer.Ordinal).ThenByDescending(b => b.C.ContractNo, StringComparer.Ordinal)
        .ToList();

    private List<BarisTrip> TripKlien => Db.Baris.Where(t => t.T.ProjectId == Id).OrderByDescending(t => t.T.TransactionDate, StringComparer.Ordinal).ToList();

    private static string Keterangan(Model.Klien k) => string.Join(" · ", new[]
    {
        k.ProjectCode, TipeKlien.Label(k.ClientType), k.RequiresDocument ? "Pakai No Referensi / No PI" : "Tanpa dokumen", k.Status == "aktif" ? "Aktif" : "Nonaktif", k.Description,
    }.Where(x => !string.IsNullOrEmpty(x)));

    private static string RuteTrip(BarisTrip t) => t.RouteName != "" ? t.RouteName : t.T.DestinationDetail != "" ? t.T.DestinationDetail : "—";

    private IEnumerable<(string, string, string)> Ringkasan(bool dedicated, List<BarisKontrak> kontrak, List<BarisTrip> tripKlien)
    {
        var ws = WorkspaceKode.Label(Sesi.Workspace);
        var dihitung = tripKlien.Where(t => !t.Batal).ToList();
        if (dedicated)
        {
            var aktif = kontrak.Where(c => c.C.Status == "aktif").ToList();
            yield return ("Kontrak Aktif", aktif.Count.ToString(), $"dari {kontrak.Count} kontrak di {ws}");
            yield return ("Nilai Kontrak Aktif", Format.Rupiah(aktif.Sum(c => c.C.Value)), "total nilai kontrak berjalan");
            yield return ("Sisa Kontrak Aktif", Format.Rupiah(aktif.Sum(c => c.Sisa)), "nilai dikurangi biaya trip kontrak");
            yield return ("Jumlah Trip", dihitung.Count.ToString(), $"total uang jalan {Format.Rupiah(dihitung.Sum(t => t.UjTotal))}");
        }
        else
        {
            yield return ("Jumlah Trip", dihitung.Count.ToString(), $"di {ws}, tanpa trip batal");
            yield return ("Pendapatan", Format.Rupiah(dihitung.Sum(t => t.Harga)), "jumlah Harga Jual trip");
            yield return ("Total Uang Jalan", Format.Rupiah(dihitung.Sum(t => t.UjTotal)), "termin yang sudah dibayar");
            var pertama = dihitung.FirstOrDefault();
            yield return ("Trip Terakhir", pertama is not null ? Format.Tanggal(pertama.T.TransactionDate) : "—", pertama?.T.TransactionNo ?? "belum ada trip");
        }
    }

    private List<Kolom<BarisKontrak>> KolomKontrak =>
    [
        new() { Key = "contract_no", Header = "No. Kontrak", Width = "170px", Render = SelNomor },
        new() { Key = "start_date", Header = "Periode", Width = "190px", Render = c => @<span class="tnum text-ink-2">@(c.C.StartDate != "" ? Format.Tanggal(c.C.StartDate) : "—") – @(c.C.EndDate != "" ? Format.Tanggal(c.C.EndDate) : "—")</span> },
        new() { Key = "value", Header = "Nilai Kontrak", Align = "right", Width = "140px", Render = c => @<span class="tnum fw-medium">@Format.Rupiah(c.C.Value)</span> },
        new() { Key = "terpakai", Header = "Terpakai", Align = "right", Width = "140px", Render = SelTerpakai },
        new() { Key = "sisa", Header = "Sisa", Align = "right", Width = "140px", Render = c => @<span class="tnum fw-semibold @(c.Sisa < 0 ? "" : "text-ink")" style="@(c.Sisa < 0 ? "color:var(--critical)" : null)">@Format.Rupiah(c.Sisa)</span> },
        new() { Key = "komisi", Header = "Komisi (perkiraan)", Align = "right", Width = "150px", Render = SelKomisi },
        new() { Key = "attachments", Header = "Dokumen", Width = "96px", Render = c => @<LampiranThumbs Ids="c.C.Attachments" Ukuran="28" /> },
        new() { Key = "status", Header = "Status", Width = "100px", Render = SelStatus },
        new() { Key = "action", Header = "Action", Align = "right", Width = "92px", NoPrint = true, Render = SelAksi },
    ];

    private static RenderFragment SelNomor(BarisKontrak c) => @<div class="lh-tight">
        <span class="tnum fw-semibold text-ink">@c.C.ContractNo</span>
        @if (c.C.Notes != "") { <span class="mt-1 d-block text-truncate fs-12 text-ink-3" title="@c.C.Notes">@c.C.Notes</span> }
    </div>;

    private static RenderFragment SelTerpakai(BarisKontrak c) => @<div class="lh-tight">
        <span class="tnum text-ink-2">@Format.Rupiah(c.Terpakai)</span>
        <span class="mt-1 d-block fs-11-5 text-ink-3">@c.Trip trip</span>
    </div>;

    private static RenderFragment SelKomisi(BarisKontrak c)
    {
        if (c.Komisi == 0) return @<span class="text-ink-3">—</span>;
        return @<span class="tnum text-ink-2">@Format.Rupiah(c.Komisi)</span>;
    }

    private static RenderFragment SelStatus(BarisKontrak c)
    {
        if (c.C.Status == "aktif") return @<Badge Tone="good">Aktif</Badge>;
        return @<Badge Tone="neutral">Selesai</Badge>;
    }

    private RenderFragment SelAksi(BarisKontrak c)
    {
        var bisa = Bisa("master");
        return @<span class="d-inline-flex justify-content-end gap-1">
            <TombolIkon Label="Ubah" Icon="Ikon.Pen" Disabled="@(!bisa)" OnClick="() => BukaUbah(c.C)" />
            <TombolIkon Label="Hapus" Tone="danger" Icon="Ikon.TrashCan" Disabled="@(!bisa)" OnClick="() => _hapus = c.C" />
        </span>;
    }

    private string? G(string k) => _galat.GetValueOrDefault(k);
    private static RenderFragment? Teks(string? s) => s is null ? null : b => b.AddContent(0, s);

    /// <summary>Trip mana pun (termasuk batal) yang masih menunjuk kontrak yang akan dihapus.</summary>
    private int JumlahDipakai => _hapus is null ? 0 : Db.Semua.Trip.Count(t => t.ContractId == _hapus.Id);

    private void BukaTambah()
    {
        _editing = null;
        var hariIni = Format.HariIni();
        _f = new Kontrak { ContractNo = Kode.NomorKontrakBerikut(Db.Semua.Kontrak.Select(c => c.ContractNo), hariIni[..4]), StartDate = hariIni, Status = "aktif" };
        _galat.Clear();
        _formOpen = true;
    }

    private void BukaUbah(Kontrak c)
    {
        _editing = c;
        _f = Database.Salin(c);
        _galat.Clear();
        _formOpen = true;
    }

    private void GenerateNomor()
    {
        var tahun = (_f.StartDate != "" ? _f.StartDate : Format.HariIni())[..4];
        _f.ContractNo = Kode.NomorKontrakBerikut(Db.Semua.Kontrak.Where(c => c.Id != _editing?.Id).Select(c => c.ContractNo), tahun);
        _galat.Remove("no");
    }

    private bool Validasi()
    {
        _galat.Clear();
        var no = _f.ContractNo.Trim();
        if (no == "") _galat["no"] = "Nomor kontrak wajib diisi.";
        else if (Db.Semua.Kontrak.Any(c => c.ContractNo.Equals(no, StringComparison.OrdinalIgnoreCase) && c.Id != _editing?.Id)) _galat["no"] = "Nomor kontrak sudah dipakai.";
        if (_f.Value <= 0) _galat["nilai"] = "Nilai kontrak harus lebih dari 0.";
        if (_f.StartDate != "" && _f.EndDate != "" && string.CompareOrdinal(_f.EndDate, _f.StartDate) < 0) _galat["selesai"] = "Tanggal selesai sebelum tanggal mulai.";
        return _galat.Count == 0;
    }

    private void Simpan()
    {
        if (!Validasi()) return;
        var f = _f;
        var klienId = Id;
        void Isi(Kontrak c)
        {
            c.ProjectId = klienId; c.ContractNo = f.ContractNo.Trim().ToUpperInvariant(); c.Value = f.Value; c.StartDate = f.StartDate; c.EndDate = f.EndDate;
            c.Status = f.Status; c.Notes = f.Notes.Trim(); c.Attachments = f.Attachments;
        }
        if (_editing is not null)
        {
            Db.Ubah<Kontrak>(_editing.Id, Isi);
            Toast.Sukses("Kontrak berhasil diperbarui.");
        }
        else
        {
            var baru = new Kontrak();
            Isi(baru);
            Db.Buat(baru);
            Toast.Sukses("Kontrak berhasil disimpan.");
        }
        _formOpen = false;
    }

    private void KonfirmasiHapus()
    {
        if (_hapus is null) return;
        if (JumlahDipakai > 0) { _hapus = null; return; }
        Db.Hapus<Kontrak>(_hapus.Id);
        Toast.Sukses("Kontrak berhasil dihapus.");
        _hapus = null;
    }
}
