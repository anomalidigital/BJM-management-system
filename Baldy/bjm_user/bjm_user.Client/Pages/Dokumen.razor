    private static string KetBerkas(BarisBerkas r)
    {
        var s = string.Join(" · ", new[] { r.Keadaan == "ada" ? JenisBerkas(r.Tipe, r.Nama) : "", r.S.Judul }.Where(x => x != ""));
        return s != "" ? s : "—";
    }

    private void BukaTautan(BarisBerkas r) { if (r.S.Tautan is not null) Ke(r.S.Tautan); }

    private async Task Unduh(BarisBerkas r)
    {
        var info = await LampiranSvc.InfoAsync(r.S.LampiranId);
        if (info is null) { Toast.Galat("Berkas tidak ditemukan di penyimpanan browser ini."); return; }
        try
        {
            if (!_helperTerpasang) { await JS.InvokeAsync<bool>("eval", PembantuJs); _helperTerpasang = true; }
            await JS.InvokeVoidAsync("sikotisDokumen.unduh", info.Url, info.Name);
        }
        catch { Toast.Galat("Berkas tidak ditemukan di penyimpanan browser ini."); }
    }

    private async Task HapusBerkas()
    {
        var r = _menghapus;
        if (r is null) return;
        var dok = Db.Semua.Dokumen.FirstOrDefault(x => x.Id == r.RecordId);
        if (dok is not null)
        {
            var sisa = dok.Attachments.Where(a => a != r.S.LampiranId).ToList();
            if (sisa.Count > 0)
            {
                Db.Ubah<Model.Dokumen>(dok.Id, x => x.Attachments = sisa);
                Toast.Sukses($"Berkas {r.Nama} dihapus dari dokumen “{dok.Judul}”. {sisa.Count} berkas lain tetap tersimpan.");
            }
            else
            {
                Db.Hapus<Model.Dokumen>(dok.Id);
                Toast.Sukses($"Dokumen “{dok.Judul}” dihapus.");
            }
            _menghapus = null;
            await LampiranSvc.HapusAsync([r.S.LampiranId]);
        }
        _menghapus = null;
    }

