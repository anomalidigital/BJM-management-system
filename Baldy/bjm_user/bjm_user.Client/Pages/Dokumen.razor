    /// <summary>
    /// Unggah dokumen. "Dokumen umum" = tidak menempel pada satu trip (SOP, surat, dokumen perusahaan) dan disimpan di Dokumen.
    /// "Dokumen trip" = disimpan ke tab Dokumen trip itu, sama seperti menambah dokumen dari detail trip. Saat mengubah dokumen
    /// umum, jenisnya tetap.
    /// </summary>
    private void BukaUnggah(Model.Dokumen? edit)
    {
        _edit = edit;
        _isi = edit is not null
            ? new IsiUnggah { Simpan = TujuanUmum, Judul = edit.Judul, Kategori = edit.Kategori != "" ? edit.Kategori : "Umum", Tanggal = edit.Tanggal, Catatan = edit.Catatan, Attachments = [.. edit.Attachments] }
            : new IsiUnggah();
        _tanggalSendiri = edit is not null;
        _galat.Clear();
        _unggah = true;
    }

    private void PilihTrip(string? id)
    {
        _isi.TripId = id ?? "";
        if (id is not null && !_tanggalSendiri)
        {
            var tgl = Db.BarisTrip(id)?.T.TransactionDate ?? "";
            if (tgl != "") _isi.Tanggal = tgl;
        }
        _galat.Remove("trip_id");
    }

    private void UbahTanggal(string v) { _tanggalSendiri = true; _isi.Tanggal = v; }

    private void UbahBerkas(List<string> v) { _isi.Attachments = v; if (v.Count > 0) _galat.Remove("attachments"); }

    private async Task SimpanUnggah()
    {
        _galat.Clear();
        var keTrip = _isi.Simpan == TujuanTrip;
        if (keTrip && _isi.TripId == "") _galat["trip_id"] = "Pilih trip yang memiliki dokumen ini.";
        if (_isi.Judul.Trim() == "") _galat["judul"] = "Judul dokumen wajib diisi.";
        if (_isi.Tanggal == "") _galat["tanggal"] = "Tanggal wajib diisi.";
        if (_isi.Attachments.Count == 0) _galat["attachments"] = "Pilih minimal satu berkas.";
        if (_galat.Count > 0) return;
        var judul = _isi.Judul.Trim(); var catatan = _isi.Catatan.Trim();
        if (keTrip)
        {
            var t = Db.BarisTrip(_isi.TripId);
            Db.Buat(new CatatanTrip { TripId = _isi.TripId, NoteDate = _isi.Tanggal, Title = judul, Notes = catatan, Attachments = [.. _isi.Attachments] });
            Toast.Sukses($"Dokumen “{judul}” tersimpan di trip {t?.IdTampil ?? ""}. Bisa dibuka juga di tab Dokumen trip itu.");
        }
        else if (_edit is not null)
        {
            var lama = _edit;
            var dilepas = lama.Attachments.Where(a => !_isi.Attachments.Contains(a)).ToList();
            var isi = _isi;
            Db.Ubah<Model.Dokumen>(lama.Id, d => { d.Judul = judul; d.Kategori = isi.Kategori; d.Tanggal = isi.Tanggal; d.Catatan = catatan; d.Attachments = [.. isi.Attachments]; });
            if (dilepas.Count > 0) await LampiranSvc.HapusAsync(dilepas);
            Toast.Sukses($"Dokumen “{judul}” diperbarui.");
        }
        else
        {
            Db.Buat(new Model.Dokumen { Judul = judul, Kategori = _isi.Kategori, Tanggal = _isi.Tanggal, Catatan = catatan, Attachments = [.. _isi.Attachments] });
            Toast.Sukses($"Dokumen umum “{judul}” tersimpan ({_isi.Attachments.Count} berkas).");
        }
        _unggah = false;
    }
