    /// <summary>
    /// Alamat pick up / destinasi dari area rute: yang terakhir dipakai trip rute ini, lalu yang paling sering dipakai, lalu urut nama.
    /// Kosong bila area itu belum punya alamat di Master Alamat.
    /// </summary>
    private string AlamatUntukArea(string kode, bool pengirim, string routeId)
    {
        var diArea = Db.Data.Alamat.Where(a => a.Status == "aktif" && AturanTrip.SamaArea(a.KodeArea, kode)).ToList();
        var sisi = pengirim ? JenisAlamat.Pengirim : JenisAlamat.Penerima;
        var cocok = diArea.Where(a => a.Jenis == JenisAlamat.Keduanya || a.Jenis == sisi).ToList();
        var calon = cocok.Count > 0 ? cocok : diArea;
        if (calon.Count <= 1) return calon.FirstOrDefault()?.Id ?? "";
        var ids = calon.Select(a => a.Id).ToHashSet();
        string? Titik(BarisTrip t) => (pengirim ? t.T.Pengirim : t.T.Penerima)?.AlamatId;
        var terakhir = Db.Baris.Where(t => t.T.RouteId == routeId && !t.Batal && ids.Contains(Titik(t) ?? ""))
            .OrderByDescending(t => t.T.TransactionDate, StringComparer.Ordinal).ThenByDescending(t => t.T.TransactionNo, StringComparer.Ordinal).FirstOrDefault();
        if (terakhir is not null && Titik(terakhir) is { Length: > 0 } idTerakhir) return idTerakhir;
        var pakai = new Dictionary<string, int>();
        foreach (var t in Db.Baris) if (Titik(t) is { Length: > 0 } id && ids.Contains(id)) pakai[id] = pakai.GetValueOrDefault(id) + 1;
        return calon.OrderByDescending(a => pakai.GetValueOrDefault(a.Id)).ThenBy(a => a.Nama, StringComparer.OrdinalIgnoreCase).First().Id;
    }

