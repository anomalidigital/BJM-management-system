    private Dictionary<string, List<string>> RefLain
    {
        get
        {
            var m = new Dictionary<string, List<string>>();
            foreach (var t in Db.Baris)
            {
                if (t.Id == Existing?.Id || t.Batal) continue;
                foreach (var no in t.TrList)
