@* Form Tambah / Ubah Trip Karawang (mock atasan 13 Okt 2026): Konfigurasi · Informasi Kendaraan dan Supir · Informasi Pengiriman
   (Rute, Pick Up & Destination Details + catatan, Kosongan). Kode Trip dibuat saat form dibuka dan menjadi judul.
   Tipe layanan ikut klien. Harga selalu ikut rute (diubah di Master Rute). Kendaraan & supir tidak saling mengisi.
   Backload dibuka dari menu ⋯ daftar trip (?backload=<id trip asal>).
   Revisi Baldy 22 Okt 2026: form ringkas (penjelasan lewat ikon "?"), Add Items Details dihapus, isian Pick Up / Destination Details
   dihilangkan dulu (tinggal Catatan Pick Up & Catatan Destinasi; titik lama trip tetap tersimpan). Kunci sebagian ("trip sudah jalan")
   dilepas: trip yang belum selesai bebas diubah; trip Selesai terkunci penuh sampai diaktifkan lagi. *@
@inherits KomponenData
@inject Penyimpanan Simpan

@if (TripId is not null && Existing is null)
{
    <PageHeader Title="Trip tidak ditemukan" Crumbs="@(new List<Crumb> { new("Trip / Job Order", "transaksi/trip") })" />
    <Kartu><div class="px-4 py-5 text-center">
        <p class="m-0 fs-14 fw-semibold text-ink">Data tidak ditemukan.</p>
        <p class="m-0 mt-1 fs-13 text-ink-3">Trip mungkin sudah dihapus, atau milik workspace lain.</p>
        <Tombol Class="mt-3" OnClick="@(() => Ke("transaksi/trip"))">Kembali ke daftar</Tombol>
    </div></Kartu>
}
else if (Existing is not null && StatusTrip.Terkunci(Existing.Status) && Db.BarisTrip(Existing.Id) is { } terkunci)
{
    <PageHeader Title="@($"Trip {Existing.TransactionNo}")" Kembali="@($"transaksi/trip/{Existing.Id}")" Crumbs="Remah" />
    <KunciTrip Trip="terkunci" OnAktif="MuatUlang" />
}
else if (Existing?.Status == StatusTrip.Batal)
{
    <PageHeader Title="@($"Trip {Existing.TransactionNo}")" Crumbs="@(new List<Crumb> { new("Trip / Job Order", "transaksi/trip"), new(Existing.TransactionNo) })" />
    <Kartu><div class="px-4 py-5 text-center">
        <p class="m-0 fs-14 fw-semibold text-ink">Trip ini sudah dibatalkan.</p>
        <p class="m-0 mt-1 fs-13 text-ink-3">Trip yang dibatalkan disimpan sebagai arsip dan tidak bisa diubah.</p>
        <Tombol Class="mt-3" OnClick="@(() => Ke($"transaksi/trip/{Existing.Id}"))">Lihat trip</Tombol>
    </div></Kartu>
}
else
{
    var rute = Rute;
    var area = rute is not null ? TripLogika.KodeArea(rute) : ("", "");
    var klien = KlienDipilih;
    var kendaraan = Db.Cari<Kendaraan>(_f.VehicleId);
    var kendaraanDiTripLain = _f.VehicleId != "" ? Ditahan.Kendaraan.GetValueOrDefault(_f.VehicleId) : null;
    var refDipakai = _f.Tr.Select(no => (No: no, Trip: RefLain.GetValueOrDefault(TripLogika.KunciTr(no)) ?? [])).Where(x => x.Trip.Count > 0).ToList();
    var anakBackload = Asal is null ? [] : Db.Baris.Where(t => t.T.BackloadDari == Asal.Id && !t.Batal).Select(t => t.IdTampil).ToList();
    <div class="halaman-form form-ringkas">
        <PageHeader Title="@_kodeAwal" Kembali="@KembaliKe" Crumbs="Remah">
            <Description>Tiap kendaraan tersimpan sebagai trip sendiri dengan Berita Acara Serah Terima masing-masing.</Description>
        </PageHeader>

        @if (!Bisa("trip"))
        {
            <Peringatan Class="mb-3">Peran @(Sesi.Pengguna?.Role == Peran.Viewer ? "Viewer" : "ini") tidak dapat menyimpan perubahan. Form ini hanya untuk melihat struktur data.</Peringatan>
        }
        @if (TripId is null && BackloadDari is not null && Asal is null)
        {
            <Peringatan Class="mb-3">@(CalonAsal is not null ? $"Trip asal {CalonAsal.IdTampil} sudah dibatalkan, jadi tidak bisa dilanjutkan." : "Trip asal backload tidak ditemukan (mungkin sudah dihapus).") Form ini dibuka sebagai trip baru biasa.</Peringatan>
        }
        @if (Asal is not null)
        {
            <div class="kotak-backload mb-3">
                <p class="m-0 fw-semibold">Backload / Lanjutan dari Trip <a href="@($"transaksi/trip/{Asal.Id}")" class="text-decoration-underline" style="color:inherit">@Asal.IdTampil</a></p>
                <p class="m-0 mt-1">Kendaraan @(Asal.PlateNumber != "" ? Asal.PlateNumber : "(belum ada)")@(Asal.DriverNames != "" ? $" dan supir {Asal.DriverNames}" : "") mengikuti trip asal. Pick up dari destinasi trip asal@if (Asal.Bongkar != "") { <span>: <span class="fw-semibold">@Asal.Bongkar</span></span> }.</p>
                @if (Asal.Status != StatusTrip.Selesai) { <p class="m-0 mt-1" style="color:var(--brand-700)">Trip asal masih @StatusTrip.Label(Asal.Status). Tutup trip asal setelah POD-nya difoto atau diterima.</p> }
                @if (anakBackload.Count > 0) { <p class="m-0 mt-1" style="color:var(--brand-700)">Trip asal sudah punya backload: @string.Join(", ", anakBackload). Yang ini tersimpan sebagai backload berikutnya.</p> }
            </div>
        }

        <div class="d-flex flex-column gap-3">
            <Bagian Judul="Konfigurasi">
                <div class="row g-3">
                    <Field Label="Klien" Required="@Wajib(Existing?.ProjectId)" Error="@_galat.GetValueOrDefault("klien")" Info="@InfoKlien" Class="col-md-5">
                        <Pilihan Id="@context" Options="OpsiKlien" Value="@Kosong(_f.Klien)" Invalid="@_galat.ContainsKey("klien")" Cari="true"
                                 Placeholder="Pilih klien..." SearchPlaceholder="Ketik nama atau kode klien..." ValueChanged="PilihKlien" />
                    </Field>
                    <Field Label="No Referensi" Class="col-md-4" Info="Nomor referensi penugasan dari klien, mis. nomor TR. Boleh lebih dari satu."
                           Hint="@(refDipakai.Count > 0 ? T($"{string.Join("; ", refDipakai.Select(x => $"{x.No} juga dipakai trip {string.Join(", ", x.Trip)}"))}. Wajar bila satu order dikirim beberapa mobil.") : null)">
                        <NoReferensiInput Id="@context" Value="_f.Tr" ValueChanged="v => _f.Tr = v" />
                    </Field>
                    <Field Label="Tanggal Berangkat" Required Error="@_galat.GetValueOrDefault("tanggal")" Info="Hari trip jalan." Class="col-md-3">
                        <TanggalInput Id="@context" Value="@_f.TransactionDate" Invalid="@_galat.ContainsKey("tanggal")" ValueChanged="UbahTanggal" />
                    </Field>
                </div>
                @if (Dedicated)
                {
                    var kontrak = Db.Cari<Kontrak>(_f.ContractId);
                    <div class="mt-3 row g-3">
                        <div class="col-md-6">
                            <Field Label="No. Kontrak" Required Error="@_galat.GetValueOrDefault("kontrak")"
                                   Info="@(KontrakKlien.Count == 1 ? "Satu-satunya kontrak aktif klien ini." : "Kontrak aktif klien ini.")">
                                <Pilihan Id="@context" Options="OpsiKontrak" Value="@Kosong(_f.ContractId)" Invalid="@_galat.ContainsKey("kontrak")" Cari="false"
                                         Placeholder="Pilih nomor kontrak..." EmptyText="Belum ada kontrak aktif." ValueChanged="PilihKontrak" />
                            </Field>
                        </div>
                        @if (kontrak is not null)
                        {
                            <div class="col-md-6">
                                <KotakInfo>
                                    <dl class="m-0 row g-2">
                                        <div class="col-6"><NilaiInfo Label="Nilai kontrak">@Format.Rupiah(kontrak.Value)</NilaiInfo></div>
                                        <div class="col-6"><NilaiInfo Label="Berlaku">@(kontrak.StartDate != "" ? Format.Tanggal(kontrak.StartDate) : "—")@(kontrak.EndDate != "" ? $" – {Format.Tanggal(kontrak.EndDate)}" : "")</NilaiInfo></div>
                                    </dl>
                                </KotakInfo>
                            </div>
                        }
                        @if (KontrakKlien.Count == 0)
                        {
                            <div class="col-12">
                                <Peringatan>Klien Dedicated ini belum punya kontrak aktif. Tambahkan kontraknya di <a href="@($"master/klien/{_f.Klien}")" class="fw-semibold text-decoration-underline" style="color:inherit">halaman klien</a>.</Peringatan>
                            </div>
                        }
                    </div>
                }
            </Bagian>

            <Bagian Judul="Informasi Kendaraan dan Supir">
                <div class="row g-3">
                    <Field Label="Kendaraan Utama" Required="@Wajib(Existing?.VehicleId)" Error="@_galat.GetValueOrDefault("kendaraan")" Class="col-md-4"
                           Info="@(KunciMobil ? "Mengikuti trip asal backload." : "Nomor polisi kendaraan yang jalan.")" Hint="HintKendaraan(kendaraan)">
                        <Pilihan Id="@context" Options="OpsiKendaraan" Value="@Kosong(_f.VehicleId)" Invalid="@_galat.ContainsKey("kendaraan")" Disabled="KunciMobil" Cari="true"
                                 Placeholder="Pilih nomor polisi..." SearchPlaceholder="Ketik nomor polisi atau jenis..." ValueChanged="PilihKendaraan" />
                    </Field>
                    <Field Label="Sub Kendaraan / Gandengan" Class="col-md-4" Info="Terisi dari konfigurasi kendaraan; boleh diganti." Hint="HintGandengan(kendaraan)">
                        <Pilihan Id="@context" Options="@AturanTrip.OpsiGandengan(_f.Gandengan, kendaraan?.Configuration ?? string.Empty)" Value="@Kosong(_f.Gandengan)" Cari="false"
                                 Placeholder="Low Bed / Hi Bed / 4x4 / Dolly" ValueChanged="v => _f.Gandengan = v ?? string.Empty" />
                    </Field>
                    <div class="col-md-4 d-flex flex-column gap-2">
                        @for (var i = 0; i < _f.DriverIds.Count; i++)
                        {
                            var k = i; var v = _f.DriverIds[k];
                            var diTripLain = v != "" ? Ditahan.Supir.GetValueOrDefault(v) : null;
                            <Field Label="@(k == 0 ? "Supir" : "Supir Pendamping")" Info="@InfoSupir(k)" Hint="HintSupir(diTripLain)">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="min-w-0 flex-grow-1">
                                        <Pilihan Id="@context" Options="OpsiSupir(v)" Value="@Kosong(v)" Disabled="KunciSupir" Cari="true" Placeholder="Cari kode / nama supir..." ValueChanged="nv => UbahSupir(k, nv)" />
                                    </div>
                                    @if (k > 0 && !KunciSupir)
                                    {
                                        <TombolIkon Label="Hapus supir pendamping" Tone="danger" Icon="Ikon.Xmark" OnClick="() => _f.DriverIds.RemoveAt(k)" />
                                    }
                                </div>
                            </Field>
                        }
                        @if (!KunciSupir && _f.DriverIds.Count < 3)
                        {
                            <div><TombolTeks OnClick="() => _f.DriverIds.Add(string.Empty)">+ Tambah supir pendamping</TombolTeks></div>
                        }
                    </div>
                </div>
                @if (kendaraanDiTripLain is not null && (_f.VehicleId == Existing?.VehicleId || KunciMobil))
                {
                    <Peringatan Class="mt-3">Kendaraan ini juga tercatat di trip <a href="@($"transaksi/trip/{kendaraanDiTripLain.Id}")" class="fw-semibold text-decoration-underline" style="color:inherit">@kendaraanDiTripLain.IdTampil</a> yang belum kembali ke pool.</Peringatan>
                }
            </Bagian>

            <Bagian Judul="Informasi Pengiriman">
                <div class="d-flex flex-column gap-3">
                    <div class="row g-3">
                        <Field Label="Rute" Required="@(!Dedicated && Wajib(Existing?.RouteId))" Error="@_galat.GetValueOrDefault("rute")" Info="@InfoRute" Class="col-md-6">
                            <Pilihan Id="@context" Options="OpsiRute" Value="@Kosong(_f.RouteId)" Invalid="@_galat.ContainsKey("rute")" Cari="true"
                                     Placeholder="Pilih rute..." SearchPlaceholder="Ketik nama, kode area, atau No. Rute..." ValueChanged="v => PilihRute(v)"
                                     Tambahan="@(new AksiTambahan { Label = _ => "Tambah rute baru", Disabled = !Bisa("master"), Hint = null, OnClick = _ => { _tambahRute = true; return Task.CompletedTask; } })" />
                        </Field>
                        @if (rute is not null)
                        {
                            <div class="col-md-6 align-self-start kotak-rute">
                                <KotakInfo>
                                    <dl class="m-0 row g-2 row-cols-2 row-cols-sm-4">
                                        <div class="col"><NilaiInfo Label="No. Rute">@rute.RouteCode</NilaiInfo></div>
                                        <div class="col"><NilaiInfo Label="Uang Jalan Rute">@Format.Rupiah(rute.Ujroute)</NilaiInfo></div>
                                        <div class="col"><NilaiInfo Label="Uang Tol">@Format.Rupiah(rute.Toll)</NilaiInfo></div>
                                        @if (!Dedicated) { <div class="col"><NilaiInfo Label="@(HargaBeda ? "Harga Jual trip (khusus)" : "Harga Jual")">@Format.Rupiah(HargaBeda ? _f.Harga : rute.Price)</NilaiInfo></div> }
                                    </dl>
                                    @if (!Dedicated)
                                    {
                                        <p class="m-0 mt-2 fs-11-5" style="color:var(--brand-700)">@(HargaBeda ? $"Harga Jual khusus tersimpan di trip ini (Harga Jual rute {Format.Rupiah(rute.Price)}). Memilih rute lagi memakai Harga Jual rute." : "Harga Jual mengikuti rute; diubah di Master Rute.")</p>
                                    }
                                </KotakInfo>
                            </div>
                        }
                    </div>

                    @* Isian Pick Up / Destination Details dihilangkan dulu (Baldy 22 Okt 2026); catatannya tetap diisi di sini. *@
                    <div class="row g-3">
                        <Field Label="Catatan Pick Up" Class="col-md-6">
                            <input id="@context" class="form-control" value="@_f.CatatanPengirim" placeholder="mis. info kapal, lokasi di pelabuhan, kontak pengambilan"
                                   @oninput="e => _f.CatatanPengirim = e.Value?.ToString() ?? string.Empty" />
                        </Field>
                        <Field Label="Catatan Destinasi" Class="col-md-6">
                            <input id="@context" class="form-control" value="@_f.CatatanPenerima" placeholder="mis. jam bongkar, gerbang masuk, kontak penerima di lokasi"
                                   @oninput="e => _f.CatatanPenerima = e.Value?.ToString() ?? string.Empty" />
                        </Field>
                    </div>

                    <div class="row g-3">
                        <Field Label="Kosongan" Class="col-md-6" Info="Depo container kosong (tempat ambil / kembalikan), bila trip membawa container. Kosongkan bila tidak ada.">
                            <input id="@context" class="form-control" value="@_f.Kosongan" placeholder="DEPO MUSTIKA CAKUNG" @oninput="e => _f.Kosongan = e.Value?.ToString() ?? string.Empty" />
                        </Field>
                    </div>
                </div>
            </Bagian>
        </div>

        <FormRute Open="_tambahRute" KodeAreaAsalAwal="@(AreaBackload == "" ? null : AreaBackload)" Keterangan="Rute baru langsung dipilih untuk trip ini."
                  PesanSukses="@(r => $"Rute {r.RouteName} tersimpan dan dipilih untuk trip ini.")" OnClose="() => _tambahRute = false"
                  OnTersimpan="r => { _tambahRute = false; PilihRute(r.Id, r); }" OnPakai="r => { _tambahRute = false; PilihRute(r.Id, r); }" />
        <FormAlamat Open="@(_tambahAlamat is not null)" NamaAwal="@_tambahAlamat?.Nama" KodeAwal="@_tambahAlamat?.Kode"
                    Keterangan="@(_tambahAlamat?.Pengirim == false ? "Alamat tujuan baru langsung dipilih sebagai Destination Details." : "Alamat baru langsung dipilih sebagai Pick Up Details.")"
                    OnClose="() => _tambahAlamat = null" OnTersimpan="AlamatTersimpan" />

        <div class="form-bar no-print">
            <div class="isi">
                <p class="m-0 tnum min-w-0 flex-grow-1 text-truncate fs-12-5 text-ink-3">@Ringkasan(klien, rute, kendaraan)</p>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <Tombol OnClick="Batal">Batal</Tombol>
                    <Tombol Icon="Ikon.Print" Disabled="@(!Bisa("trip"))" OnClick="() => SimpanAsync(true)">Simpan &amp; Cetak</Tombol>
                    <Tombol Variant="primary" Icon="Ikon.FloppyDisk" Disabled="@(!Bisa("trip"))" OnClick="() => SimpanAsync(false)">Simpan</Tombol>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? TripId { get; set; }
    [Parameter] public string? BackloadDari { get; set; }

    /// <summary>Isian form; mode ubah: salinan awal dipakai supaya nilai yang tidak disentuh disimpan apa adanya.</summary>
    public sealed class Isian
    {
        public string Klien { get; set; } = "";
        public string ContractId { get; set; } = "";
        public List<string> Tr { get; set; } = [];
        public string TransactionDate { get; set; } = "";
        public string VehicleId { get; set; } = "";
        public string Gandengan { get; set; } = "";
        public List<string> DriverIds { get; set; } = [""];
        public string RouteId { get; set; } = "";
        public long Harga { get; set; }
        public string OverrideNote { get; set; } = "";
        public List<string> OverrideAttachments { get; set; } = [];
        public string Pengirim { get; set; } = "";
        /// <summary>Lokasi pick up yang diketik bebas (bukan dari Master Alamat).</summary>
        public string TeksPengirim { get; set; } = "";
        public string CatatanPengirim { get; set; } = "";
        public string Penerima { get; set; } = "";
        public string TeksPenerima { get; set; } = "";
        public string CatatanPenerima { get; set; } = "";
        public List<ItemMuatan> Muatan { get; set; } = [new()];
        public string Kosongan { get; set; } = "";
    }

    private sealed record TambahAlamat(bool Pengirim, string Nama, string? Kode);

    private Isian _f = new();
    private Isian _awal = new();
    private readonly Dictionary<string, string> _galat = [];
    private bool _otomatisPengirim, _otomatisPenerima;
    private bool _tambahRute;
    private TambahAlamat? _tambahAlamat;
    private string _kodeAwal = "";

    private Model.Trip? Existing { get; set; }
    private BarisTrip? CalonAsal { get; set; }
    /// <summary>Trip asal backload; trip yang sudah dibatalkan tidak bisa dilanjutkan.</summary>
    private BarisTrip? Asal => CalonAsal is not null && !CalonAsal.Batal ? CalonAsal : null;
    private bool Backload => Asal is not null;
    private string AreaBackload => Asal is null ? "" : Asal.AreaTujuan != "" ? Asal.AreaTujuan : TripLogika.NormalKodeArea(Asal.Bongkar);
    /// <summary>Backload: kendaraan & supir mengikuti trip asal.</summary>
    private bool KunciMobil => Backload && Asal!.T.VehicleId != "";
    private bool KunciSupir => Backload && Asal!.DriverIds.Count > 0;
    /// <summary>Tombol kembali: detail trip yang diubah, trip asal backload, atau daftar trip.</summary>
    private string KembaliKe => Existing is not null ? $"transaksi/trip/{Existing.Id}" : Asal is not null ? $"transaksi/trip/{Asal.Id}" : "transaksi/trip";
    private Klien? KlienDipilih => Db.Cari<Klien>(_f.Klien);
    private string Layanan => KlienDipilih?.ClientType ?? (Existing?.ServiceType is { Length: > 0 } s ? s : TipeKlien.Callout);
    private bool Dedicated => Layanan == TipeKlien.Dedicated;
    private Rute? Rute => Db.Cari<Rute>(_f.RouteId);
    /// <summary>Trip lama yang tersimpan dengan harga khusus: tetap ditampilkan apa adanya, tidak bisa diubah di sini.</summary>
    private bool HargaBeda => !Dedicated && Rute is not null && _f.Harga > 0 && _f.Harga != Rute.Price;
    private TitikAlamat? PengirimLama => TitikLamaDari(Existing?.Pengirim);
    private TitikAlamat? PenerimaLama => TitikLamaDari(Existing?.Penerima);
    /// <summary>Trip lama boleh belum lengkap: jangan paksa diisi hanya karena diubah.</summary>
    private bool Wajib(string? adaSebelumnya) => TripId is null || !string.IsNullOrEmpty(adaSebelumnya);
    private static string? Kosong(string v) => v == "" ? null : v;
    private static RenderFragment? T(string? s) => s is null ? null : b => b.AddContent(0, s);

    private Ditahan? _ditahan;
    private Ditahan Ditahan => _ditahan ??= AturanTrip.PetaDitahan(Db.Baris, Existing?.Id, Asal?.Id);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Existing = TripId is null ? null : Db.Data.Trip.FirstOrDefault(t => t.Id == TripId);
        CalonAsal = TripId is null && BackloadDari is not null ? Db.BarisTrip(BackloadDari) : null;
        var semuaNomor = Db.Semua.Trip.Where(t => t.Id != Existing?.Id).Select(t => t.TransactionNo).ToList();
        // Kode Trip: dibuat sekali saat form dibuka ("langsung ter-generate begitu Tambah Trip diklik").
        _kodeAwal = Existing?.TransactionNo ?? (Asal is not null ? TripLogika.IdBackload(Asal.T.TransactionNo, semuaNomor) : Kode.NomorTripBerikut(semuaNomor, Format.HariIni()));
        _awal = IsianAwal();
        _f = Database.Salin(_awal);
    }

    /// <summary>Trip terkunci baru saja diaktifkan lagi: baca ulang trip dan isi form-nya.</summary>
    private void MuatUlang()
    {
        Existing = Db.Data.Trip.FirstOrDefault(t => t.Id == TripId);
        _awal = IsianAwal();
        _f = Database.Salin(_awal);
    }

    private TitikAlamat? TitikLamaDari(TitikAlamat? t) =>
        t is not null && AturanTrip.TitikTerisi(t) && !(t.AlamatId is { Length: > 0 } id && Db.Data.Alamat.Any(a => a.Id == id)) ? t : null;

    private string NilaiTitik(TitikAlamat? t) => t is null ? "" : t.AlamatId is { Length: > 0 } id && Db.Data.Alamat.Any(a => a.Id == id) ? id : AturanTrip.TitikTerisi(t) ? AturanTrip.TitikLama : "";

    private Isian IsianAwal()
    {
        if (Existing is { } e)
        {
            var r = Db.Cari<Rute>(e.RouteId);
            var sopir = e.DriverIds.Count > 0 ? e.DriverIds : e.DriverId != "" ? [e.DriverId] : new List<string>();
            var konfigurasi = Db.Cari<Kendaraan>(e.VehicleId)?.Configuration ?? "";
            var muatan = TripLogika.Muatan(e);
            return new Isian
            {
                Klien = e.ProjectId, ContractId = e.ContractId, Tr = TripLogika.Tr(e), TransactionDate = e.TransactionDate, VehicleId = e.VehicleId,
                Gandengan = AturanTrip.RapikanGandengan(string.IsNullOrEmpty(e.Gandengan) ? konfigurasi : e.Gandengan),
                DriverIds = sopir.Count > 0 ? [.. sopir] : [""], RouteId = e.RouteId, Harga = e.CostValue > 0 ? e.CostValue : r?.Price ?? 0,
                OverrideNote = e.OverrideNote ?? "", OverrideAttachments = e.OverrideAttachments ?? [],
                Pengirim = NilaiTitik(e.Pengirim), CatatanPengirim = e.Pengirim?.Catatan ?? "",
                Penerima = NilaiTitik(e.Penerima), CatatanPenerima = e.Penerima?.Catatan ?? "",
                Muatan = muatan.Count > 0 ? muatan.Select(m => m.Salin()).ToList() : [new()], Kosongan = e.Kosongan,
            };
        }
        var a = Asal;
        var konfigurasiAsal = a is null ? "" : Db.Cari<Kendaraan>(a.T.VehicleId)?.Configuration ?? "";
        // Backload: barang balik diambil dari tempat bongkar trip asal (penerimanya menjadi pick up).
        var pickupAsal = a?.T.Penerima?.AlamatId is { Length: > 0 } pid && Db.Data.Alamat.Any(x => x.Id == pid) ? pid : "";
        return new Isian
        {
            Klien = a?.T.ProjectId ?? "", ContractId = a?.T.ServiceType == TipeKlien.Dedicated ? a.T.ContractId : "",
            TransactionDate = Format.HariIni(), VehicleId = a?.T.VehicleId ?? "",
            Gandengan = AturanTrip.RapikanGandengan(a is null ? "" : !string.IsNullOrEmpty(a.T.Gandengan) ? a.T.Gandengan : konfigurasiAsal),
            DriverIds = a is not null && a.DriverIds.Count > 0 ? [.. a.DriverIds] : [""], Pengirim = pickupAsal,
        };
    }

