    /// <summary>Rute yang pernah dipakai klien ini paling atas; backload: rute dari lokasi bongkar trip asal.</summary>
    private List<Opsi> OpsiRute
    {
        get
        {
            var pakai = new Dictionary<string, int>();
            foreach (var t in Db.Baris) if (t.T.ProjectId != "" && t.T.ProjectId == _f.Klien && t.T.RouteId != "") pakai[t.T.RouteId] = pakai.GetValueOrDefault(t.T.RouteId) + 1;
            bool DariBongkar(Rute r) => AreaBackload != "" && AturanTrip.SamaArea(TripLogika.KodeArea(r).Asal, AreaBackload);
            return Db.Data.Rute
                .OrderByDescending(DariBongkar).ThenByDescending(r => pakai.GetValueOrDefault(r.Id))
                .ThenBy(r => r.RouteName != "" ? r.RouteName : r.RouteCode, StringComparer.OrdinalIgnoreCase)
                .Select(r =>
                {
                    var a = TripLogika.KodeArea(r);
                    var meta = string.Join(" · ", new[] { DariBongkar(r) ? "dari destinasi trip asal" : "", pakai.TryGetValue(r.Id, out var n) ? $"{n}× dipakai klien ini" : "", $"No. {r.RouteCode}", $"Uang Jalan {Format.Rupiah(r.Ujroute)}" }.Where(x => x != ""));
                    return new Opsi(r.Id, r.RouteName != "" ? r.RouteName : r.RouteCode, meta, $"{r.RouteCode} {r.RouteCodeLama} {a.Asal} {a.Tujuan}");
                }).ToList();
        }
    }

    private List<Opsi> OpsiKendaraan
    {
        get
        {
            var daftar = Db.Data.Kendaraan.Select(v =>
            {
                var t = v.Id != Existing?.VehicleId ? Ditahan.Kendaraan.GetValueOrDefault(v.Id) : null;
                var meta = t is not null ? AturanTrip.AlasanDitahan(t)
                    : string.Join(" · ", new[] { AturanTrip.LabelGandengan(v.Configuration), v.VehicleType, v.Status != "aktif" ? v.Status : "" }.Where(x => x != ""));
                return new Opsi(v.Id, v.PlateNumber, meta, $"{v.Configuration} {v.VehicleType}", t is not null);
            }).ToList();
            // Yang bisa dipilih di atas; yang masih di trip lain di bawah, lengkap dengan alasannya.
            return daftar.Where(o => !o.Disabled).Concat(daftar.Where(o => o.Disabled)).ToList();
