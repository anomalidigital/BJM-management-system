    private bool Validasi()
    {
        _galat.Clear();
        if (Wajib(Existing?.ProjectId) && _f.Klien == "") _galat["klien"] = "Klien wajib dipilih: tipe layanan dan tagihan mengikuti klien.";
        if (_f.TransactionDate == "") _galat["tanggal"] = "Tanggal berangkat wajib diisi.";
        if (Dedicated && _f.ContractId == "")
            _galat["kontrak"] = KontrakKlien.Count > 0 ? "Klien Dedicated: pilih kontrak yang dipakai trip ini." : "Klien Dedicated ini belum punya kontrak aktif. Tambahkan dulu di halaman klien.";
        if (Wajib(Existing?.VehicleId) && _f.VehicleId == "") _galat["kendaraan"] = "Kendaraan wajib dipilih.";
        var tahan = _f.VehicleId != "" && _f.VehicleId != Existing?.VehicleId ? Ditahan.Kendaraan.GetValueOrDefault(_f.VehicleId) : null;
        if (tahan is not null) _galat["kendaraan"] = $"Kendaraan ini masih di trip {tahan.IdTampil} dan belum kembali ke pool. Pilih kendaraan lain, atau catat dulu kendaraannya kembali di pool pada trip itu.";
        if (!Dedicated && Wajib(Existing?.RouteId) && _f.RouteId == "") _galat["rute"] = "Rute wajib dipilih.";
        return _galat.Count == 0;
    }

    /// <summary>Salinan alamat untuk trip; isian lama yang tidak diganti disimpan apa adanya (catatannya ikut yang baru).
    /// Lokasi yang diketik bebas tersimpan sebagai nama lokasi tanpa tautan Master Alamat.</summary>
    private TitikAlamat? TitikTrip(string nilai, string teks, string catatan, TitikAlamat? lama)
    {
        if (nilai == "" && teks.Trim() != "") return AturanTrip.TitikRapi(new TitikAlamat { Nama = teks.Trim(), Catatan = catatan });
        // Hanya catatan (isian lokasi disembunyikan): catatannya tetap tersimpan.
        if (nilai == "") return catatan.Trim() != "" ? AturanTrip.TitikRapi(new TitikAlamat { Catatan = catatan }) : null;
        if (nilai == AturanTrip.TitikLama)
        {
            if (lama is null) return null;
            var s = lama.Salin(); s.Catatan = catatan;
            return AturanTrip.TitikRapi(s);
        }
        var a = Db.Data.Alamat.FirstOrDefault(x => x.Id == nilai);
        if (a is null) return null;
        // Alamat sama dengan salinan lama: pertahankan salinannya (Master Alamat mungkin sudah berubah sesudahnya).
        if (lama?.AlamatId == a.Id) { var s = lama.Salin(); s.Catatan = catatan; return AturanTrip.TitikRapi(s); }
        return AturanTrip.TitikDariAlamat(a, catatan);
    }

    private static bool Sama<TV>(TV a, TV b) => System.Text.Json.JsonSerializer.Serialize(a, Database.Json) == System.Text.Json.JsonSerializer.Serialize(b, Database.Json);
    private static bool KosongNilai(object? v) => v is null || (v is string s && s == "") || (v is System.Collections.ICollection c && c.Count == 0);

    /// <summary>Tulis isian ke trip. Mode ubah: isian yang tidak disentuh menyimpan nilai lama apa adanya (Audit Log hanya mencatat yang diubah).</summary>
    private void Terapkan(Model.Trip t, string nomor)
    {
        var ubah = Existing is not null;
        var sopir = _f.DriverIds.Where(x => x != "").Distinct().ToList();
        var muatan = _f.Muatan.Select(m => new ItemMuatan { IdPerjalanan = m.IdPerjalanan.Trim().ToUpperInvariant(), Keterangan = m.Keterangan.Trim() })
            .Where(m => m.IdPerjalanan != "" || m.Keterangan != "").ToList();
        T2 Tetap<T2>(bool tidakDisentuh, T2 baru, T2 lama) => ubah && tidakDisentuh ? lama : baru;
        void Isi<T2>(T2 baru, Func<T2> lama, Action<T2> set) { if (!(ubah && KosongNilai(baru) && KosongNilai(lama()))) set(baru); }

        var statusTrip = Existing is null || Existing.Status is StatusTrip.MenungguSopir or StatusTrip.Aktif or StatusTrip.Draft
            ? (sopir.Count > 0 ? StatusTrip.Aktif : StatusTrip.MenungguSopir) : Existing.Status;
        t.TransactionNo = nomor;
        t.TransactionDate = _f.TransactionDate;
        // Tanggal order = hari trip didaftarkan (tidak lagi diisi di form).
        t.OrderDate = Existing is not null ? Existing.OrderDate : Format.HariIni();
        t.ServiceType = Layanan;
        t.ContractId = Dedicated ? _f.ContractId : "";
        t.ProjectId = _f.Klien;
        Isi(Tetap(Sama(_f.Tr, _awal.Tr), _f.Tr, Existing?.TrNumbers), () => t.TrNumbers, v => t.TrNumbers = v);
        t.RouteId = _f.RouteId;
        t.VehicleId = _f.VehicleId;
        Isi(Tetap(_f.Gandengan == _awal.Gandengan, AturanTrip.RapikanGandengan(_f.Gandengan), Existing?.Gandengan), () => t.Gandengan, v => t.Gandengan = v);
        t.DriverId = sopir.FirstOrDefault() ?? "";
        t.DriverIds = sopir;
        t.Status = statusTrip;
        // Harga 0 di trip lama = ikut Harga Rute; tetap 0 selama harga dan rutenya tidak diubah.
        t.CostValue = Dedicated ? 0 : Existing is not null && _f.RouteId == Existing.RouteId ? (_f.Harga == _awal.Harga ? Existing.CostValue : _f.Harga) : _f.Harga;
        Isi(HargaBeda ? _f.OverrideNote.Trim() : "", () => t.OverrideNote, v => t.OverrideNote = v);
        Isi(HargaBeda ? _f.OverrideAttachments : [], () => t.OverrideAttachments, v => t.OverrideAttachments = v);
        var pengirim = TitikTrip(_f.Pengirim, _f.TeksPengirim, _f.CatatanPengirim, Existing?.Pengirim);
        t.Pengirim = ubah && (AturanTrip.SamaTitik(Existing!.Pengirim, pengirim) || (_f.Pengirim == _awal.Pengirim && _f.TeksPengirim == _awal.TeksPengirim && _f.CatatanPengirim == _awal.CatatanPengirim)) ? Existing!.Pengirim : pengirim;
        var penerima = TitikTrip(_f.Penerima, _f.TeksPenerima, _f.CatatanPenerima, Existing?.Penerima);
        t.Penerima = ubah && (AturanTrip.SamaTitik(Existing!.Penerima, penerima) || (_f.Penerima == _awal.Penerima && _f.TeksPenerima == _awal.TeksPenerima && _f.CatatanPenerima == _awal.CatatanPenerima)) ? Existing!.Penerima : penerima;
        var muatanSama = Sama(_f.Muatan, _awal.Muatan);
        Isi(Tetap(muatanSama, muatan, Existing?.Muatan), () => t.Muatan, v => t.Muatan = v);
        // ID Perjalanan tetap disalin ke trip_ids supaya bisa dicari dari mana pun.
        Isi(Tetap(muatanSama, muatan.Select(m => m.IdPerjalanan).Where(x => x != "").ToList(), Existing?.TripIds ?? []), () => t.TripIds, v => t.TripIds = v ?? []);
        t.Kosongan = _f.Kosongan.Trim();
        if (Asal is not null) { t.BackloadDari = Asal.Id; t.ManagerId = Asal.T.ManagerId; t.ManagerName = Asal.T.ManagerName; }
    }

    private async Task SimpanAsync(bool cetak)
    {
        if (!Validasi())
        {
            Toast.Galat("Periksa kembali isian yang ditandai merah.");
            StateHasChanged();
            await Task.Delay(60);
            await Simpan.GulirKeAsync(".invalid-feedback, .is-invalid");
            return;
        }
        if (Existing is not null)
        {
            Db.Ubah<Model.Trip>(Existing.Id, t => Terapkan(t, Existing.TransactionNo));
            Toast.Sukses($"Trip {Existing.TransactionNo} berhasil diperbarui.");
            Ke($"transaksi/trip/{Existing.Id}{(cetak ? "?print=1" : "")}");
            return;
        }
        // Kode Trip dicek ulang saat disimpan: bila sudah dipakai trip lain, dipakai nomor berikutnya.
        var nomorSekarang = Db.Semua.Trip.Select(t => t.TransactionNo).ToList();
        var nomor = !nomorSekarang.Contains(_kodeAwal) ? _kodeAwal
            : Asal is not null ? TripLogika.IdBackload(Asal.T.TransactionNo, nomorSekarang) : Kode.NomorTripBerikut(nomorSekarang, Format.HariIni());
        var baru = new Model.Trip();
        Terapkan(baru, nomor);
        Db.BuatTrip(baru);
        if (Asal is not null && Asal.T.AdaBackload != true) Db.Ubah<Model.Trip>(Asal.Id, t => t.AdaBackload = true);
        Toast.Sukses(nomor != _kodeAwal ? $"Kode {_kodeAwal} sudah dipakai, trip tersimpan sebagai {nomor}."
            : Asal is not null ? $"Backload / lanjutan {nomor} tersimpan." : $"Trip {nomor} tersimpan. Catat uang jalan di tab Uang Jalan saat dibayar.");
        Ke($"transaksi/trip/{baru.Id}{(cetak ? "?print=1" : "")}");
    }

    private void Batal() => Ke(Existing is not null ? $"transaksi/trip/{Existing.Id}" : Asal is not null ? $"transaksi/trip/{Asal.Id}" : "transaksi/trip");
}
