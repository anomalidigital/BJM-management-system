@inherits KomponenData
@*
    Overview trip Karawang: yang dibutuhkan alur alat berat & DHL saja (ID Trip, No Referensi, Pick Up & Destination Details berikut
    catatannya, posisi kendaraan, POD, backload / lanjutan, PI). Isian container Priok (Party, SI/BL, Kapal, penerima Surat Jalan, bon)
    tidak ditampilkan di sini. Revisi Baldy 22 Okt 2026: rincian supir lengkap (nama lengkap, telepon, KTP, SIM beserta masa berlakunya)
    dan dokumen kendaraan; Add Items Details dan catatan perjalanan (tab Perjalanan dihapus) tidak tampil lagi.
*@
@{
    var t = Trip.T;
    var manager = t.ManagerId != "" ? Db.Cari<Karyawan>(t.ManagerId) : null;
    var kontrak = t.ContractId != "" ? Db.Data.Kontrak.FirstOrDefault(c => c.Id == t.ContractId) : null;
    var terpakaiKontrak = kontrak is null ? 0
        : Db.Baris.Where(x => x.T.ContractId == kontrak.Id && !x.Batal).Sum(x => x.UjTotal + x.ExpenseTotal + x.InternalTotal);
    var induk = string.IsNullOrEmpty(t.BackloadDari) ? null : Db.BarisTrip(t.BackloadDari);
    var anak = Db.Baris.Where(x => x.T.BackloadDari == Trip.Id).ToList();
    var kejadian = TripLogika.Kejadian(Db.Semua.Kejadian, Trip.Id);
    var fotoBongkar = kejadian.Where(e => e.Jenis == "bongkar").SelectMany(e => e.Attachments).ToList();
    List<string> fotoPod = [.. t.PodAttachments ?? [], .. fotoBongkar];
    var kendaraan = Db.Cari<Kendaraan>(t.VehicleId);
    var batal = Trip.Batal;
    var dedicated = t.ServiceType == TipeKlien.Dedicated;
    var totalTagihan = batal ? t.CancelFee ?? 0 : Trip.Harga + Trip.BiayaDitagihkan;
    /* Ditutup dengan foto dulu: begitu supir menyerahkan hardcopy di pool, ditandai di sini. */
    var fisikMenyusul = t.Status == StatusTrip.Selesai && t.PodFisik == false;
    var lanjutan = anak.Where(a => !a.Batal).ToList();
    var waktuPool = AturDetail.WaktuPool(Trip, kejadian);
    var jenisSim = DokumenPentingJenis.Karyawan.Where(j => j.Kode == "SIM").ToArray();
}
<div class="row g-3 p-3">
    <div class="col-xl-8 d-flex flex-column gap-3">
        <Kartu>
            <KepalaKartu Title="Trip">
                <Actions>
                    @if (!string.IsNullOrEmpty(t.PrintedAt)) { <Badge Tone="good">Berita Acara tercetak @Format.Tanggal(t.PrintedAt)</Badge> }
                    else { <Badge Tone="warning">Berita Acara belum dicetak</Badge> }
                </Actions>
            </KepalaKartu>
            @* ID Trip = Kode Trip (atasan 13 Okt 2026); ID Perjalanan ada di Add Items Details. *@
            <div class="border-bottom border-hairline px-3 py-3">
                <p class="m-0 fs-11-5 fw-semibold text-ink-3 text-uppercase" style="letter-spacing:.04em">ID Trip</p>
                <p class="m-0 mt-1 tnum fw-semibold text-ink lh-tight text-break" style="font-size:18px;letter-spacing:-.01em">@AturDetail.Strip(t.TransactionNo)</p>
            </div>
            <div class="p-3"><dl class="row row-cols-1 row-cols-sm-3 g-3 mb-0">
                <InfoItem Label="Tanggal Order" Value="@(string.IsNullOrEmpty(t.OrderDate) ? "—" : Format.Tanggal(t.OrderDate))" Mono />
                <InfoItem Label="Tanggal Berangkat" Value="@Format.Tanggal(t.TransactionDate)" Mono />
                <InfoItem Label="Klien" Value="@(Trip.ProjectCode != "" ? $"{Trip.ProjectCode} — {Trip.ProjectName}" : "—")" />
                <InfoItem Label="Tipe Layanan" Value="@TipeKlien.Label(t.ServiceType)" />
                @if (!dedicated)
                {
                    <InfoItem Label="Harga Jual" Mono>
                        @Format.Rupiah(Trip.Harga)
                        @if (Trip.Harga > 0 && Trip.Harga == Trip.RoutePrice) { <span class="ms-2 fs-11-5 fw-normal text-ink-3">ikut Harga Jual rute</span> }
                        @if (!string.IsNullOrEmpty(t.OverrideNote)) { <span class="mt-1 d-block fs-11-5 fw-normal text-ink-3 text-wrap">Alasan: @t.OverrideNote</span> }
                    </InfoItem>
                }
                <InfoItem Label="Manager">
                    @if (manager is not null) { <a href="@($"master/karyawan/{manager.Id}")" class="text-ink text-decoration-none">@manager.DriverName</a> }
                    else { @(t.ManagerName != "" ? t.ManagerName : "—") }
                </InfoItem>
                <InfoItem Label="Status" Value="@($"{StatusTrip.Label(t.Status)}{(string.IsNullOrEmpty(t.ClosedAt) ? "" : $" · ditutup {Format.Tanggal(t.ClosedAt)}")}")" />
            </dl></div>
        </Kartu>

        <Kartu>
            <KepalaKartu Title="Informasi Pengiriman" Subtitle="Pick up, destinasi, dan barang yang dibawa." />
            <div class="d-sm-flex border-bottom border-hairline">
                <div class="flex-fill min-w-0" style="flex-basis:0"><TitikTrip Judul="Pick Up Details" Titik="t.Pengirim" /></div>
                <hr class="d-sm-none m-0 opacity-100" style="border-color:var(--hairline)" />
                <div class="vr d-none d-sm-block opacity-100" style="background-color:var(--hairline)"></div>
                <div class="flex-fill min-w-0" style="flex-basis:0"><TitikTrip Judul="Destination Details" Titik="t.Penerima" /></div>
            </div>
            <div class="p-3"><dl class="row row-cols-1 row-cols-sm-2 g-3 mb-0">
                <InfoItem Label="No Referensi">
                    @if (Trip.TrList.Count > 0)
                    {
                        <span class="d-flex flex-wrap gap-1">@foreach (var tr in Trip.TrList) { <span class="tnum rounded border border-hairline bg-sunken px-1 fs-12-5">@tr</span> }</span>
                    }
                    else { @("—") }
                </InfoItem>
                <InfoItem Label="Kosongan" Value="@AturDetail.Strip(t.Kosongan)" />
            </dl></div>
        </Kartu>

        <Kartu>
            <KepalaKartu Title="Kendaraan & Supir" />
            <div class="p-3"><dl class="row row-cols-1 row-cols-sm-2 g-3 mb-0">
                <InfoItem Label="No. Kendaraan" Value="@(kendaraan is not null ? $"{kendaraan.PlateNumber}{(kendaraan.Configuration != "" ? $" · {kendaraan.Configuration}" : "")}" : "—")" Mono />
                <InfoItem Label="Sub Kendaraan / Gandengan">
                    @if (!string.IsNullOrEmpty(t.Gandengan)) { @AturanTrip.LabelGandengan(t.Gandengan) }
                    else if (!string.IsNullOrEmpty(kendaraan?.Configuration)) { @AturanTrip.LabelGandengan(kendaraan.Configuration) <span class="fw-normal text-ink-3"> (ikut kendaraan)</span> }
                    else { @("—") }
                </InfoItem>
                <InfoItem Label="Posisi kendaraan">
                    @if (t.VehicleId == "") { <span class="text-ink-3">Belum ada kendaraan</span> }
                    else if (batal) { <span class="text-ink-3">Dilepas, trip dibatalkan</span> }
                    else if (lanjutan.Count > 0)
                    {
                        <span class="d-flex flex-wrap align-items-center gap-1 text-wrap">
                            <Badge Tone="brand">Dilanjutkan trip lanjutan</Badge>
                            <a href="@($"transaksi/trip/{lanjutan[^1].Id}")" class="tnum fw-semibold text-break text-decoration-none">Trip @lanjutan[^1].IdTampil</a>
                        </span>
                    }
                    else if (waktuPool != "") { <Badge Tone="good">Sudah di pool · @Format.Waktu(waktuPool)</Badge> }
                    else if (Trip.MenahanKendaraan) { <Badge Tone="@(t.Status == StatusTrip.Selesai ? "warning" : "brand")">Masih dipakai trip ini</Badge> }
                    else { <span class="text-ink-3">Tidak ditahan (trip lama)</span> }
                </InfoItem>
                <div class="col-12 col-sm-12 min-w-0">
                    <dt class="fs-11-5 fw-semibold text-ink-3 text-uppercase" style="letter-spacing:.04em">Dokumen kendaraan</dt>
                    <dd class="m-0 mt-1 fs-13">
                        @if (kendaraan is null) { <span class="text-ink-3">—</span> }
                        else { <TagDokumen Jenis="DokumenPentingJenis.Kendaraan" Dokumen="kendaraan.Dokumen" Lainnya="kendaraan.Attachments.Count" /> }
                    </dd>
                </div>
            </dl></div>
            @* Rincian supir (Baldy 22 Okt 2026): nama lengkap, kontak, KTP, dan SIM beserta masa berlakunya. *@
            <div class="border-top border-hairline">
                @if (Trip.DriverIds.Count == 0)
                {
                    <p class="m-0 px-3 py-3 fs-13 text-ink-3">Belum ada supir di trip ini.</p>
                }
                @for (var i = 0; i < Trip.DriverIds.Count; i++)
                {
                    var d = Db.Cari<Karyawan>(Trip.DriverIds[i]);
                    var utama = i == 0;
                    if (d is null) { continue; }
                    var sim = d.Dokumen?.GetValueOrDefault("SIM");
                    var ktp = d.Dokumen?.GetValueOrDefault("KTP");
                    <div class="px-3 py-3 @(i > 0 ? "border-top border-hairline" : "")" data-rincian-supir>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="fs-11-5 fw-semibold text-ink-3 text-uppercase" style="letter-spacing:.04em">@(utama ? "Supir" : "Supir pendamping")</span>
                            <a href="@($"master/karyawan/{d.Id}")" class="fw-semibold text-ink text-decoration-none">@d.DriverName</a>
                            <span class="tnum fs-12 text-ink-3">@d.DriverCode</span>
                            @if (Trip.DriverIds.Count > 1 && utama) { <Badge Tone="brand">Utama · penerima komisi</Badge> }
                            @if (d.Status != StatusKaryawan.Aktif) { <Badge Tone="@StatusKaryawan.Nada(d.Status)">@StatusKaryawan.Label(d.Status)</Badge> }
                        </div>
                        <dl class="row row-cols-2 row-cols-sm-3 row-cols-lg-5 g-3 mb-0 mt-0">
                            <InfoItem Label="Nama Lengkap" Value="@(d.NamaLengkap != "" ? d.NamaLengkap : "—")" />
                            <InfoItem Label="Telepon" Value="@(d.Phone != "" ? d.Phone : "—")" Mono />
                            <InfoItem Label="No. KTP" Value="@(ktp?.Nomor ?? "—")" Mono />
                            <InfoItem Label="No. SIM" Value="@(sim?.Nomor ?? "—")" Mono />
                            <div class="min-w-0">
                                <dt class="fs-11-5 fw-semibold text-ink-3 text-uppercase" style="letter-spacing:.04em">Masa berlaku SIM</dt>
                                <dd class="m-0 mt-1 fs-13"><TagDokumen Jenis="jenisSim" Dokumen="d.Dokumen" /></dd>
                            </div>
                        </dl>
                    </div>
                }
            </div>
        </Kartu>

        <Kartu>
            <KepalaKartu Title="Penutupan & POD" Subtitle="@(fisikMenyusul ? "POD baru difoto. Tandai setelah supir menyerahkan dokumen fisiknya di pool; kendaraannya ikut tercatat kembali di pool." : "Trip ditutup setelah bukti dokumen (POD) diterima.")">
                <Actions>
                    @if (fisikMenyusul) { <Tombol Size="sm" Variant="primary" Disabled="@(!Bisa("trip"))" OnClick="TandaiFisik">Tandai fisik diterima</Tombol> }
                </Actions>
            </KepalaKartu>
            <div class="p-3"><dl class="row row-cols-1 row-cols-sm-3 g-3 mb-0">
                <InfoItem Label="POD">
                    @if (t.Status != StatusTrip.Selesai) { <span class="text-ink-3">Belum ditutup</span> }
                    else if (t.PodFisik == false) { <Badge Tone="warning">Foto dulu, fisik menyusul</Badge> }
                    else if (t.PodFisik == true) { <Badge Tone="good">Fisik diterima@(string.IsNullOrEmpty(t.PodFisikAt) ? "" : $" {Format.Tanggal(t.PodFisikAt)}")</Badge> }
                    else { <span class="text-ink-3">Data lama</span> }
                </InfoItem>
                <InfoItem Label="Backload / lanjutan" Value="@(lanjutan.Count > 0 ? $"Ada, {string.Join(", ", lanjutan.Select(a => a.IdTampil))}" : t.AdaBackload == true ? "Ditandai ada, belum dibuat" : "—")" />
                <InfoItem Label="Ditutup" Value="@(string.IsNullOrEmpty(t.ClosedAt) ? "—" : Format.Tanggal(t.ClosedAt))" Mono />
            </dl></div>
            @if (fotoPod.Count > 0)
            {
                <div class="border-top border-hairline px-3 py-3">
                    <p class="mb-2 fs-11-5 fw-semibold text-ink-3 text-uppercase" style="letter-spacing:.04em">Foto POD</p>
                    <LampiranThumbs Ids="fotoPod" Ukuran="56" />
                </div>
            }
            @if (t.Notes != "")
            {
                <div class="border-top border-hairline px-3 py-3">
                    <p class="m-0 fs-11-5 fw-semibold text-ink-3 text-uppercase" style="letter-spacing:.04em">Catatan</p>
                    <p class="m-0 mt-1 fs-13 text-ink" style="white-space:pre-line">@t.Notes</p>
                </div>
            }
        </Kartu>
    </div>

    <div class="col-xl-4 d-flex flex-column gap-3">
        @if (induk is not null || anak.Count > 0)
        {
            <Kartu>
                <KepalaKartu Title="Backload / Lanjutan" Subtitle="Trip lanjutan dari destinasi trip ini, dengan kendaraan dan supir yang sama." />
                <ul class="list-unstyled m-0">
                    @if (induk is not null)
                    {
                        <li class="px-3 py-2 fs-13 border-bottom border-hairline">
                            <span class="text-ink-3">Lanjutan dari </span>
                            <a href="@($"transaksi/trip/{induk.Id}")" class="tnum fw-semibold text-break text-decoration-none">Trip @induk.IdTampil</a>
                            <span class="d-block fs-12 text-ink-3">@(induk.Muat != "" ? induk.Muat : "?") → @(induk.Bongkar != "" ? induk.Bongkar : "?")</span>
                        </li>
                    }
                    @foreach (var a in anak)
                    {
                        <li class="px-3 py-2 fs-13 border-bottom border-hairline">
                            <span class="text-ink-3">Dilanjutkan: </span>
                            <a href="@($"transaksi/trip/{a.Id}")" class="tnum fw-semibold text-break text-decoration-none">Trip @a.IdTampil</a>
                            <span class="d-block fs-12 text-ink-3">@(a.Muat != "" ? a.Muat : "?") → @(a.Bongkar != "" ? a.Bongkar : "?") · @StatusTrip.Label(a.Status)</span>
                        </li>
                    }
                </ul>
            </Kartu>
        }

        <KartuRute Trip="Trip" />

        @if (kontrak is not null)
        {
            <Kartu>
                <KepalaKartu Title="Kontrak Dedicated" Subtitle="@(Trip.ClientName != "" ? Trip.ClientName : "Klien tidak ditemukan")">
                    <Actions>@if (kontrak.ProjectId != "") { <a href="@($"master/klien/{kontrak.ProjectId}")" class="fs-12-5 fw-medium text-decoration-none">Lihat klien</a> }</Actions>
                </KepalaKartu>
                <div class="p-3"><dl class="row row-cols-2 g-3 mb-0">
                    <InfoItem Label="No. Kontrak" Value="@kontrak.ContractNo" Mono />
                    <InfoItem Label="Nilai" Value="@Format.Rupiah(kontrak.Value)" Mono />
                    <InfoItem Label="Terpakai" Value="@Format.Rupiah(terpakaiKontrak)" Mono />
                    <InfoItem Label="Sisa" Value="@Format.Rupiah(kontrak.Value - terpakaiKontrak)" Mono />
                </dl></div>
            </Kartu>
        }

        <Kartu>
            <KepalaKartu Title="Tagihan (PI)"
                         Subtitle="@(batal ? (t.CancelFee > 0 ? "Trip batal dengan biaya cancel ditagihkan." : "Trip batal tidak ditagihkan.") : dedicated && string.IsNullOrEmpty(t.PiTahap) ? "Dedicated: ditagihkan lewat kontrak, bukan PI per trip." : "Harga + biaya yang ditagihkan ke klien.")">
                <Actions><a href="transaksi/tagihan" class="fs-12-5 fw-medium text-decoration-none">Buka Tagihan</a></Actions>
            </KepalaKartu>
            <div class="p-3"><dl class="row row-cols-2 g-3 mb-0">
                <InfoItem Label="No PI" Value="@AturDetail.Strip(t.PiNumber)" Mono />
                <InfoItem Label="Tahap" Value="@(!string.IsNullOrEmpty(t.PiTahap) ? TahapPi.Label(t.PiTahap) : dedicated ? "Lewat kontrak" : t.Status == StatusTrip.Selesai || (batal && t.CancelFee > 0) ? "Siap dibuatkan PI" : "Menunggu trip ditutup")" />
                @if (!batal) { <InfoItem Label="Biaya ditagihkan" Value="@Format.Rupiah(Trip.BiayaDitagihkan)" Mono /> }
                <InfoItem Label="@(batal ? "Biaya cancel" : "Total tagihan")" Value="@(dedicated && !batal ? "—" : Format.Rupiah(totalTagihan))" Mono />
            </dl></div>
            @if (t.PiAttachments is { Count: > 0 })
            {
                <div class="border-top border-hairline px-3 py-3">
                    <p class="mb-2 fs-11-5 fw-semibold text-ink-3 text-uppercase" style="letter-spacing:.04em">Bukti PI</p>
                    <LampiranThumbs Ids="t.PiAttachments" Ukuran="48" />
                </div>
            }
            @if (!string.IsNullOrEmpty(t.PiNote)) { <p class="m-0 border-top border-hairline px-3 py-2 fs-12 text-ink-3" style="white-space:pre-line">Catatan PI: @t.PiNote</p> }
            @if (t.PiStatus != "") { <p class="m-0 border-top border-hairline px-3 py-2 fs-12 text-ink-3">Catatan lama: @t.PiStatus</p> }
        </Kartu>

        <Kartu>
            <KepalaKartu Title="Komisi" Subtitle="Dihitung otomatis dari Aturan Komisi; pembayarannya dicatat di tab Biaya Internal." />
            <div class="p-3"><dl class="row row-cols-2 g-3 mb-0">
                <InfoItem Label="Supir utama" Value="@Format.Rupiah(Trip.KomisiSopir)" Mono />
                <InfoItem Label="Manager" Value="@(t.ManagerId != "" || t.ManagerName != "" ? Format.Rupiah(Trip.KomisiManager) : "—")" Mono />
            </dl></div>
            <p class="m-0 border-top border-hairline px-3 py-2 fs-12 text-ink-3">@(Trip.KomisiKeterangan != "" ? Trip.KomisiKeterangan : "Belum ada aturan komisi yang cocok.")</p>
        </Kartu>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public BarisTrip Trip { get; set; } = default!;

    private void TandaiFisik()
    {
        Db.TerimaPodFisik(Trip.Id);
        Toast.Sukses($"Dokumen fisik POD Trip {Trip.IdTampil} diterima{(Trip.PlateNumber != "" ? $"; {Trip.PlateNumber} tercatat kembali di pool" : "")}.");
    }
}
