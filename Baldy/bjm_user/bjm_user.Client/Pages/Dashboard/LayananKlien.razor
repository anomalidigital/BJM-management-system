@* Dua cara BJM melayani klien: Callout untuk klien tetap (order per perjalanan) dan Dedicated untuk klien kontrak. *@
@{
    var total = Math.Max(1, CalloutTrip + DedicatedTrip);
    // Dedicated dibayar lewat nilai kontrak, bukan harga per trip.
    var nilaiKontrak = Kontrak.Sum(k => k.Nilai);
    var layanan = new (string Nama, string Ket, int Trip, string Warna, string Catatan)[]
    {
        ("Callout", "klien tetap, order per perjalanan", CalloutTrip, "var(--brand-600)",
            CalloutTrip > 0 ? $"pendapatan {Format.RupiahRingkas(CalloutPendapatan)}" : ""),
        ("Dedicated", "klien kontrak", DedicatedTrip, "var(--nav-700)",
            Kontrak.Count > 0 ? $"pendapatan lewat kontrak, nilai kontrak aktif {Format.RupiahRingkas(nilaiKontrak)}" : ""),
    };
}
<Panel Title="Layanan & klien" Subtitle="Pembagian trip bulan ini dan kontrak yang masih berjalan." Href="master/klien" Tautan="Buka Klien">
    <div class="dash-px d-flex flex-column gap-3">
        @foreach (var l in layanan)
        {
            <div>
                <div class="d-flex align-items-baseline justify-content-between gap-3">
                    <span class="dash-fs-13-5 text-ink">@l.Nama <span class="fs-12 text-ink-3">@l.Ket</span></span>
                    <span class="tnum dash-rail dash-fs-19 lh-1 text-ink">@Format.Angka(l.Trip)<span class="ms-1 fs-12 fw-medium text-ink-3">trip</span></span>
                </div>
                <div class="dash-pita" style="margin-top:.375rem" aria-hidden="true">
                    <div style="width:@Lebar((double)l.Trip / total);background:@l.Warna"></div>
                </div>
                @if (l.Catatan != "") { <span class="tnum d-block mt-1 fs-11-5 text-ink-3">@l.Catatan</span> }
            </div>
        }
    </div>

    <div class="border-top border-hairline dash-px py-3" style="margin-top:1rem">
        <h3 class="m-0 fs-12-5 fw-medium text-ink-2">Kontrak Dedicated berjalan</h3>
        @if (Kontrak.Count == 0)
        {
            <p class="m-0 mt-2 fs-12-5 text-ink-3">Belum ada kontrak berjalan di workspace ini. Kontrak ditambahkan dari halaman klien kontrak.</p>
        }
        else
        {
            <ul class="list-unstyled m-0 d-flex flex-column gap-3" style="margin-top:.625rem !important">
                @foreach (var k in Kontrak.Take(3))
                {
                    <li @key="k.Id">
                        <div class="d-flex align-items-baseline justify-content-between gap-3">
                            <a href="@($"master/klien/{k.KlienId}")" class="dash-tautan-kontrak min-w-0 text-truncate fs-13">
                                <span class="tnum fw-medium">@k.Nomor</span> <span class="text-ink-3">@k.Klien</span>
                            </a>
                            <span class="tnum flex-shrink-0 fs-12-5 text-ink-2">sisa <span class="fw-semibold text-ink">@Format.RupiahRingkas(k.Sisa)</span></span>
                        </div>
                        <div class="dash-pita" style="margin-top:.375rem" aria-hidden="true">
                            <div style="width:@Lebar(Math.Max(0, Math.Min(1, (double)k.Sisa / Math.Max(1, k.Nilai))));background:@(k.Sisa < 0 ? "var(--critical)" : "#1f9d55")"></div>
                        </div>
                        <span class="tnum d-block mt-1 fs-11-5 text-ink-3">dari nilai kontrak @Format.RupiahRingkas(k.Nilai)</span>
                    </li>
                }
            </ul>
        }
    </div>
</Panel>

@code {
    [Parameter] public int CalloutTrip { get; set; }
    [Parameter] public long CalloutPendapatan { get; set; }
    [Parameter] public int DedicatedTrip { get; set; }
    [Parameter] public List<KontrakBerjalan> Kontrak { get; set; } = [];

    private static string Lebar(double v) => (v * 100).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%";
}
