@page "/login"
@page "/"
@layout LayoutKosong
@inherits KomponenData
<PageTitle>Masuk — SIKOTIS</PageTitle>

<div class="login-shell">
    <aside class="login-brand">
        <div class="login-brand-atas d-flex align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="login-logo-mark">S</div>
                <div>
                    <p class="m-0 fs-15 lh-tight fw-semibold text-white">SIKOTIS</p>
                    <p class="m-0 fs-12 lh-tight nav-ink">Sistem Komisi Otomatis</p>
                </div>
            </div>
            <span class="login-koridor-pill">
                <span class="login-titik-aktif"></span>
                PT Bimajaya Mustika
            </span>
        </div>

        <div class="login-brand-tengah my-auto py-4">
            <h1 class="login-judul">Kendali Operasional Armada, Komisi Supir &amp; Tagihan Klien</h1>
            <p class="login-subjudul">
                Satu ruang kerja terpusat untuk memantau perjalanan harian, pencairan uang jalan, Berita Acara,
                hingga penagihan Proforma Invoice di seluruh koridor operasional BJM.
            </p>

            <div class="login-papan" aria-hidden="true">
                <div class="login-papan-kepala">
                    <div class="d-flex align-items-center gap-2">
                        <IkonSvg Def="Ikon.TruckFast" Size="14" Style="color: var(--brand-400)" />
                        <span class="fs-12 fw-semibold text-white">Koridor Operasional Terpadu</span>
                    </div>
                    <div class="d-flex align-items-center gap-3 fs-11 nav-ink">
                        <span class="d-inline-flex align-items-center gap-1"><span class="login-dot" style="background:var(--good)"></span>Selesai</span>
                        <span class="d-inline-flex align-items-center gap-1"><span class="login-dot" style="background:var(--brand-400)"></span>Aktif</span>
                        <span class="d-inline-flex align-items-center gap-1"><span class="login-dot" style="background:var(--signal)"></span>Menunggu</span>
                    </div>
                </div>

                <div class="login-depo-dua">
                    <div class="login-depo-item">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="fs-12 fw-semibold text-white">Depo Karawang</span>
                            <span class="login-tag-depo">Distribusi &amp; BA</span>
                        </div>
                        <p class="m-0 mt-1 fs-11-5 nav-ink">Rute pabrik, multi-drop, uang jalan &amp; Berita Acara</p>
                        <div class="login-lajur-mini mt-2">
                            <span style="width:74%;background:var(--good)"></span>
                            <span style="width:18%;background:var(--brand-400)"></span>
                            <span style="width:8%;background:var(--signal)"></span>
                        </div>
                    </div>
                    <div class="login-depo-item">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="fs-12 fw-semibold text-white">Depo Tanjung Priok</span>
                            <span class="login-tag-depo">Kontainer &amp; SI/JO</span>
                        </div>
                        <p class="m-0 mt-1 fs-11-5 nav-ink">Tarik/muat kontainer pelabuhan, Surat Jalan &amp; kapal</p>
                        <div class="login-lajur-mini mt-2">
                            <span style="width:68%;background:var(--good)"></span>
                            <span style="width:22%;background:var(--brand-400)"></span>
                            <span style="width:10%;background:var(--signal)"></span>
                        </div>
                    </div>
                </div>

                <div class="login-fitur-grid">
                    <div class="login-fitur-item">
                        <span class="login-fitur-ikon"><IkonSvg Def="Ikon.Route" Size="14" /></span>
                        <div>
                            <p class="m-0 fs-12-5 fw-semibold text-white">Master &amp; Harga Rute</p>
                            <p class="m-0 fs-11-5 nav-ink">Data supir, kendaraan, alamat &amp; patokan rute</p>
                        </div>
                    </div>
                    <div class="login-fitur-item">
                        <span class="login-fitur-ikon"><IkonSvg Def="Ikon.Wallet" Size="14" /></span>
                        <div>
                            <p class="m-0 fs-12-5 fw-semibold text-white">Uang Jalan &amp; Kasbon</p>
                            <p class="m-0 fs-11-5 nav-ink">Termin pencairan, potong piutang &amp; nota biaya</p>
                        </div>
                    </div>
                    <div class="login-fitur-item">
                        <span class="login-fitur-ikon"><IkonSvg Def="Ikon.FileInvoiceDollar" Size="14" /></span>
                        <div>
                            <p class="m-0 fs-12-5 fw-semibold text-white">Tagihan Proforma Invoice</p>
                            <p class="m-0 fs-11-5 nav-ink">Pantau tahap PI tercetak, dikirim, hingga lunas</p>
                        </div>
                    </div>
                    <div class="login-fitur-item">
                        <span class="login-fitur-ikon"><IkonSvg Def="Ikon.Print" Size="14" /></span>
                        <div>
                            <p class="m-0 fs-12-5 fw-semibold text-white">Cetak Dokumen &amp; Laporan</p>
                            <p class="m-0 fs-11-5 nav-ink">Berita Acara, Surat Jalan, komisi, ritan &amp; netto</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="login-brand-bawah d-flex align-items-center justify-content-between gap-3 fs-11-5" style="color: rgba(147,161,184,.72)">
            <span>PT Bimajaya Mustika · Version 0.1</span>
            <span>Karawang · Tanjung Priok</span>
        </div>
    </aside>

    <main class="login-form">
        <div class="isi">
            <div class="login-kartu">
                <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom border-hairline">
                    <div class="d-flex align-items-center gap-2">
                        <div class="login-logo-kecil">S</div>
                        <div>
                            <p class="m-0 fs-13 fw-semibold text-ink lh-tight">SIKOTIS</p>
                            <p class="m-0 fs-11 text-ink-3 lh-tight">PT Bimajaya Mustika</p>
                        </div>
                    </div>
                    <span class="badge-nada brand"> Operasional </span>
                </div>

                <h2 class="fs-22 lh-tight fw-semibold text-ink m-0" style="letter-spacing:-.015em">Masuk ke sistem</h2>
                <p class="mt-1 mb-0 fs-13 text-ink-3">Gunakan akun operasional Anda untuk melanjutkan.</p>

                <form class="mt-4 d-flex flex-column gap-3" @onsubmit="Masuk">
                    <div>
                        <label class="form-label" for="login-username">Username<span class="text-danger ms-1">*</span></label>
                        <div class="isian-ikon">
                            <IkonSvg Def="Ikon.User" Size="15" />
                            <input id="login-username" class="form-control login-input" @bind="_username" autocomplete="username" placeholder="Masukkan username" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="login-password">Password<span class="text-danger ms-1">*</span></label>
                        <div class="isian-ikon">
                            <IkonSvg Def="Ikon.Key" Size="15" />
                            <input id="login-password" class="form-control login-input pe-5" type="@(_lihat ? "text" : "password")" @bind="_password" autocomplete="current-password" placeholder="Masukkan password" />
                            <button type="button" class="btn btn-link p-1 text-ink-3 position-absolute top-50 end-0 translate-middle-y me-2"
                                    aria-label="@(_lihat ? "Sembunyikan password" : "Tampilkan password")" title="@(_lihat ? "Sembunyikan password" : "Tampilkan password")" @onclick="() => _lihat = !_lihat">
                                <IkonSvg Def="@(_lihat ? Ikon.EyeSlash : Ikon.Eye)" Size="15" />
                            </button>
                        </div>
                    </div>
                    @if (_galat is not null)
                    {
                        <div role="alert" class="kotak-galat"><IkonSvg Def="Ikon.TriangleExclamation" Size="15" Style="margin-top:1px" /> @_galat</div>
                    }
                    <div class="pt-1">
                        <Tombol Type="submit" Variant="primary" Loading="_memuat" Icon="Ikon.RightToBracket" Class="w-100 justify-content-center login-btn-masuk">Masuk</Tombol>
                    </div>
                </form>

                <div class="mt-4 pt-3 border-top border-hairline d-flex align-items-center justify-content-between fs-11-5 text-ink-3">
                    <span>Sistem Manajemen Transportasi &amp; Komisi</span>
                    <span class="tnum">Version 0.1</span>
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    private string _username = "admin";
    private string _password = "";
    private bool _lihat;
    private bool _memuat;
    private string? _galat;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Sesi.SudahMasuk) Ke("dashboard", true);
    }

    private async Task Masuk()
    {
        _galat = null; _memuat = true;
        try
        {
            await Sesi.MasukAsync(_username, _password);
            Ke("dashboard", true);
        }
        catch (Exception e) { _galat = e.Message; }
        finally { _memuat = false; }
    }
}
