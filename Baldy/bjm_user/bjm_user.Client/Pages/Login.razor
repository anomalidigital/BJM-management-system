@page "/login"
@page "/"
@layout LayoutKosong
@inherits KomponenData
<PageTitle>Masuk — SIKOTIS</PageTitle>

<div class="login-shell">
    <aside class="login-brand">
        <div class="d-flex align-items-center gap-3">
            <div class="w-10 place-center rounded-3 bg-brand fw-bold fs-17">S</div>
            <div>
                <p class="m-0 fs-15 lh-tight fw-semibold">SIKOTIS</p>
                <p class="m-0 fs-12 lh-tight nav-ink">Sistem Komisi Otomatis</p>
            </div>
        </div>
        <div style="max-width: 28rem">
            <h1 class="fs-26 lh-tight fw-semibold" style="font-size:30px; letter-spacing:-.01em">Transportation, Commission &amp; Billing Management System</h1>
            <p class="mt-3 fs-14 nav-ink" style="line-height:1.6">
                Kelola data supir, rute, trip, komisi, dan tagihan PT Bimajaya Mustika dalam satu sistem web terpusat — lengkap dengan
                Berita Acara, laporan bulan berjalan, dan cetak PDF.
            </p>
            <ul class="list-unstyled mt-4 d-flex flex-column gap-2 fs-13 nav-ink">
                @foreach (var f in new[] { "Master data karyawan & rute", "Trip + cetak Berita Acara dengan/tanpa logo", "Tagihan PI per trip sampai lunas", "Laporan komisi, pengeluaran, dan piutang karyawan" })
                {
                    <li class="d-flex align-items-center gap-2"><IkonSvg Def="Ikon.ShieldHalved" Size="15" Style="color: var(--brand-400)" /> @f</li>
                }
            </ul>
        </div>
        <p class="m-0 fs-11-5" style="color: rgba(147,161,184,.6)">PT Bimajaya Mustika · Version 0.2</p>
    </aside>

    <main class="login-form">
        <div class="isi">
            <div class="mb-4 d-lg-none">
                <div class="w-10 place-center rounded-3 bg-brand text-white fw-bold fs-17 mb-2">S</div>
                <p class="m-0 fs-17 fw-semibold text-ink">SIKOTIS</p>
                <p class="m-0 fs-12-5 text-ink-3">PT Bimajaya Mustika</p>
            </div>
            <h2 class="fs-22 lh-tight fw-semibold text-ink" style="letter-spacing:-.01em">Masuk ke sistem</h2>
            <p class="mt-1 fs-13 text-ink-3">Gunakan akun operasional Anda untuk melanjutkan.</p>

            <form class="mt-4 d-flex flex-column gap-3" @onsubmit="Masuk">
                <div>
                    <label class="form-label" for="login-username">Username<span class="text-danger ms-1">*</span></label>
                    <div class="isian-ikon">
                        <IkonSvg Def="Ikon.User" Size="15" />
                        <input id="login-username" class="form-control" @bind="_username" autocomplete="username" />
                    </div>
                </div>
                <div>
                    <label class="form-label" for="login-password">Password<span class="text-danger ms-1">*</span></label>
                    <div class="isian-ikon">
                        <IkonSvg Def="Ikon.Key" Size="15" />
                        <input id="login-password" class="form-control pe-5" type="@(_lihat ? "text" : "password")" @bind="_password" autocomplete="current-password" />
                        <button type="button" class="btn btn-link p-1 text-ink-3 position-absolute top-50 end-0 translate-middle-y me-1"
                                aria-label="@(_lihat ? "Sembunyikan password" : "Tampilkan password")" title="@(_lihat ? "Sembunyikan password" : "Tampilkan password")" @onclick="() => _lihat = !_lihat">
                            <IkonSvg Def="@(_lihat ? Ikon.EyeSlash : Ikon.Eye)" Size="15" />
                        </button>
                    </div>
                </div>
                @if (_galat is not null)
                {
                    <div role="alert" class="kotak-galat"><IkonSvg Def="Ikon.TriangleExclamation" Size="15" Style="margin-top:1px" /> @_galat</div>
                }
                <Tombol Type="submit" Variant="primary" Loading="_memuat" Icon="Ikon.RightToBracket" Class="w-100 justify-content-center" Style="height:40px">Masuk</Tombol>
                <p class="m-0 fs-12 text-ink-3" style="line-height:1.6">
                    Akun uji coba: <span class="fw-medium text-ink-2">owner</span>, <span class="fw-medium text-ink-2">manager</span>,
                    <span class="fw-medium text-ink-2">admin</span>, atau <span class="fw-medium text-ink-2">viewer</span>. Password sementara bebas, minimal 4 karakter.
                </p>
            </form>
        </div>
    </main>
</div>

@code {
    private string _username = "admin";
    private string _password = "";
    private bool _lihat;
    private bool _memuat;
    private string? _galat;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Sesi.SudahMasuk) Ke("dashboard", true);
    }

    private async Task Masuk()
    {
        _galat = null; _memuat = true;
        try
        {
            await Sesi.MasukAsync(_username, _password);
            Ke("dashboard", true);
        }
        catch (Exception e) { _galat = e.Message; }
        finally { _memuat = false; }
    }
}
