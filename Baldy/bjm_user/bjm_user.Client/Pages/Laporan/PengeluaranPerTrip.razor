@* Rekap Pengeluaran → Per Trip: satu baris per trip, apa saja yang dikeluarkan perusahaan untuk trip itu. *@
@inherits KomponenData

@if (Preview)
{
    <ReportPreview OnClose="OnTutupPreview" OrientasiAwal="lanskap">
        @{
            var per = PrintDocument.BarisPerLembar(context, 26);
            var hal = PrintDocument.Bagi(Rows, per);
        }
        <PrintDocument>
            @for (var i = 0; i < hal.Count; i++)
            {
                var ii = i; var isi = hal[ii];
                <PrintPage Page="@(ii + 1)" TotalPages="hal.Count" Title="Rekap Pengeluaran" Subtitle="Per Trip · berdasarkan tanggal berangkat trip" Periode="@PeriodeTeks"
                           Meta="@(new List<(string, string)> { ("Jumlah trip", Format.Angka(Rows.Count)), ("Total keluar", Format.Rupiah(Total.Keluar)), ("Ditagihkan ke klien", Format.Rupiah(Total.Tagih)) })">
                    <PrintTable Cols="KolomCetak">
                        @for (var r = 0; r < isi.Count; r++)
                        {
                            var rr = r; var x = isi[rr];
                            <tr>
                                <td class="p-sel text-end">@(ii * per + rr + 1)</td>
                                <td class="p-sel">@Format.Tanggal(x.R.T.TransactionDate)</td>
                                <td class="p-sel">@x.R.IdTampil</td>
                                <td class="p-sel">@MobilSupir(x.R)</td>
                                <td class="p-sel">@RuteTeks(x.R, "-")</td>
                                <td class="p-sel text-end">@AngkaCetak(x.R.UjTotal)</td>
                                <td class="p-sel text-end">@AngkaCetak(x.R.KasbonTotal)</td>
                                <td class="p-sel text-end">@AngkaCetak(x.BiayaSopir)</td>
                                <td class="p-sel text-end">@AngkaCetak(x.R.BiayaPerusahaan)</td>
                                <td class="p-sel text-end">@AngkaCetak(x.R.InternalTotal)</td>
                                <td class="p-sel text-end fw-semibold">@Format.Angka(x.Keluar)</td>
                                <td class="p-sel text-end">@AngkaCetak(x.R.BiayaDitagihkan)</td>
                            </tr>
                        }
                        @if (ii == hal.Count - 1)
                        {
                            <tr class="total">
                                <td class="p-sel text-end" colspan="5">TOTAL</td>
                                <td class="p-sel text-end">@Format.Angka(Total.Uj)</td>
                                <td class="p-sel text-end">@Format.Angka(Total.Kasbon)</td>
                                <td class="p-sel text-end">@Format.Angka(Total.BiayaSopir)</td>
                                <td class="p-sel text-end">@Format.Angka(Total.Perusahaan)</td>
                                <td class="p-sel text-end">@Format.Angka(Total.Internal)</td>
                                <td class="p-sel text-end">@Format.Angka(Total.Keluar)</td>
                                <td class="p-sel text-end">@Format.Angka(Total.Tagih)</td>
                            </tr>
                        }
                    </PrintTable>
                </PrintPage>
            }
        </PrintDocument>
    </ReportPreview>
}
else
{
    var harian = Harian;
    var adaHarian = harian.Values.Any(v => v > 0);
    <Kartu>
        <header class="card-header">
            <h2 class="card-title d-flex align-items-center gap-2"><IkonSvg Def="Ikon.TruckFast" Size="15" Class="text-brand" />Per Trip</h2>
            <p class="card-subtitle">@($"{Format.Angka(Rows.Count)} trip berangkat pada {PeriodeTeks}. Dihitung dari tanggal berangkat trip.")</p>
        </header>

        <div class="row g-4 m-0 border-bottom border-hairline p-3">
            <div class="col-12 col-lg-6 mt-0">
                <section aria-label="Komposisi pengeluaran">
                    <JudulDiagram Judul="Komposisi pengeluaran" Keterangan="Total keluar = Uang Jalan + Dibayar Perusahaan + Biaya Internal." />
                    @if (Total.Keluar <= 0)
                    {
                        <p class="m-0 py-5 text-center fs-12-5 text-ink-3">Belum ada pengeluaran pada periode ini.</p>
                    }
                    else
                    {
                        var bagian = Bagian;
                        <div class="d-flex overflow-hidden" style="gap:2px;height:14px;border-radius:4px" role="img"
                             aria-label="@LabelKomposisi(bagian)">
                            @foreach (var b in bagian.Where(b => b.Nilai > 0))
                            {
                                <span title="@($"{b.Label}: {Format.Rupiah(b.Nilai)} ({Tulis(b.Nilai)})")" style="@($"width:{LaporanLogika.Css(LaporanLogika.Persen(b.Nilai, Total.Keluar))}%;min-width:3px;background:{b.Warna}")"></span>
                            }
                        </div>
                        <ul class="list-unstyled m-0 mt-3 d-flex flex-column fs-12-5" style="gap:.375rem">
                            @foreach (var b in bagian)
                            {
                                <li class="d-flex align-items-center justify-content-between gap-3">
                                    <span class="d-flex min-w-0 align-items-center gap-2 text-ink-2">
                                        <span class="flex-shrink-0" style="@($"width:10px;height:10px;border-radius:2px;background:{b.Warna}")" aria-hidden="true"></span>
                                        @b.Label
                                    </span>
                                    <span class="tnum flex-shrink-0 text-nowrap text-ink">
                                        <span class="fw-semibold">@Format.Rupiah(b.Nilai)</span>
                                        <span class="ms-2 d-inline-block text-end text-ink-3" style="width:2.25rem">@Tulis(b.Nilai)</span>
                                    </span>
                                </li>
                            }
                            <li class="d-flex align-items-center justify-content-between gap-3 border-top border-hairline fw-semibold text-ink" style="padding-top:.375rem">
                                <span>Total keluar</span>
                                <span class="tnum text-nowrap">@Format.Rupiah(Total.Keluar)<span class="ms-2 d-inline-block" style="width:2.25rem"></span></span>
                            </li>
                        </ul>

                        <div class="mt-3 rounded-2 border border-hairline bg-sunken px-3 py-2">
                            <div class="d-flex flex-wrap align-items-center justify-content-between fs-12-5" style="column-gap:.75rem;row-gap:.25rem">
                                <span class="d-flex align-items-center gap-2 text-ink-2">
                                    <span class="flex-shrink-0" style="@($"width:10px;height:10px;border-radius:2px;background:{LaporanLogika.WarnaTagih}")" aria-hidden="true"></span>
                                    Ditagihkan ke klien
                                </span>
                                <span class="tnum text-nowrap text-ink">
                                    <span class="fw-semibold">@Format.Rupiah(Total.Tagih)</span>
                                    <span class="ms-2 text-ink-3">@Tulis(Total.Tagih) dari total keluar</span>
                                </span>
                            </div>
                            <div class="mt-2 overflow-hidden rounded-pill" style="height:8px;background:var(--grid)" role="img" aria-label="@($"Ditagihkan ke klien {Tulis(Total.Tagih)} dari total keluar")">
                                <span class="d-block h-100 rounded-pill" style="@($"width:{LaporanLogika.Css(Math.Min(100, LaporanLogika.Persen(Total.Tagih, Total.Keluar)))}%;background:{LaporanLogika.WarnaTagih}")"></span>
                            </div>
                            <p class="m-0 mt-2 fs-11-5 text-ink-3" style="line-height:1.35">Biaya di jalan yang ditagih kembali ke klien lewat PI (Additional Cost); sisanya ditanggung perusahaan.</p>
                        </div>
                    }
                </section>
            </div>
            <div class="col-12 col-lg-6 mt-4 mt-lg-0">
                <section aria-label="Grafik total keluar">
                    <JudulDiagram Judul="@(harian.PerBulan ? "Total keluar per bulan" : "Total keluar per hari")" Keterangan="Uang jalan + dibayar perusahaan + biaya internal, menurut tanggal berangkat trip." />
                    @if (adaHarian)
                    {
                        <GrafikGaris Labels="harian.Labels" Series="@(new List<SeriGrafik> { new("Total keluar", LaporanLogika.Ink2, harian.Values) })" Height="190" />
                    }
                    else
                    {
                        <p class="m-0 py-5 text-center fs-12-5 text-ink-3">Belum ada pengeluaran pada periode ini.</p>
                    }
                </section>
            </div>
        </div>

        @if (Rows.Count == 0)
        {
            <p class="m-0 px-3 py-5 text-center fs-13 text-ink-3">Tidak ada trip pada periode tersebut.</p>
        }
        else
        {
            <div class="overflow-auto" style="max-height:480px">
                <table class="table table-hover fs-13 w-100">
                    <thead class="sticky-top">
                        <tr>
                            @for (var i = 0; i < KolomLayar.Length; i++)
                            {
                                <th class="px-3 @(i >= 2 ? "text-end" : "text-start")">@KolomLayar[i]</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in Rows)
                        {
                            var r = x.R;
                            <tr @key="r.Id">
                                <td class="px-3 lh-tight">
                                    <a href="@Tautan(r.Id)" class="tnum fw-semibold text-nowrap text-decoration-none remah" style="color:var(--brand-700)">@r.IdTampil</a>
                                    <span class="tnum d-block fs-12 text-ink-3">@Format.Tanggal(r.T.TransactionDate) · @RuteTeks(r, "—")</span>
                                </td>
                                <td class="px-3 lh-tight text-ink-2">
                                    <span class="tnum d-block text-nowrap">@(r.PlateNumber != "" ? r.PlateNumber : "—")</span>
                                    <span class="d-block fs-12 text-ink-3">@(r.DriverNames != "" ? r.DriverNames : "—")</span>
                                </td>
                                <td class="tnum px-3 text-end text-nowrap text-ink-2">
                                    @if (r.UjTotal != 0) { <text>@Format.Rupiah(r.UjTotal)</text><span class="ms-1 fs-11 text-ink-3">@(r.TerminCount)×</span> } else { <text>—</text> }
                                </td>
                                <td class="tnum px-3 text-end text-nowrap text-ink-3">@AngkaLayar(r.KasbonTotal)</td>
                                <td class="tnum px-3 text-end text-nowrap text-ink-3">@AngkaLayar(x.BiayaSopir)</td>
                                <td class="tnum px-3 text-end text-nowrap text-ink-2">@AngkaLayar(r.BiayaPerusahaan)</td>
                                <td class="tnum px-3 text-end text-nowrap text-ink-2">@AngkaLayar(r.InternalTotal)</td>
                                <td class="tnum px-3 text-end text-nowrap fw-semibold text-ink">@Format.Rupiah(x.Keluar)</td>
                                <td class="tnum px-3 text-end text-nowrap text-ink-2">@AngkaLayar(r.BiayaDitagihkan)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot style="position:sticky;bottom:0">
                        <tr class="fw-semibold text-ink">
                            <td colspan="2" class="px-3 text-nowrap">Total · @Format.Angka(Rows.Count) trip</td>
                            <td class="tnum px-3 text-end text-nowrap">@Format.Rupiah(Total.Uj)<span class="ms-1 fs-11 fw-normal text-ink-3">@(Format.Angka(Total.Termin))×</span></td>
                            <td class="tnum px-3 text-end text-nowrap">@Format.Rupiah(Total.Kasbon)</td>
                            <td class="tnum px-3 text-end text-nowrap">@Format.Rupiah(Total.BiayaSopir)</td>
                            <td class="tnum px-3 text-end text-nowrap">@Format.Rupiah(Total.Perusahaan)</td>
                            <td class="tnum px-3 text-end text-nowrap">@Format.Rupiah(Total.Internal)</td>
                            <td class="tnum px-3 text-end text-nowrap">@Format.Rupiah(Total.Keluar)</td>
                            <td class="tnum px-3 text-end text-nowrap">@Format.Rupiah(Total.Tagih)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <p class="m-0 border-top border-hairline px-3 py-2 fs-12 text-ink-3" style="line-height:1.6">
                Total Keluar = Uang Jalan + Dibayar Perusahaan + Biaya Internal. Potong Kasbon dan Biaya dari Uang Jalan hanya keterangan (sudah termasuk
                di Uang Jalan); angka “×” = jumlah termin. Ditagihkan ke Klien = biaya di jalan yang ditagih kembali lewat PI.
            </p>
        }
    </Kartu>
}

@code {
    [Parameter] public List<BarisPengeluaran> Rows { get; set; } = [];
    [Parameter] public string Awal { get; set; } = "";
    [Parameter] public string Akhir { get; set; } = "";
    [Parameter] public bool Preview { get; set; }
    [Parameter] public EventCallback OnTutupPreview { get; set; }
    [Parameter] public Func<string, string> Tautan { get; set; } = id => $"transaksi/trip/{id}?tab=uj";

    private static readonly string[] KolomLayar = ["Trip", "Kendaraan · Supir", "Uang Jalan", "Potong Kasbon", "Biaya dari Uang Jalan", "Dibayar Perusahaan", "Biaya Internal", "Total Keluar", "Ditagihkan ke Klien"];

    private sealed record Jumlah(long Uj, int Termin, long Kasbon, long BiayaSopir, long Perusahaan, long Internal, long Keluar, long Tagih);
    private sealed record BagianKomposisi(string Kunci, string Label, long Nilai, string Warna);

    private Jumlah Total { get; set; } = new(0, 0, 0, 0, 0, 0, 0, 0);

    protected override void OnParametersSet() => Total = new(
        Rows.Sum(r => r.R.UjTotal), Rows.Sum(r => r.R.TerminCount), Rows.Sum(r => r.R.KasbonTotal), Rows.Sum(r => r.BiayaSopir),
        Rows.Sum(r => r.R.BiayaPerusahaan), Rows.Sum(r => r.R.InternalTotal), Rows.Sum(r => r.Keluar), Rows.Sum(r => r.R.BiayaDitagihkan));

    private string LabelKomposisi(List<BagianKomposisi> bagian) => "Komposisi: " + string.Join(", ", bagian.Select(b => $"{b.Label} {Tulis(b.Nilai)}"));

    private DeretGrafik Harian => LaporanLogika.DeretTanggal(Awal, Akhir, Rows.Select(r => (r.R.T.TransactionDate, r.Keluar)));

    private List<BagianKomposisi> Bagian => [
        new("uj", "Uang Jalan", Total.Uj, LaporanLogika.Seri1),
        new("perusahaan", "Dibayar Perusahaan", Total.Perusahaan, LaporanLogika.Seri2),
        new("internal", "Biaya Internal", Total.Internal, LaporanLogika.Seri3),
    ];

    private string PeriodeTeks => $"{Format.Tanggal(Awal)} s/d {Format.Tanggal(Akhir)}";
    private string Tulis(long n) => LaporanLogika.TulisPersen(n, Total.Keluar);
    private static string AngkaLayar(long n) => n != 0 ? Format.Rupiah(n) : "—";
    private static string AngkaCetak(long n) => n != 0 ? Format.Angka(n) : "-";
    private static string RuteTeks(BarisTrip r, string kosong) => r.RouteName != "" ? r.RouteName : r.T.DestinationDetail != "" ? r.T.DestinationDetail : kosong;
    private static string MobilSupir(BarisTrip r)
    {
        var s = string.Join(" / ", new[] { r.PlateNumber, r.DriverNames }.Where(x => x != ""));
        return s != "" ? s : "-";
    }

    private List<(string, string, string?)> KolomCetak => [
        ("No.", "right", "4%"), ("Tanggal", "left", "8%"), ("ID Trip", "left", Karawang ? "11%" : "9%"),
        ("Kendaraan / Supir", "left", "12%"), ("Rute", "left", null),
        ("Uang Jalan", "right", null), ("Potong Kasbon", "right", null), ("Biaya dari Uang Jalan", "right", null),
        ("Dibayar Perusahaan", "right", null), ("Internal", "right", null), ("Total Keluar", "right", null), ("Ditagihkan", "right", null),
    ];
}
