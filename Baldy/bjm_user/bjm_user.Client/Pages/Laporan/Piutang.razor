    /* ── Tambah / Ubah transaksi ── */

    private void PilihKaryawanForm(string? v) { if (_form is null) return; _form.Karyawan = v ?? ""; _galatForm.Remove("karyawan"); }
    private void UbahJumlahForm(long v) { if (_form is null) return; _form.Jumlah = v; _galatForm.Remove("jumlah"); }

    private void BukaTambah() { _editing = null; _galatForm.Clear(); _form = new FormTransaksi(); }

    private void BukaUbah(MutasiKasbon e)
    {
        _editing = e; _galatForm.Clear();
        _form = new FormTransaksi { Karyawan = e.EmployeeId, Jenis = Kasbon.JenisPiutang(e), Jumlah = Math.Abs(e.Amount), Tanggal = e.EntryDate, Catatan = e.Notes, Bukti = [.. e.Attachments] };
    }

    /// <summary>Saldo karyawan terpilih (sisi karyawan) tanpa transaksi yang sedang diubah, dan sesudah disimpan.</summary>
    private long SaldoSebelum => _form is null || _form.Karyawan == "" ? 0
        : Kasbon.SisiKaryawan(Db.SaldoKasbon.GetValueOrDefault(_form.Karyawan)) - (_editing is not null ? Kasbon.SisiKaryawan(_editing.Amount) : 0);
    private long SaldoSesudah => _form is null ? 0 : SaldoSebelum + (_form.Jenis == JenisPiutang ? -_form.Jumlah : _form.Jumlah);

    private void SimpanForm()
    {
        if (_form is null) return;
        var f = _form;
        _galatForm.Clear();
        if (f.Karyawan == "") _galatForm["karyawan"] = "Pilih karyawan.";
        if (f.Jumlah <= 0) _galatForm["jumlah"] = "Jumlah harus lebih dari 0.";
        if (f.Tanggal == "") _galatForm["tanggal"] = "Tanggal wajib diisi.";
        // Pelunasan tidak boleh melebihi piutang: saldo karyawan tidak boleh menjadi plus.
        if (!_galatForm.ContainsKey("jumlah") && f.Jenis == JenisLunas && SaldoSesudah > 0)
            _galatForm["jumlah"] = SaldoSebelum < 0 ? $"Pelunasan melebihi sisa piutang ({Format.Rupiah(-SaldoSebelum)})." : "Karyawan ini tidak punya piutang untuk dilunasi.";
        if (_galatForm.Count > 0) return;

        // Sumber: Piutang = kasbon, Lunas = pelunasan langsung. Jenis lama (penyesuaian) tetap jenisnya.
        var kind = _editing?.Kind == JenisKasbon.Manual ? JenisKasbon.Manual : f.Jenis == JenisPiutang ? JenisKasbon.Admin : JenisKasbon.Lunas;
        var amount = f.Jenis == JenisPiutang ? f.Jumlah : -f.Jumlah;
        var nama = Db.Semua.Karyawan.FirstOrDefault(d => d.Id == f.Karyawan)?.DriverName ?? "karyawan";
        if (_editing is not null)
        {
            Db.Ubah<MutasiKasbon>(_editing.Id, e => { e.EmployeeId = f.Karyawan; e.EntryDate = f.Tanggal; e.Kind = kind; e.Amount = amount; e.Notes = f.Catatan.Trim(); e.Attachments = [.. f.Bukti]; });
            Toast.Sukses("Transaksi berhasil diperbarui.");
        }
        else
        {
            Db.Buat(new MutasiKasbon { EmployeeId = f.Karyawan, EntryDate = f.Tanggal, Kind = kind, Amount = amount, Notes = f.Catatan.Trim(), Attachments = [.. f.Bukti], TripId = "", UjPaymentId = "" });
            Toast.Sukses($"{LabelJenisPiutang(f.Jenis)} {Format.Rupiah(f.Jumlah)} untuk {nama} tersimpan.");
        }
        _form = null;
    }

    private string PesanHapus => _menghapus is null ? "" : $"{LabelJenisPiutang(Kasbon.JenisPiutang(_menghapus))} senilai {Format.Rupiah(Math.Abs(_menghapus.Amount))} akan dihapus dan saldo karyawan ikut menyesuaikan.";

    private void HapusMutasi()
    {
        if (_menghapus is null) return;
        var s = Kasbon.SisiKaryawan(Db.SaldoKasbon.GetValueOrDefault(_menghapus.EmployeeId)) - Kasbon.SisiKaryawan(_menghapus.Amount);
        if (s > 0)
        {
            Toast.Galat($"Tidak bisa dihapus: piutang ini sudah dilunasi, saldo karyawan akan menjadi lebih bayar {Format.Rupiah(s)}.");
            _menghapus = null;
            return;
        }
        // Berkas bukti dibersihkan otomatis saat aplikasi dimuat (sudah tidak dirujuk record mana pun).
        Db.Hapus<MutasiKasbon>(_menghapus.Id);
        Toast.Sukses("Transaksi berhasil dihapus.");
        _menghapus = null;
    }

    /* ── Cetak & export ── */

    private bool CekSiap()
    {
        if (PeriodeSalah) { _galat = "Tanggal awal tidak boleh lebih besar dari tanggal akhir."; return false; }
        if (_rows.Count == 0)
        {
            _galat = "Tidak ada karyawan yang cocok dengan periode dan filter ini.";
            Toast.Info("Tidak ada data untuk ditampilkan.");
            return false;
        }
        _galat = null;
        return true;
    }

    private void BukaCetak() { if (CekSiap()) _preview = true; }

    private async Task ExportCsv()
    {
        if (!CekSiap()) return;
        static string Sel(object v) => $"\"{v.ToString()!.Replace("\"", "\"\"")}\"";
        var kolom = new[] { "No.", "Kode", "Nama", "Peran", "Saldo Awal", "Piutang", "Lunas", "Saldo Akhir", "Keterangan" };
        var baris = _rows.Select((r, i) => string.Join(';', new object[]
        {
            i + 1, r.Kode, r.Nama, r.Peran, r.Awal, r.Piutang, r.Lunas, r.Akhir,
            string.Join("; ", new[] { !r.Terdaftar ? "Karyawan sudah dihapus" : "", r.Nonaktif ? "Nonaktif" : "", r.LebihBayar != "" ? $"Pernah lebih bayar sejak {Format.Tanggal(r.LebihBayar)}" : "" }.Where(x => x != "")),
        }.Select(Sel)));
        var jumlah = string.Join(';', new object[] { "", "", $"Total {_rows.Count} karyawan", "", _total.Awal, _total.Piutang, _total.Lunas, _total.Akhir, "" }.Select(Sel));
        // BOM supaya Excel membaca huruf dengan benar; pemisah titik koma untuk Excel berbahasa Indonesia.
        var isi = "﻿" + string.Join("\r\n", new[] { string.Join(';', kolom.Select(Sel)) }.Concat(baris).Append(jumlah));
        await Simpan.UnduhAsync($"piutang-karyawan-{AwalBerlaku}-sd-{AkhirBerlaku}.csv", isi, "text/csv;charset=utf-8");
        Toast.Sukses($"{_rows.Count} karyawan diexport ({PeriodeTeks}).");
    }
