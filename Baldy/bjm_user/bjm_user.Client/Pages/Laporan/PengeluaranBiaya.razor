@* Rekap Pengeluaran → Biaya Operasional: nota DEX, tol, SPSI Banlok, overnight, dan biaya lain per trip (padanan LapBiayaPage tertanam). *@
@inherits KomponenData

@if (Preview)
{
    <ReportPreview OnClose="OnTutupPreview">
        @{
            var per = PrintDocument.BarisPerLembar(context, 24);
            var hal = PrintDocument.Bagi(_rows, per);
        }
        <PrintDocument>
            @for (var i = 0; i < hal.Count; i++)
            {
                var ii = i; var isi = hal[ii];
                <PrintPage Page="@(ii + 1)" TotalPages="hal.Count" Title="Rekap Biaya Operasional" Subtitle="@SubjudulCetak" Periode="@PeriodeTeks"
                           Meta="@(new List<(string, string)> { ("Jumlah nota", Format.Angka(_rows.Count)), ("Total biaya", Format.Rupiah(_total.Nominal)), ("Ditagihkan ke klien", Format.Rupiah(_total.Tagih)) })">
                    <PrintTable Cols="KolomCetak">
                        @for (var r = 0; r < isi.Count; r++)
                        {
                            var rr = r; var e = isi[rr];
                            <tr>
                                <td class="p-sel text-end">@(ii * per + rr + 1)</td>
                                <td class="p-sel">@Format.Tanggal(e.E.ExpenseDate)</td>
                                <td class="p-sel">@e.Trip.IdTampil</td>
                                <td class="p-sel">@(e.Trip.DriverNames != "" ? e.Trip.DriverNames : "-")</td>
                                <td class="p-sel">@(e.Trip.PlateNumber != "" ? e.Trip.PlateNumber : "-")</td>
                                <td class="p-sel">@JenisBiaya.Label(e.E.ExpenseType)</td>
                                <td class="p-sel text-center">@(e.Ditagih ? "Ya" : "-")</td>
                                <td class="p-sel text-end fw-semibold">@Format.Angka(e.E.Amount)</td>
                            </tr>
                        }
                        @if (ii == hal.Count - 1)
                        {
                            <tr class="total">
                                <td class="p-sel text-end" colspan="7">TOTAL</td>
                                <td class="p-sel text-end">@Format.Angka(_total.Nominal)</td>
                            </tr>
                            @if (_total.Dorong > 0)
                            {
                                <tr class="grup">
                                    <td class="p-sel" colspan="7">Uang Dorong (dari Uang Jalan, @_dorong.Count termin) — tidak termasuk total</td>
                                    <td class="p-sel text-end">@Format.Angka(_total.Dorong)</td>
                                </tr>
                            }
                        }
                    </PrintTable>
                </PrintPage>
            }
        </PrintDocument>
    </ReportPreview>
}
else
{
    var sisa = Math.Max(0, _total.Nominal - _total.Tagih);
    <Kartu>
        <header class="card-header">
            <h2 class="card-title d-flex align-items-center gap-2"><IkonSvg Def="Ikon.Receipt" Size="15" Class="text-brand" />Biaya Operasional</h2>
            <p class="card-subtitle">@($"{Format.Angka(_rows.Count)} nota{JenisTeks} pada {PeriodeTeks}. Dihitung dari tanggal nota.")</p>
        </header>

        <div class="row g-4 m-0 border-bottom border-hairline p-3">
            <div class="col-12 col-lg-6 mt-0">
                <section aria-label="Biaya per jenis">
                    <JudulDiagram Judul="Biaya per jenis (Rp)" Keterangan="Tiap jenis diberi tanda apakah ikut ditagihkan ke klien lewat PI." />
                    @if (_perJenis.Count > 0)
                    {
                        <BatangPeringkat Rows="@(_perJenis.Select(r => new BarisPeringkat(r.Kode, JenisBiaya.Label(r.Kode), $"{r.N} nota · {LaporanLogika.PenandaTagih(r.Nominal, r.Tagih)}", r.Nominal)).ToList())" />
                    }
                    else
                    {
                        <p class="m-0 py-5 text-center fs-12-5 text-ink-3">Tidak ada biaya pada periode tersebut.</p>
                    }
                    @if (_total.Dorong > 0)
                    {
                        <p class="m-0 mt-3 d-flex flex-wrap align-items-center rounded-2 border border-hairline bg-sunken px-3 py-2 fs-12-5 text-ink-2" style="column-gap:.5rem;row-gap:.25rem">
                            <span class="fw-medium text-ink">Uang Dorong</span>
                            <Badge>dari Uang Jalan</Badge>
                            <span class="tnum">@Format.Rupiah(_total.Dorong) · @_dorong.Count termin</span>
                            <span class="text-ink-3">Hanya keterangan: dicatat di Uang Jalan, tidak ikut dijumlah atau ditagihkan.</span>
                        </p>
                    }
                </section>
            </div>

            <div class="col-12 col-lg-6 mt-4 mt-lg-0">
                <section aria-label="Biaya yang ditagihkan ke klien">
                    <JudulDiagram Judul="Ditagihkan ke klien" Keterangan="Bagian biaya yang ditagih kembali ke klien sebagai Additional Cost di PI." />
                    @if (_total.Nominal > 0)
                    {
                        <div class="d-flex overflow-hidden" style="gap:2px;height:14px;border-radius:4px" role="img" aria-label="@LabelTagih(sisa)">
                            @if (_total.Tagih > 0)
                            {
                                <span title="@($"Ditagihkan ke klien: {Format.Rupiah(_total.Tagih)}")" style="@($"width:{LaporanLogika.Css(LaporanLogika.Persen(_total.Tagih, _total.Nominal))}%;min-width:3px;background:{LaporanLogika.WarnaTagih}")"></span>
                            }
                            @if (sisa > 0)
                            {
                                <span title="@($"Tidak ditagihkan: {Format.Rupiah(sisa)}")" style="@($"width:{LaporanLogika.Css(LaporanLogika.Persen(sisa, _total.Nominal))}%;min-width:3px;background:{LaporanLogika.WarnaSisa}")"></span>
                            }
                        </div>
                        <ul class="list-unstyled m-0 mt-3 d-flex flex-column fs-12-5" style="gap:.375rem">
                            @foreach (var (label, nilai, warna) in new[] { ("Ditagihkan ke klien", _total.Tagih, LaporanLogika.WarnaTagih), ("Tidak ditagihkan (ditanggung perusahaan)", sisa, LaporanLogika.WarnaSisa) })
                            {
                                <li class="d-flex align-items-center justify-content-between gap-3">
                                    <span class="d-flex min-w-0 align-items-center gap-2 text-ink-2">
                                        <span class="flex-shrink-0" style="@($"width:10px;height:10px;border-radius:2px;background:{warna}")" aria-hidden="true"></span>
                                        @label
                                    </span>
                                    <span class="tnum flex-shrink-0 text-nowrap text-ink">
                                        <span class="fw-semibold">@Format.Rupiah(nilai)</span>
                                        <span class="ms-2 text-ink-3">@LaporanLogika.TulisPersen(nilai, _total.Nominal)</span>
                                    </span>
                                </li>
                            }
                        </ul>
                        <div class="mt-3 border-top border-hairline pt-3">
                            <RumusAngka Suku="@(new List<SukuRumus> { new("Dibayar supir (dari uang jalan)", _total.Nominal - _total.Perusahaan), new("Dibayar perusahaan", _total.Perusahaan, "+"), new("Total biaya", _total.Nominal, "=", true) })" />
                        </div>
                    }
                    else
                    {
                        <p class="m-0 py-5 text-center fs-12-5 text-ink-3">Belum ada biaya pada periode ini.</p>
                    }
                </section>
            </div>
        </div>

        @if (_rows.Count == 0 && _dorong.Count == 0)
        {
            <p class="m-0 px-3 py-5 text-center fs-13 text-ink-3">Tidak ada biaya pada periode tersebut.</p>
        }
        else
        {
            <div class="overflow-auto" style="max-height:480px">
                <table class="table table-hover fs-13 w-100">
                    <thead class="sticky-top">
                        <tr>
                            @foreach (var (h, i) in new[] { "Tanggal", "Trip", "Kendaraan · Supir", "Jenis", "Dibayar oleh", "Ditagihkan", "Nominal" }.Select((h, i) => (h, i)))
                            {
                                <th class="px-3 @(i == 6 ? "text-end" : "text-start")">@h</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in _rows)
                        {
                            <tr @key="e.E.Id">
                                <td class="tnum px-3 text-nowrap text-ink-2">@Format.Tanggal(e.E.ExpenseDate)</td>
                                <td class="px-3"><a href="@Tautan(e.E.TripId)" class="tnum fw-semibold text-nowrap text-decoration-none remah" style="color:var(--brand-700)">@e.Trip.IdTampil</a></td>
                                <td class="px-3 lh-tight text-ink-2">
                                    <span class="tnum d-block text-nowrap">@(e.Trip.PlateNumber != "" ? e.Trip.PlateNumber : "—")</span>
                                    <span class="d-block fs-12 text-ink-3">@(e.Trip.DriverNames != "" ? e.Trip.DriverNames : "—")</span>
                                </td>
                                <td class="px-3 text-nowrap text-ink">@JenisBiaya.Label(e.E.ExpenseType)</td>
                                <td class="px-3 text-nowrap text-ink-2">@(e.OlehPerusahaan ? "Perusahaan" : "Supir (dari uang jalan)")</td>
                                <td class="px-3">@if (e.Ditagih) { <Badge Tone="good">Ke klien</Badge> } else { <span class="text-ink-3">—</span> }</td>
                                <td class="tnum px-3 text-end text-nowrap fw-semibold text-ink">@Format.Rupiah(e.E.Amount)</td>
                            </tr>
                        }
                        @if (_dorong.Count > 0)
                        {
                            <tr>
                                <td colspan="7" class="bg-sunken px-3 pt-2 pb-1 fs-11-5 fw-semibold text-uppercase text-ink-3" style="letter-spacing:.04em">
                                    Dari Uang Jalan · hanya keterangan, tidak ikut total
                                </td>
                            </tr>
                        }
                        @foreach (var (p, trip) in _dorong)
                        {
                            <tr @key="p.Id" class="text-ink-3">
                                <td class="tnum px-3 text-nowrap text-ink-3">@Format.Tanggal(p.PaymentDate)</td>
                                <td class="px-3"><a href="@Tautan(p.TripId)" class="tnum fw-semibold text-nowrap text-decoration-none remah" style="color:var(--brand-700)">@trip.IdTampil</a></td>
                                <td class="px-3 lh-tight text-ink-3">
                                    <span class="tnum d-block text-nowrap">@(trip.PlateNumber != "" ? trip.PlateNumber : "—")</span>
                                    <span class="d-block fs-12">@(trip.DriverNames != "" ? trip.DriverNames : "—")</span>
                                </td>
                                <td class="px-3 text-nowrap text-ink-3">Uang Dorong <Badge Class="ms-1">dari Uang Jalan</Badge></td>
                                <td class="px-3 text-nowrap text-ink-3">Termin ke-@p.Sequence</td>
                                <td class="px-3 text-ink-3">—</td>
                                <td class="tnum px-3 text-end text-nowrap text-ink-3">@Format.Rupiah(p.UjAmount)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot style="position:sticky;bottom:0">
                        <tr class="fw-semibold text-ink">
                            <td class="px-3 text-nowrap" colspan="5">@($"Total · {Format.Angka(_rows.Count)} nota{JenisTeks}")</td>
                            <td class="tnum px-3 text-nowrap">@Format.Rupiah(_total.Tagih)</td>
                            <td class="tnum px-3 text-end text-nowrap">@Format.Rupiah(_total.Nominal)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </Kartu>
}

@code {
    /// <summary>Seluruh nota periode (belum disaring jenis).</summary>
    [Parameter] public List<NotaTrip> Nota { get; set; } = [];
    [Parameter] public List<(TerminUj P, BarisTrip Trip)> Dorong { get; set; } = [];
    [Parameter] public string Awal { get; set; } = "";
    [Parameter] public string Akhir { get; set; } = "";
    /// <summary>Jenis biaya terpilih ("" = semua).</summary>
    [Parameter] public string Jenis { get; set; } = "";
    [Parameter] public bool Preview { get; set; }
    [Parameter] public EventCallback OnTutupPreview { get; set; }
    [Parameter] public Func<string, string> Tautan { get; set; } = id => $"transaksi/trip/{id}?tab=biaya";

    private sealed record Jumlah(long Nominal, long Tagih, long Perusahaan, long Dorong);
    private sealed record RekapJenis(string Kode, int N, long Nominal, long Tagih);

    private List<NotaTrip> _rows = [];
    private List<(TerminUj P, BarisTrip Trip)> _dorong = [];
    private Jumlah _total = new(0, 0, 0, 0);
    private List<RekapJenis> _perJenis = [];

    protected override void OnParametersSet()
    {
        _rows = Jenis != "" ? Nota.Where(e => e.E.ExpenseType == Jenis).ToList() : Nota;
        // Uang dorong bukan jenis biaya: hanya tampil saat semua jenis ditampilkan.
        _dorong = Jenis != "" ? [] : Dorong;
        _total = new(_rows.Sum(e => e.E.Amount), _rows.Where(e => e.Ditagih).Sum(e => e.E.Amount), _rows.Where(e => e.OlehPerusahaan).Sum(e => e.E.Amount), _dorong.Sum(p => p.P.UjAmount));
        _perJenis = _rows.GroupBy(e => e.E.ExpenseType)
            .Select(g => new RekapJenis(g.Key, g.Count(), g.Sum(e => e.E.Amount), g.Where(e => e.Ditagih).Sum(e => e.E.Amount)))
            .OrderByDescending(r => r.Nominal).ToList();
    }

    private string PeriodeTeks => $"{Format.Tanggal(Awal)} s/d {Format.Tanggal(Akhir)}";
    private string JenisTeks => Jenis != "" ? $" jenis {JenisBiaya.Label(Jenis)}" : "";
    private string SubjudulCetak => $"{(Jenis != "" ? $"Jenis biaya: {JenisBiaya.Label(Jenis)}" : "Seluruh jenis biaya")} · berdasarkan tanggal nota";
    private string LabelTagih(long sisa) => $"Ditagihkan ke klien {LaporanLogika.TulisPersen(_total.Tagih, _total.Nominal)}, tidak ditagihkan {LaporanLogika.TulisPersen(sisa, _total.Nominal)}";

    private List<(string, string, string?)> KolomCetak => [
        ("No.", "right", "5%"), ("Tanggal", "left", "10%"), ("ID Trip", "left", Karawang ? "19%" : "12%"), ("Supir", "left", null),
        ("No. Kendaraan", "left", "11%"), ("Jenis Biaya", "left", "13%"), ("Ditagihkan", "center", "9%"), ("Nominal (Rp)", "right", "13%"),
    ];
}
