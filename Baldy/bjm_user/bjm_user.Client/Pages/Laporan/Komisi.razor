@page "/laporan/komisi"
@inherits KomponenData
@*
    Laporan → Komisi: laporan komisi supir dan aturan tarifnya di satu tempat. Tab Laporan = cetak komisi per periode;
    tab Aturan = aturan komisi yang dipakai menghitung komisi setiap trip (dulu menu Master Data → Aturan Komisi).
    Tab dibaca langsung dari alamat, supaya tautan ?tab=aturan dan klik menu Komisi selalu cocok dengan isinya.
*@
<PageTitle>Komisi — BJM Logistik</PageTitle>

<PageHeader Title="Komisi" Crumbs="@(new List<Crumb> { new("Laporan"), new("Komisi") })">
    <Description>Perhitungan otomatis komisi berdasarkan formula pengaturan.</Description>
</PageHeader>
<Kartu Class="mb-4">
    <Tabs Class="px-2" Items="@(new List<TabItem> { new("laporan", "Laporan"), new("aturan", "Aturan") })" Value="@TabAktif" ValueChanged="GantiTab" />
</Kartu>
@if (TabAktif == "laporan")
{
    <KomisiLaporan />
}
else
{
    <KomisiAturan />
}

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? QTab { get; set; }

    private string TabAktif => QTab == "aturan" ? "aturan" : "laporan";

    private void GantiTab(string t) => Nav.NavigateTo(Nav.GetUriWithQueryParameter("tab", t == "laporan" ? null : t), replace: true);
}
