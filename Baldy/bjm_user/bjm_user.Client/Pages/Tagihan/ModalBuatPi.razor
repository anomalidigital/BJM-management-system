@* Buat PI untuk trip terpilih: nomor berurutan mengikuti format Summary Submission PI. *@

<Modal Open="true" Title="@($"Buat PI untuk {Rows.Count} trip")" Size="md" OnClose="OnClose"
       Subtitle="Satu PI per trip. Nomor terisi otomatis dan boleh diganti. Harga Jual dan biaya yang ditagihkan dibekukan saat PI dibuat.">
    <ChildContent>
        <div class="d-flex flex-column gap-3">
            <Field Label="Tanggal PI" Required>
                <TanggalInput Id="@context" Value="@_tanggal" ValueChanged="v => _tanggal = v" />
            </Field>
            <ul class="list-unstyled m-0 overflow-y-auto rounded-3 border border-hairline" style="max-height:18rem">
                @for (var i = 0; i < Rows.Count; i++)
                {
                    var ii = i; var t = Rows[ii];
                    <li class="px-3 py-2" style="@(ii > 0 ? "border-top:1px solid var(--grid)" : null)">
                        <div class="row g-2 align-items-center">
                            <div class="col-sm min-w-0 fs-12-5">
                                <p class="m-0 tnum text-truncate fw-semibold text-ink">@t.R.IdTampil · @(t.R.PlateNumber != "" ? t.R.PlateNumber : "tanpa kendaraan")</p>
                                <p class="m-0 text-truncate text-ink-3">@(t.R.TrList.Count > 0 ? string.Join(", ", t.R.TrList) : "tanpa No Referensi") · @Format.Rupiah(t.NilaiTotal)</p>
                            </div>
                            <div class="col-sm-auto">
                                <input class="form-control tnum" style="width:15rem;max-width:100%" aria-label="@($"Nomor PI trip {t.R.IdTampil}")"
                                       value="@Usulan(t, ii)" @oninput="e => _nomor[t.Id] = e.Value?.ToString() ?? string.Empty" />
                            </div>
                        </div>
                    </li>
                }
            </ul>
            <Field Label="Bukti PI">
                <Hint>@(Rows.Count > 1 ? "Scan / PDF PI. Dilampirkan ke semua trip yang dipilih." : "Scan / PDF PI yang dicetak.")</Hint>
                <ChildContent><LampiranInput Id="@context" Label="Tambah bukti" Value="_bukti" ValueChanged="v => _bukti = v" /></ChildContent>
            </Field>
            @if (_galat is not null) { <p class="invalid-feedback fs-12 m-0" role="alert">@_galat</p> }
        </div>
    </ChildContent>
    <Footer>
        <Tombol OnClick="OnClose">Batal</Tombol>
        <Tombol Variant="primary" OnClick="Simpan">Buat PI</Tombol>
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public List<BarisPi> Rows { get; set; } = [];
    [Parameter] public List<string> NomorAda { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(List<IsiPi> Isi, List<string> Bukti)> OnSimpan { get; set; }

    private string _tanggal = Format.HariIni();
    private readonly Dictionary<string, string> _nomor = [];
    private List<string> _bukti = [];
    private string? _galat;

    private string Usulan(BarisPi t, int i) => _nomor.TryGetValue(t.Id, out var n) ? n : TripLogika.NomorPiBerikut(NomorAda, t.R.ProjectCode, _tanggal, i);

    private async Task Simpan()
    {
        var isi = Rows.Select((t, i) => new IsiPi(t.Id, Usulan(t, i).Trim(), _tanggal)).ToList();
        if (_tanggal == "") { _galat = "Tanggal PI wajib diisi."; return; }
        if (isi.Any(x => x.Nomor == "")) { _galat = "Nomor PI tidak boleh kosong."; return; }
        var semua = NomorAda.Concat(isi.Select(x => x.Nomor)).Select(x => x.ToUpperInvariant()).ToList();
        if (semua.Distinct().Count() < semua.Count) { _galat = "Ada nomor PI yang sama dengan PI lain."; return; }
        _galat = null;
        await OnSimpan.InvokeAsync((isi, _bukti));
    }
}
