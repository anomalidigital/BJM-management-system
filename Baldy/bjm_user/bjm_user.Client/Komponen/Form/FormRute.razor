@* Modal Tambah / Ubah Rute, dipakai menu Rute dan form trip (tambah rute di tempat). Revisi Baldy 22 Okt 2026 (arahan Pak Stef):
   isian Area Pick Up / Area Destinasi dihapus, diganti Catatan besar di bawah Nama Rute. Area rute mengikuti Nama Rute ("CIB - DURI").
   No. Rute terisi otomatis dari Nama Rute dengan ikon generate seperti kode di form master lain; setelah tersimpan No. Rute tetap.
   Penjelasan isian memakai ikon "?" (Info). Klien dipilih di form trip. *@
@using System.Text.RegularExpressions
@inherits KomponenData

<Modal Open="@Open" Size="lg" Title="@(_editing is not null ? "Ubah Rute" : "Tambah Rute")" Subtitle="@Keterangan" OnClose="Tutup">
    <ChildContent>
        @if (Open)
        {
            var kembar = Kembar;
            <div class="row g-3">
                <Field Label="Nama Rute" Required Error="@G("nama")" Hint="@HintKembar(kembar)" Class="col-sm-8"
                       Info="Pick up - destinasi, mis. CIB - DURI. Boleh ditambah nomor site atau BCKLD, mis. CIB - RAWA 52.">
                    <input id="@context" class="form-control text-uppercase @(G("nama") is not null ? "is-invalid" : "")" value="@_nama" placeholder="CIB - DURI" @oninput="UbahNama" />
                </Field>
                <Field Label="No. Rute" Required="@(_editing is null)" Error="@G("kode")" Class="col-sm-4"
                       Info="@(_editing is not null ? $"No. Rute tetap setelah tersimpan.{(_editing.RouteCodeLama is not null ? $" Dulu {_editing.RouteCodeLama}." : "")}" : "Terisi otomatis dari Nama Rute. Ikon di sampingnya membuat ulang kode.")">
                    <KodeInput Id="@context" Value="@KodeTampil" ReadOnly="@(_editing is not null)" Invalid="@(G("kode") is not null)" Uppercase Placeholder="Otomatis"
                               GenerateTitle="Buat No. Rute dari Nama Rute" ValueChanged="UbahKode" OnGenerate="GenerateKode" />
                </Field>
                <Field Label="Catatan" Class="col-12" Info="Catatan bebas rute, mis. jalur yang dipakai, lokasi bongkar, atau kontak di lapangan.">
                    <textarea id="@context" class="form-control" rows="4" placeholder="Catatan rute" @oninput="e => _catatan = e.Value?.ToString() ?? string.Empty">@_catatan</textarea>
                </Field>
                @if (PakaiFeet)
                {
                    <Field Label="Feet" Required="FeetWajib" Error="@G("feet")" Class="col-sm-3" Info="Ukuran container rute ini."
                           Hint="@Teks(_feet == "" && G("feet") is null ? "Data asli belum mencatat ukuran container rute ini." : null)">
                        <Pilihan Id="@context" Options="OpsiFeet" Value="@_feet" ValueChanged="@(v => { _feet = v ?? ""; _galat.Remove("feet"); })" Invalid="@(G("feet") is not null)" Cari="false" Clearable="false" />
                    </Field>
                }
                <Field Label="Uang Jalan Rute" Required Error="@G("uj")" Class="@KolomNilai" Info="Patokan uang jalan untuk satu trip di rute ini." Hint="@Kira("ujroute")">
                    <UangInput Id="@context" Value="_uj" ValueChanged="@(v => { _uj = v; _galat.Remove("uj"); })" Invalid="@(G("uj") is not null)" />
                </Field>
                <Field Label="Uang Tol" Error="@G("tol")" Class="@KolomNilai" Info="Patokan biaya tol satu trip." Hint="@Kira("toll")">
                    <UangInput Id="@context" Value="_tol" ValueChanged="@(v => { _tol = v; _galat.Remove("tol"); })" Invalid="@(G("tol") is not null)" />
                </Field>
                <Field Label="Harga Jual" Required="HargaWajib" Error="@G("harga")" Class="@KolomNilai" Hint="@Kira("price")"
                       Info="@(_editing is not null ? "Harga ke klien per trip. Harga Jual baru berlaku untuk trip berikutnya; trip yang sudah ada tetap." : "Harga ke klien per trip.")">
                    <UangInput Id="@context" Value="_harga" ValueChanged="@(v => { _harga = v; _galat.Remove("harga"); })" Invalid="@(G("harga") is not null)" />
                </Field>
            </div>
        }
    </ChildContent>
    <Footer>
        <Tombol OnClick="Tutup">Batal</Tombol>
        <Tombol Variant="primary" OnClick="SimpanRute">@(_editing is not null ? "Simpan Perubahan" : "Simpan")</Tombol>
    </Footer>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    /// <summary>Rute yang diubah; null = tambah rute baru.</summary>
    [Parameter] public Rute? Rute { get; set; }
    /// <summary>Awal Nama Rute baru (pick up), mis. destinasi trip asal backload: terisi "ASAL - ".</summary>
    [Parameter] public string? KodeAreaAsalAwal { get; set; }
    /// <summary>Keterangan singkat di bawah judul modal (mis. dari form trip).</summary>
    [Parameter] public string? Keterangan { get; set; }
    /// <summary>Pesan toast setelah tersimpan; bawaan "Data berhasil diperbarui." / "Rute … tersimpan dengan No. Rute …".</summary>
    [Parameter] public Func<Rute, string>? PesanSukses { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Dipanggil setelah rute tersimpan, dengan rute hasil simpan (mis. untuk langsung dipilih di form trip).</summary>
    [Parameter] public EventCallback<Rute> OnTersimpan { get; set; }
    /// <summary>Rute yang ditambahkan ternyata sudah ada: pakai rute itu (form trip). Tanpa delegate = tombolnya tidak tampil.</summary>
    [Parameter] public EventCallback<Rute> OnPakai { get; set; }

    /// <summary>Ukuran container rute Priok.</summary>
    public static readonly string[] PilihanFeet = ["1X20", "1X40", "2X20", "1X20K", "1X40K"];

    private bool _aktif;
    private Rute? _editing;
    private string _nama = "", _feet = "", _catatan = "", _kode = "";
    /// <summary>No. Rute diketik sendiri: berhenti mengikuti Nama Rute sampai ikon generate ditekan.</summary>
    private bool _kodeManual;
    private long _uj, _tol, _harga;
    private readonly Dictionary<string, string> _galat = [];

    /// <summary>Feet = ukuran container, hanya untuk rute container Priok. Rute Karawang (alat berat) tidak memakainya.</summary>
    private bool PakaiFeet => Sesi.Workspace == WorkspaceKode.Priok;
    private string KolomNilai => PakaiFeet ? "col-sm-3" : "col-sm-4";
    private bool HargaWajib => _editing is null || _editing.Price > 0;
    /// <summary>Rute dari data asli belum punya ukuran container; wajib dipilih hanya untuk rute baru.</summary>
    private bool FeetWajib => PakaiFeet && (_editing is null || _editing.Feet != "");

    protected override void OnParametersSet()
    {
        if (Open && !_aktif) { _aktif = true; Mulai(); }
        else if (!Open) _aktif = false;
    }

    private void Mulai()
    {
        _editing = Rute;
        _galat.Clear();
        _kodeManual = false;
        if (_editing is not null)
        {
            _nama = _editing.RouteName; _feet = _editing.Feet; _uj = _editing.Ujroute; _tol = _editing.Toll; _harga = _editing.Price;
            _catatan = _editing.Catatan; _kode = _editing.RouteCode;
        }
        else
        {
            var asal = KodeArea.Rapikan(KodeAreaAsalAwal ?? "").Trim();
            _nama = asal != "" ? $"{asal} - " : ""; _feet = PakaiFeet ? "1X40" : ""; _uj = 0; _tol = 0; _harga = 0; _catatan = "";
            _kode = KodeOtomatis();
        }
    }

    private string? G(string k) => _galat.GetValueOrDefault(k);
    private static RenderFragment? Teks(string? s) => s is null ? null : b => b.AddContent(0, s);

    private string NamaRapi => Regex.Replace(_nama.Trim().ToUpperInvariant(), @"\s+", " ");
    private bool NamaLengkap => NamaRapi != "" && !Regex.IsMatch(NamaRapi, @"-\s*$");

    /// <summary>No. Rute dari nama (pembedanya ikut bila mirip rute lain); kosong selama nama belum lengkap.</summary>
    private string KodeOtomatis() => NamaLengkap ? Kode.KodeRuteDari(NamaRapi, Db.Semua.Rute) : "";
    private string KodeTampil => _editing?.RouteCode ?? _kode;

    /// <summary>Rute lain dengan nama yang sama, termasuk yang beda spasi / tanda baca ("CIB-DURI", "REBON JARO" = "REBONJARO").</summary>
    private Rute? Kembar
    {
        get
        {
            var k = KodeArea.KunciNamaRute(_nama);
            if (k.Length < 4 || Regex.IsMatch(_nama.Trim(), @"-\s*$")) return null;
            return Db.Data.Rute.FirstOrDefault(r => r.Id != _editing?.Id && KodeArea.KunciNamaRute(r.RouteName) == k);
        }
    }

    private RenderFragment? HintKembar(Rute? kembar)
    {
        if (kembar is null) return null;
        return @<span style="color:#8a6100">
            Sudah ada: <span class="fw-semibold">@kembar.RouteCode</span> @kembar.RouteName (Uang Jalan @Format.Rupiah(kembar.Ujroute), Harga Jual @Format.Rupiah(kembar.Price)).
            @if (OnPakai.HasDelegate)
            {
                <button type="button" class="btn btn-link p-0 fs-inherit fw-semibold align-baseline text-decoration-underline" style="color:inherit" @onclick="() => PakaiKembar(kembar)">Pakai rute ini</button>
            }
            else
            {
                <text>Tambahkan pembeda, mis. nomor site (CIB - RAWA 52) atau BCKLD.</text>
            }
        </span>;
    }

    private static readonly List<Opsi> FeetOpsi = PilihanFeet.Select(f => new Opsi(f, f)).ToList();
    private List<Opsi> OpsiFeet => FeetWajib ? FeetOpsi : [new Opsi("", "— belum diisi —"), .. FeetOpsi];

    private long NilaiForm(string k) => k switch { "ujroute" => _uj, "toll" => _tol, _ => _harga };
    private static long NilaiRute(Rute r, string k) => k switch { "ujroute" => r.Ujroute, "toll" => r.Toll, _ => r.Price };

    /// <summary>Nominal perkiraan yang belum diubah di form ini.</summary>
    private bool MasihKira(string k) => _editing?.EstimatedFields?.Contains(k) == true && NilaiForm(k) == NilaiRute(_editing, k);
    private RenderFragment? Kira(string k) => MasihKira(k) ? Teks("Masih perkiraan.") : null;

    private void UbahNama(ChangeEventArgs e)
    {
        _nama = e.Value?.ToString() ?? "";
        _galat.Remove("nama");
        if (_editing is null && !_kodeManual) { _kode = KodeOtomatis(); _galat.Remove("kode"); }
    }

    private void UbahKode(string v)
    {
        _kode = Regex.Replace(v.ToUpperInvariant(), @"\s+", "");
        _kodeManual = _kode != "";
        _galat.Remove("kode");
    }

    private void GenerateKode()
    {
        _kodeManual = false;
        _kode = KodeOtomatis();
        _galat.Remove("kode");
        if (_kode == "") _galat["kode"] = "Isi Nama Rute dulu.";
    }

    private bool Validasi()
    {
        _galat.Clear();
        var kembar = Kembar;
        if (!NamaLengkap) _galat["nama"] = "Nama Rute wajib diisi, mis. CIB - DURI.";
        else if (kembar is not null) _galat["nama"] = $"Sudah ada rute {kembar.RouteName} (No. Rute {kembar.RouteCode}).";
        if (_editing is null)
        {
            var kode = _kode.Trim();
            if (kode == "") _galat["kode"] = "No. Rute wajib diisi.";
            else if (Db.Semua.Rute.Any(r => r.RouteCode.Equals(kode, StringComparison.OrdinalIgnoreCase))) _galat["kode"] = $"No. Rute {kode} sudah dipakai rute lain.";
        }
        if (FeetWajib && _feet == "") _galat["feet"] = "Feet wajib dipilih.";
        // Rute dari data asli belum punya harga; jangan paksa diisi saat hanya mengubah UJ / tol.
        if (HargaWajib && _harga <= 0) _galat["harga"] = "Harga Jual harus lebih dari 0.";
        if (_uj < 0) _galat["uj"] = "Uang Jalan Rute tidak boleh negatif.";
        if (_tol < 0) _galat["tol"] = "Uang Tol tidak boleh negatif.";
        return _galat.Count == 0;
    }

    private async Task SimpanRute()
    {
        if (!Validasi()) return;
        var nama = NamaRapi;
        var catatan = _catatan.Trim();
        Rute tersimpan;
        if (_editing is not null)
        {
            var lama = _editing;
            // Nominal perkiraan yang diubah admin sudah bukan perkiraan lagi.
            var kira = lama.EstimatedFields?.Where(k => NilaiForm(k) == NilaiRute(lama, k)).ToList();
            Db.Ubah<Rute>(lama.Id, r =>
            {
                r.RouteName = nama; r.Feet = _feet; r.Ujroute = _uj; r.Toll = _tol; r.Price = _harga; r.Catatan = catatan; r.EstimatedFields = kira;
            });
            tersimpan = Db.Cari<Rute>(lama.Id) ?? lama;
        }
        else
        {
            // No. Rute dibuat sekali di sini dan tidak berubah lagi. Area mengikuti Nama Rute (tidak disimpan terpisah).
            tersimpan = Db.Buat(new Rute
            {
                RouteCode = _kode.Trim().ToUpperInvariant(), RouteName = nama, ProjectId = "", Feet = _feet,
                Ujroute = _uj, Toll = _tol, Commissioner = 0, Price = _harga, EstimatedFields = [], Catatan = catatan,
            });
        }
        Toast.Sukses(PesanSukses?.Invoke(tersimpan) ?? (_editing is not null ? "Data berhasil diperbarui." : $"Rute {tersimpan.RouteName} tersimpan dengan No. Rute {tersimpan.RouteCode}."));
        await OnTersimpan.InvokeAsync(tersimpan);
        await Tutup();
    }

    private async Task PakaiKembar(Rute r)
    {
        await OnPakai.InvokeAsync(r);
        await Tutup();
    }

    private Task Tutup() => OnClose.InvokeAsync();
}
