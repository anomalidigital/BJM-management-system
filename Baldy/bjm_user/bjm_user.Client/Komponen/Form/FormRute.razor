@* Modal Tambah / Ubah Rute (revisi 13 Okt 2026), dipakai menu Rute dan form trip (tambah rute di tempat). Urutannya: Area Pick Up &
   Area Destinasi (dari Master Alamat & rute lain; area baru cukup diketik di kotak cari, keputusan Baldy 15 Okt 2026), lalu Nama Rute
   sebagai kesimpulan keduanya. No. Rute dibuat otomatis dari nama saat disimpan dan tidak bisa diubah. Klien dipilih di form trip. *@
@using System.Text.RegularExpressions
@inherits KomponenData

<Modal Open="@(Open && _tambahAlamat is null)" Size="lg" Title="@(_editing is not null ? "Ubah Rute" : "Tambah Rute")" Subtitle="@Subjudul" OnClose="Tutup">
    <ChildContent>
        @if (Open)
        {
            var kembar = Kembar;
            <div class="row g-3">
                <Field Label="Area Pick Up" Required="@(_editing is null)" Error="@G("asal")" Hint="@HintArea("asal")" Class="col-sm-6">
                    <Pilihan Id="@context" Options="OpsiArea" Value="@_areaAsal" ValueChanged="@(v => PilihArea("asal", v))" Invalid="@(G("asal") is not null)" Cari="true"
                             Placeholder="Pilih area pick up..." SearchPlaceholder="Cari kode area, nama lokasi, atau kota..." Tambahan="@Tambahan("asal")" />
                </Field>
                <Field Label="Area Destinasi" Required="@(_editing is null)" Error="@G("tujuan")" Hint="@HintArea("tujuan")" Class="col-sm-6">
                    <Pilihan Id="@context" Options="OpsiArea" Value="@_areaTujuan" ValueChanged="@(v => PilihArea("tujuan", v))" Invalid="@(G("tujuan") is not null)" Cari="true"
                             Placeholder="Pilih area destinasi..." SearchPlaceholder="Cari kode area, nama lokasi, atau kota..." Tambahan="@Tambahan("tujuan")" />
                </Field>
                <Field Label="Nama Rute" Required Error="@G("nama")" Hint="@HintNama(kembar)" Class="col-sm-8">
                    <input id="@context" class="form-control text-uppercase @(G("nama") is not null ? "is-invalid" : "")" value="@_nama" placeholder="Terisi dari area" @oninput="UbahNama" />
                </Field>
                <Field Label="No. Rute" Class="col-sm-4" Hint="@Teks(_editing is not null ? $"Tetap, tidak bisa diubah.{(_editing.RouteCodeLama is not null ? $" Dulu {_editing.RouteCodeLama}." : "")}" : "Otomatis dari nama; pembeda (nomor site, BCKLD) ikut bila mirip rute lain.")">
                    <input id="@context" class="form-control tnum fw-semibold" value="@KodeTampil" readonly placeholder="Otomatis" />
                </Field>
                @if (PakaiFeet)
                {
                    <Field Label="Feet" Required="FeetWajib" Error="@G("feet")" Class="col-sm-4" Hint="@Teks(_feet == "" && G("feet") is null ? "Data asli belum mencatat ukuran container rute ini." : null)">
                        <Pilihan Id="@context" Options="OpsiFeet" Value="@_feet" ValueChanged="@(v => { _feet = v ?? ""; _galat.Remove("feet"); })" Invalid="@(G("feet") is not null)" Cari="false" Clearable="false" />
                    </Field>
                }
                <Field Label="Uang Jalan Rute" Required Error="@G("uj")" Class="col-sm-4" Hint="@Teks(MasihKira("ujroute") ? "Masih perkiraan." : "Patokan uang jalan.")">
                    <UangInput Id="@context" Value="_uj" ValueChanged="@(v => { _uj = v; _galat.Remove("uj"); })" Invalid="@(G("uj") is not null)" />
                </Field>
                <Field Label="Uang Tol" Error="@G("tol")" Class="col-sm-4" Hint="@Teks(MasihKira("toll") ? "Masih perkiraan." : "Patokan tol.")">
                    <UangInput Id="@context" Value="_tol" ValueChanged="@(v => { _tol = v; _galat.Remove("tol"); })" Invalid="@(G("tol") is not null)" />
                </Field>
                <Field Label="Harga" Required="HargaWajib" Error="@G("harga")" Class="col-sm-4"
                       Hint="@Teks(MasihKira("price") ? "Masih perkiraan." : _editing is not null ? "Harga baru berlaku untuk trip berikutnya; trip yang sudah ada tetap." : "Harga ke klien per trip.")">
                    <UangInput Id="@context" Value="_harga" ValueChanged="@(v => { _harga = v; _galat.Remove("harga"); })" Invalid="@(G("harga") is not null)" />
                </Field>
            </div>
        }
    </ChildContent>
    <Footer>
        <Tombol OnClick="Tutup">Batal</Tombol>
        <Tombol Variant="primary" OnClick="SimpanRute">@(_editing is not null ? "Simpan Perubahan" : "Simpan")</Tombol>
    </Footer>
</Modal>

<FormAlamat Open="@(Open && _tambahAlamat is not null)" NamaAwal="@_tambahAlamat?.Nama" KodeAwal="@_tambahAlamat?.Kode"
            Keterangan="@($"Area alamat baru langsung dipilih sebagai Area {(_tambahAlamat?.Sisi == "tujuan" ? "Destinasi" : "Pick Up")}.")"
            PesanSukses="PesanAlamat" OnClose="() => _tambahAlamat = null" OnTersimpan="AlamatTersimpan" />

@code {
    [Parameter] public bool Open { get; set; }
    /// <summary>Rute yang diubah; null = tambah rute baru.</summary>
    [Parameter] public Rute? Rute { get; set; }
    /// <summary>Isian awal Area Pick Up rute baru, mis. lokasi bongkar trip asal backload.</summary>
    [Parameter] public string? KodeAreaAsalAwal { get; set; }
    /// <summary>Pengganti keterangan di bawah judul modal.</summary>
    [Parameter] public string? Keterangan { get; set; }
    /// <summary>Pesan toast setelah tersimpan; bawaan "Data berhasil diperbarui." / "Rute … tersimpan dengan No. Rute …".</summary>
    [Parameter] public Func<Rute, string>? PesanSukses { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Dipanggil setelah rute tersimpan, dengan rute hasil simpan (mis. untuk langsung dipilih di form trip).</summary>
    [Parameter] public EventCallback<Rute> OnTersimpan { get; set; }
    /// <summary>Rute yang ditambahkan ternyata sudah ada: pakai rute itu (form trip). Tanpa delegate = tombolnya tidak tampil.</summary>
    [Parameter] public EventCallback<Rute> OnPakai { get; set; }

    /// <summary>Ukuran container rute Priok.</summary>
    public static readonly string[] PilihanFeet = ["1X20", "1X40", "2X20", "1X20K", "1X40K"];

    private sealed record IsianAlamat(string Sisi, string Nama, string? Kode);

    private bool _aktif;
    private Rute? _editing;
    private string _areaAsal = "", _areaTujuan = "", _nama = "", _feet = "";
    private long _uj, _tol, _harga;
    private IsianAlamat? _tambahAlamat;
    private readonly Dictionary<string, string> _galat = [];

    /// <summary>Feet = ukuran container, hanya untuk rute container Priok. Rute Karawang (alat berat) tidak memakainya.</summary>
    private bool PakaiFeet => Sesi.Workspace == WorkspaceKode.Priok;
    private bool HargaWajib => _editing is null || _editing.Price > 0;
    /// <summary>Rute dari data asli belum punya ukuran container; wajib dipilih hanya untuk rute baru.</summary>
    private bool FeetWajib => PakaiFeet && (_editing is null || _editing.Feet != "");

    protected override void OnParametersSet()
    {
        if (Open && !_aktif) { _aktif = true; Mulai(); }
        else if (!Open) { _aktif = false; _tambahAlamat = null; }
    }

    private void Mulai()
    {
        _editing = Rute;
        _galat.Clear();
        _tambahAlamat = null;
        if (_editing is not null)
        {
            var k = TripLogika.KodeArea(_editing);
            _areaAsal = k.Asal; _areaTujuan = k.Tujuan;
            _nama = _editing.RouteName; _feet = _editing.Feet; _uj = _editing.Ujroute; _tol = _editing.Toll; _harga = _editing.Price;
        }
        else
        {
            _areaAsal = KodeArea.Rapikan(KodeAreaAsalAwal ?? "").Trim(); _areaTujuan = "";
            _nama = NamaDariArea(_areaAsal, _areaTujuan); _feet = PakaiFeet ? "1X40" : ""; _uj = 0; _tol = 0; _harga = 0;
        }
    }

    private string? G(string k) => _galat.GetValueOrDefault(k);
    private static RenderFragment? Teks(string? s) => s is null ? null : b => b.AddContent(0, s);

    private string Subjudul => Keterangan ?? (_editing is not null
        ? $"No. Rute {_editing.RouteCode}{(_editing.RouteCodeLama is not null ? $" (dulu {_editing.RouteCodeLama})" : "")}"
        : "Tanda * wajib diisi. Pilih area pick up dan destinasi dulu.");

    /// <summary>Nama rute "ASAL - TUJUAN" dari dua kode area.</summary>
    private static string NamaDariArea(string asal, string tujuan) => asal != "" && tujuan != "" ? $"{asal} - {tujuan}" : asal != "" ? $"{asal} - " : "";

    private string NamaRapi => Regex.Replace(_nama.Trim().ToUpperInvariant(), @"\s+", " ");

    /// <summary>No. Rute: rute lama tetap; rute baru dibuat dari nama (pembedanya ikut bila mirip rute lain), tidak bisa diketik.</summary>
    private string KodeRute => _editing?.RouteCode ?? Kode.KodeRuteDari(NamaRapi, Db.Data.Rute);
    private string KodeTampil => _editing is null && _nama.Trim() == "" ? "" : KodeRute;

    /// <summary>Kode area yang punya alamat aktif di Master Alamat, dengan nama lokasinya.</summary>
    private Dictionary<string, List<string>> LokasiArea()
    {
        var lokasi = new Dictionary<string, List<string>>();
        foreach (var a in Db.Data.Alamat)
        {
            if (a.Status != "aktif" || a.KodeArea.Trim() == "") continue;
            var k = a.KodeArea.Trim().ToUpperInvariant();
            if (!lokasi.TryGetValue(k, out var l)) lokasi[k] = l = [];
            l.Add($"{a.Nama}{(a.Kota != "" ? $" ({a.Kota.Split(',')[0]})" : "")}");
        }
        return lokasi;
    }

    /// <summary>Pilihan area: kode area di Master Alamat dan rute lain; area baru yang diketik ikut tampil.</summary>
    private List<Opsi> OpsiArea
    {
        get
        {
            var pakai = KodeArea.Pemakaian(Db.Data.Rute, Db.Data.Alamat, _editing?.Id);
            var lokasi = LokasiArea();
            var opsi = pakai
                .OrderBy(p => lokasi.ContainsKey(p.Key) ? 0 : 1).ThenBy(p => p.Key, StringComparer.Ordinal)
                .Select(p => new Opsi(p.Key, p.Key,
                    string.Join(" · ", new[] { lokasi.TryGetValue(p.Key, out var l) ? string.Join(", ", l.Take(2)) : "belum ada alamat", p.Value.Rute > 0 ? $"{p.Value.Rute} rute" : "" }.Where(x => x != "")),
                    lokasi.TryGetValue(p.Key, out var l2) ? string.Join(" ", l2) : ""))
                .ToList();
            foreach (var baru in new[] { _areaAsal, _areaTujuan }.Distinct())
                if (baru != "" && opsi.All(o => o.Value != baru)) opsi.Insert(0, new Opsi(baru, baru, "area baru · belum ada alamat"));
            return opsi;
        }
    }

    private static readonly List<Opsi> FeetOpsi = PilihanFeet.Select(f => new Opsi(f, f)).ToList();
    private List<Opsi> OpsiFeet => FeetWajib ? FeetOpsi : [new Opsi("", "— belum diisi —"), .. FeetOpsi];

    /// <summary>Baris pertama dropdown area: ketikan dipakai sebagai area baru; tanpa ketikan = tambah alamat baru.</summary>
    private AksiTambahan Tambahan(string sisi) => new()
    {
        Label = q => q.Trim() == "" ? "Tambah alamat baru" : $"Pakai area “{KodeArea.Rapikan(q).Trim()}”",
        OnClick = q =>
        {
            var kode = KodeArea.Rapikan(q).Trim();
            if (kode == "") _tambahAlamat = new IsianAlamat(sisi, "", null);
            else PilihArea(sisi, kode);
            StateHasChanged();
            return Task.CompletedTask;
        },
        Disabled = !Bisa("master"),
        Hint = "Area belum terdaftar? Ketik kodenya lalu pakai; alamatnya bisa ditambahkan nanti.",
    };

    /// <summary>Petunjuk area: area tanpa alamat di Master Alamat ditawari Tambah alamat.</summary>
    private RenderFragment? HintArea(string sisi)
    {
        var kode = sisi == "asal" ? _areaAsal : _areaTujuan;
        var bawaan = sisi == "asal" ? "Lokasi muat. Cari dulu; belum ada? Tambah alamat." : "Lokasi bongkar.";
        if (kode == "" || LokasiArea().ContainsKey(kode.ToUpperInvariant())) return Teks(bawaan);
        return @<span>
            Area <span class="fw-semibold">@kode</span> belum punya alamat di Master Alamat.
            <button type="button" class="btn btn-link p-0 fs-inherit fw-semibold align-baseline text-decoration-underline" disabled="@(!Bisa("master"))"
                    @onclick="() => _tambahAlamat = new IsianAlamat(sisi, string.Empty, kode)">Tambah alamat @kode</button>
        </span>;
    }

    /// <summary>
    /// Rute lain dengan nama yang sama, termasuk yang beda spasi / tanda baca ("CIB-DURI", "REBON JARO" = "REBONJARO"):
    /// ditampilkan sejak area dipilih supaya rute kembar tidak dibuat lagi (Baldy 14 Okt 2026).
    /// </summary>
    private Rute? Kembar
    {
        get
        {
            var k = KodeArea.KunciNamaRute(_nama);
            if (k.Length < 4 || Regex.IsMatch(_nama.Trim(), @"-\s*$")) return null;
            return Db.Data.Rute.FirstOrDefault(r => r.Id != _editing?.Id && KodeArea.KunciNamaRute(r.RouteName) == k);
        }
    }

    private RenderFragment? HintNama(Rute? kembar)
    {
        if (kembar is null) return Teks("Kesimpulan dari area pick up dan destinasi. Boleh ditambah nomor site atau BCKLD, mis. CIB - RAWA 52.");
        return @<span style="color:#8a6100">
            Sudah ada: <span class="fw-semibold">@kembar.RouteCode</span> @kembar.RouteName (UJ @Format.Rupiah(kembar.Ujroute), Harga @Format.Rupiah(kembar.Price)).
            @if (OnPakai.HasDelegate)
            {
                <button type="button" class="btn btn-link p-0 fs-inherit fw-semibold align-baseline text-decoration-underline" style="color:inherit" @onclick="() => PakaiKembar(kembar)">Pakai rute ini</button>
            }
            else
            {
                <text>Tambahkan pembeda, mis. nomor site (CIB - RAWA 52) atau BCKLD.</text>
            }
        </span>;
    }

    private long NilaiForm(string k) => k switch { "ujroute" => _uj, "toll" => _tol, _ => _harga };
    private static long NilaiRute(Rute r, string k) => k switch { "ujroute" => r.Ujroute, "toll" => r.Toll, _ => r.Price };

    /// <summary>Nominal perkiraan yang belum diubah di form ini.</summary>
    private bool MasihKira(string k) => _editing?.EstimatedFields?.Contains(k) == true && NilaiForm(k) == NilaiRute(_editing, k);

    /// <summary>Ganti area: nama rute ikut berubah selama belum ditulis sendiri (masih sama dengan turunan area lama).</summary>
    private void PilihArea(string sisi, string? v)
    {
        var kode = v ?? "";
        var asalBaru = sisi == "asal" ? kode : _areaAsal;
        var tujuanBaru = sisi == "tujuan" ? kode : _areaTujuan;
        var namaLama = NamaDariArea(_areaAsal, _areaTujuan);
        var nama = _nama.Trim();
        if (nama == "" || nama == namaLama.Trim() || nama == $"{_areaAsal} -") _nama = NamaDariArea(asalBaru, tujuanBaru);
        if (sisi == "asal") _areaAsal = kode; else _areaTujuan = kode;
        _galat.Remove("nama"); _galat.Remove(sisi);
    }

    private void UbahNama(ChangeEventArgs e)
    {
        _nama = e.Value?.ToString() ?? "";
        _galat.Remove("nama");
    }

    private bool Validasi()
    {
        _galat.Clear();
        var wajibArea = _editing is null;
        if (wajibArea && _areaAsal == "") _galat["asal"] = "Area Pick Up wajib dipilih.";
        if (wajibArea && _areaTujuan == "") _galat["tujuan"] = "Area Destinasi wajib dipilih.";
        var nama = _nama.Trim();
        var kembar = Kembar;
        if (nama == "" || Regex.IsMatch(nama, @"-\s*$")) _galat["nama"] = "Nama Rute wajib lengkap: ASAL - TUJUAN.";
        else if (kembar is not null) _galat["nama"] = $"Sudah ada rute {kembar.RouteName} (No. Rute {kembar.RouteCode}).";
        if (FeetWajib && _feet == "") _galat["feet"] = "Feet wajib dipilih.";
        // Rute dari data asli belum punya harga; jangan paksa diisi saat hanya mengubah UJ / tol.
        if (HargaWajib && _harga <= 0) _galat["harga"] = "Harga harus lebih dari 0.";
        if (_uj < 0) _galat["uj"] = "Uang Jalan Rute tidak boleh negatif.";
        if (_tol < 0) _galat["tol"] = "Uang Tol tidak boleh negatif.";
        return _galat.Count == 0;
    }

    private async Task SimpanRute()
    {
        if (!Validasi()) return;
        var nama = NamaRapi;
        // Kode area disimpan bila berbeda dari turunan nama; sama / kosong = ikut nama (tidak tersimpan).
        var dariNama = TripLogika.KodeArea(nama, null, null);
        static string? KodeSimpan(string pilih, string turunan) => pilih != "" && TripLogika.NormalKodeArea(pilih) != TripLogika.NormalKodeArea(turunan) ? pilih : null;
        var asal = KodeSimpan(_areaAsal, dariNama.Asal);
        var tujuan = KodeSimpan(_areaTujuan, dariNama.Tujuan);
        Rute tersimpan;
        if (_editing is not null)
        {
            var lama = _editing;
            // Nominal perkiraan yang diubah admin sudah bukan perkiraan lagi.
            var kira = lama.EstimatedFields?.Where(k => NilaiForm(k) == NilaiRute(lama, k)).ToList();
            Db.Ubah<Rute>(lama.Id, r =>
            {
                r.RouteName = nama; r.Feet = _feet; r.Ujroute = _uj; r.Toll = _tol; r.Price = _harga;
                r.KodeAreaAsal = asal; r.KodeAreaTujuan = tujuan; r.EstimatedFields = kira;
            });
            tersimpan = Db.Cari<Rute>(lama.Id) ?? lama;
        }
        else
        {
            // No. Rute dibuat sekali di sini dan tidak berubah lagi.
            tersimpan = Db.Buat(new Rute
            {
                RouteCode = Kode.KodeRuteDari(nama, Db.Semua.Rute), RouteName = nama, ProjectId = "", Feet = _feet,
                Ujroute = _uj, Toll = _tol, Commissioner = 0, Price = _harga, EstimatedFields = [], KodeAreaAsal = asal, KodeAreaTujuan = tujuan,
            });
        }
        Toast.Sukses(PesanSukses?.Invoke(tersimpan) ?? (_editing is not null ? "Data berhasil diperbarui." : $"Rute {tersimpan.RouteName} tersimpan dengan No. Rute {tersimpan.RouteCode}."));
        await OnTersimpan.InvokeAsync(tersimpan);
        await Tutup();
    }

    private async Task PakaiKembar(Rute r)
    {
        await OnPakai.InvokeAsync(r);
        await Tutup();
    }

    private static string PesanAlamat(Alamat a) => $"{a.Nama} tersimpan di Master Alamat (area {a.KodeArea}).";

    private void AlamatTersimpan(Alamat a)
    {
        if (_tambahAlamat is not null) PilihArea(_tambahAlamat.Sisi, a.KodeArea.Trim().ToUpperInvariant());
    }

    private Task Tutup() => OnClose.InvokeAsync();
}
