@* Pasangan label kecil (kapital) + nilai, untuk blok informasi (dl). *@
<div class="min-w-0 @Class">
    <dt class="fs-11-5 fw-semibold text-ink-3 text-uppercase" style="letter-spacing:.04em">@Label</dt>
    <dd class="m-0 mt-1 fs-13 fw-medium text-ink text-truncate @(Mono ? "tnum" : "")">@if (ChildContent is not null) { @ChildContent } else { @Value }</dd>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public bool Mono { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
