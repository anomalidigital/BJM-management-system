@* Judul halaman + breadcrumb (tujuan dicari dari struktur menu) + aksi utama. *@
<header class="no-print mb-4">
    @if (Crumbs.Count > 0)
    {
        <nav aria-label="Breadcrumb" class="mb-1 d-flex align-items-center gap-1 fs-12 text-ink-3">
            @for (var i = 0; i < Crumbs.Count; i++)
            {
                var c = Crumbs[i]; var terakhir = i == Crumbs.Count - 1;
                var href = terakhir ? null : (c.Ke ?? Navigasi.CariHref(c.Label));
                <span class="d-flex align-items-center gap-1">
                    @if (i > 0) { <IkonSvg Def="Ikon.ChevronRight" Size="12" Class="opacity-50" /> }
                    @if (href is not null) { <a href="@href" title="@($"Buka {c.Label}")" class="text-ink-3 text-decoration-none remah">@c.Label</a> }
                    else { <span class="text-ink-2">@c.Label</span> }
                </span>
            }
        </nav>
    }
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
        <div class="min-w-0">
            <h1 class="m-0 fw-semibold text-ink lh-tight" style="font-size:19px; letter-spacing:-.01em">@Title</h1>
            @if (Description is not null) { <p class="m-0 mt-1 fs-13 text-ink-3" style="max-width:42rem; line-height:1.6">@Description</p> }
        </div>
        @if (Actions is not null) { <div class="d-flex flex-wrap align-items-center gap-2 mw-100">@Actions</div> }
    </div>
</header>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? Description { get; set; }
    [Parameter] public List<Crumb> Crumbs { get; set; } = [];
    [Parameter] public RenderFragment? Actions { get; set; }
}
