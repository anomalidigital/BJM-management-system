@* Isian tanggal (yyyy-mm-dd) memakai kalender bawaan browser. *@
<input id="@Id" type="date" class="form-control tnum @(Invalid ? "is-invalid" : "") @Class" value="@Value" min="@Min" max="@Max" disabled="@Disabled"
       aria-label="@AriaLabel" placeholder="@Placeholder" @onchange="Ubah" @oninput="Ubah" />

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Min { get; set; }
    [Parameter] public string? Max { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Pilih tanggal";

    private async Task Ubah(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "";
        if (v == Value) return;
        Value = v;
        await ValueChanged.InvokeAsync(v);
    }
}
