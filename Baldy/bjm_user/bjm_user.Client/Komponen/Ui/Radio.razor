@* Pilihan berbentuk kartu (radio): Callout / Dedicated, Ya / Tidak, ... *@
<label class="opsi-kartu @Class">
    <input type="radio" class="form-check-input" name="@Name" checked="@Checked" disabled="@Disabled" @onchange="() => OnChange.InvokeAsync()" />
    <span>
        <span class="judul-opsi">@Label</span>
        @if (Description is not null) { <span class="ket-opsi">@Description</span> }
    </span>
</label>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool Checked { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnChange { get; set; }
}
