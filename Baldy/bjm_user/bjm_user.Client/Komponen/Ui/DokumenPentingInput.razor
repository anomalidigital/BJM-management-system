@* Dokumen penting (KTP, SIM, ... / STNK, KIR, ...) sebagai tabel mini: satu baris per jenis dengan nomor dan tanggal berlaku bila
   jenisnya memakai, lalu baris Dokumen Lainnya (Baldy 22 Okt 2026: kotak upload besar terlalu berantakan). *@
<div class="dok-tabel">
    <div class="dok-baris dok-kepala" aria-hidden="true"><span>Dokumen</span><span>Nomor</span><span>Berlaku s/d</span><span>Berkas</span></div>
    @foreach (var j in Jenis)
    {
        var dok = Value.GetValueOrDefault(j.Kode);
        var s = StatusBerlaku(dok?.BerlakuSampai);
        <div class="dok-baris">
            <span class="dok-nama">@j.Label</span>
            <span class="min-w-0">
                @if (j.Nomor)
                {
                    <label for="@($"{_dasar}-{j.Kode}-no")" class="visually-hidden">No. @j.Label</label>
                    <input id="@($"{_dasar}-{j.Kode}-no")" class="form-control tnum" value="@(dok?.Nomor ?? "")" placeholder="@($"No. {j.Label}")"
                           @onchange="@(e => UbahNomor(j.Kode, e.Value?.ToString() ?? ""))" />
                }
                else { <span class="dok-kosong">—</span> }
            </span>
            <span class="min-w-0">
                @if (j.Berlaku)
                {
                    <label for="@($"{_dasar}-{j.Kode}-tgl")" class="visually-hidden">@($"{j.Label} Berlaku s/d")</label>
                    <TanggalInput Id="@($"{_dasar}-{j.Kode}-tgl")" Value="@(dok?.BerlakuSampai ?? "")" Invalid="@(s == "habis")" ValueChanged="@(v => UbahTanggal(j.Kode, v))" />
                    @if (s == "habis") { <span class="dok-status" style="color:var(--critical)">Sudah habis</span> }
                    else if (s == "segera") { <span class="dok-status" style="color:#8a6100">Habis dalam 30 hari</span> }
                }
                else { <span class="dok-kosong">—</span> }
            </span>
            <LampiranInput Nama="@j.Label" Value="@(dok?.Berkas ?? new List<string>())" ValueChanged="@(berkas => UbahBerkas(j.Kode, berkas))" />
        </div>
    }
    @if (LainnyaLabel is not null)
    {
        <div class="dok-baris">
            <span class="dok-nama">@LainnyaLabel</span>
            <span class="dok-lebar"></span>
            <LampiranInput Nama="@LainnyaLabel" Label="@($"Tambah {LainnyaLabel}")" Value="Lainnya" ValueChanged="LainnyaChanged" />
        </div>
    }
</div>

@code {
    [Parameter] public JenisDokumenPenting[] Jenis { get; set; } = [];
    [Parameter] public Dictionary<string, DokumenPenting> Value { get; set; } = [];
    [Parameter] public EventCallback<Dictionary<string, DokumenPenting>> ValueChanged { get; set; }
    [Parameter] public string? LainnyaLabel { get; set; }
    [Parameter] public List<string> Lainnya { get; set; } = [];
    [Parameter] public EventCallback<List<string>> LainnyaChanged { get; set; }

    private readonly string _dasar = "dok-" + Guid.NewGuid().ToString("N")[..6];

    private Task UbahBerkas(string kode, List<string> berkas) => Ubah(kode, d => d.Berkas = berkas);
    private Task UbahTanggal(string kode, string v) => Ubah(kode, d => d.BerlakuSampai = v == "" ? null : v);
    private Task UbahNomor(string kode, string v) => Ubah(kode, d => d.Nomor = v.Trim() == "" ? null : v.Trim());

    private async Task Ubah(string kode, Action<DokumenPenting> patch)
    {
        var baru = new Dictionary<string, DokumenPenting>(Value);
        var lama = baru.GetValueOrDefault(kode) ?? new DokumenPenting();
        var d = new DokumenPenting { Berkas = [.. lama.Berkas], BerlakuSampai = lama.BerlakuSampai, Nomor = lama.Nomor };
        patch(d);
        baru[kode] = d;
        await ValueChanged.InvokeAsync(baru);
    }

    /// <summary>Keadaan masa berlaku: habis, segera (≤ 30 hari), berlaku, atau "" (tidak dicatat).</summary>
    public static string StatusBerlaku(string? tanggal)
    {
        if (string.IsNullOrEmpty(tanggal)) return "";
        var hariIni = Format.HariIni();
        if (string.CompareOrdinal(tanggal, hariIni) < 0) return "habis";
        if (string.CompareOrdinal(tanggal, Format.TambahHari(hariIni, 30)) <= 0) return "segera";
        return "berlaku";
    }

    /// <summary>Dokumen penting yang disimpan: slot tanpa berkas, nomor, dan tanggal dibuang; kosong semua = null.</summary>
    public static Dictionary<string, DokumenPenting>? Rapikan(Dictionary<string, DokumenPenting> d)
    {
        var isi = d.Where(x => x.Value.Berkas.Count > 0 || !string.IsNullOrEmpty(x.Value.BerlakuSampai) || !string.IsNullOrWhiteSpace(x.Value.Nomor))
            .ToDictionary(x => x.Key, x => new DokumenPenting
            {
                Berkas = x.Value.Berkas,
                BerlakuSampai = string.IsNullOrEmpty(x.Value.BerlakuSampai) ? null : x.Value.BerlakuSampai,
                Nomor = string.IsNullOrWhiteSpace(x.Value.Nomor) ? null : x.Value.Nomor.Trim(),
            });
        return isi.Count > 0 ? isi : null;
    }

    public sealed record Ringkasan(List<string> Ada, int Total, List<string> Habis, List<string> Segera);

    public static Ringkasan Ringkas(JenisDokumenPenting[] jenis, Dictionary<string, DokumenPenting>? dokumen) => new(
        jenis.Where(j => (dokumen?.GetValueOrDefault(j.Kode)?.Berkas.Count ?? 0) > 0).Select(j => j.Label).ToList(),
        jenis.Length,
        jenis.Where(j => StatusBerlaku(dokumen?.GetValueOrDefault(j.Kode)?.BerlakuSampai) == "habis").Select(j => j.Label).ToList(),
        jenis.Where(j => StatusBerlaku(dokumen?.GetValueOrDefault(j.Kode)?.BerlakuSampai) == "segera").Select(j => j.Label).ToList());
}
