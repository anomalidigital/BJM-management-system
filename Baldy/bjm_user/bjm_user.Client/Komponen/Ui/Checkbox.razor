<label class="cek @Class" title="@Title">
    <input type="checkbox" class="form-check-input" checked="@Checked" disabled="@Disabled" @onchange="Ubah" />
    <span>@Label@ChildContent</span>
</label>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Title { get; set; }

    private async Task Ubah(ChangeEventArgs e)
    {
        var v = e.Value is bool b && b;
        Checked = v;
        await CheckedChanged.InvokeAsync(v);
    }
}
