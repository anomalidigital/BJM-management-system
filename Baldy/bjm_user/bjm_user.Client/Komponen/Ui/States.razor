@* Keadaan kosong / tidak ditemukan / galat. Pakai: <EmptyState Entity="rute" />, <NotFoundState OnReset=... />, <ErrorState Message=... /> *@
<div class="d-flex flex-column align-items-center justify-content-center px-4 py-5 text-center">
    <div class="mb-3 d-flex align-items-center justify-content-center rounded-circle border border-hairline bg-sunken text-ink-3" style="width:44px;height:44px">@Icon</div>
    <p class="m-0 fs-14 fw-semibold text-ink">@Title</p>
    <p class="m-0 mt-1 fs-13 text-ink-3" style="max-width:24rem; line-height:1.6">@Description</p>
    @if (Action is not null) { <div class="mt-3">@Action</div> }
</div>

@code {
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public RenderFragment? Action { get; set; }
}
