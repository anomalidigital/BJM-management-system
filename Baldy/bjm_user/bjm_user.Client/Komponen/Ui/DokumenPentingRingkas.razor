@* Tampilan dokumen penting + dokumen lainnya di halaman detail (hanya lihat). *@
@{
    var adaApa = Jenis.Any(j => Dokumen?.GetValueOrDefault(j.Kode) is { } d && (d.Berkas.Count > 0 || !string.IsNullOrEmpty(d.BerlakuSampai) || !string.IsNullOrEmpty(d.Nomor))) || Lainnya.Count > 0;
}
@if (!adaApa)
{
    <p class="m-0 fs-12-5 text-ink-3">@Kosong</p>
}
else
{
    <div class="d-flex flex-column gap-2">
        @foreach (var j in Jenis)
        {
            var dok = Dokumen?.GetValueOrDefault(j.Kode);
            var s = DokumenPentingInput.StatusBerlaku(dok?.BerlakuSampai);
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="flex-shrink-0 fs-12-5 fw-medium text-ink-2" style="width:7rem">@j.Label</span>
                @if ((dok?.Berkas.Count ?? 0) > 0) { <LampiranThumbs Ids="dok!.Berkas" Ukuran="40" /> } else { <span class="fs-12 text-ink-3">Belum ada</span> }
                @if (!string.IsNullOrEmpty(dok?.Nomor)) { <span class="tnum fs-12 text-ink-2">No. @dok.Nomor</span> }
                @if (!string.IsNullOrEmpty(dok?.BerlakuSampai))
                {
                    <Badge Tone="@(s == "habis" ? "critical" : s == "segera" ? "warning" : "good")">@(s == "habis" ? "Habis" : "s/d") @Format.Tanggal(dok.BerlakuSampai)</Badge>
                }
            </div>
        }
        @if (Lainnya.Count > 0)
        {
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="flex-shrink-0 fs-12-5 fw-medium text-ink-2" style="width:7rem">Lainnya</span>
                <LampiranThumbs Ids="Lainnya" Ukuran="40" />
            </div>
        }
    </div>
}

@code {
    [Parameter] public JenisDokumenPenting[] Jenis { get; set; } = [];
    [Parameter] public Dictionary<string, DokumenPenting>? Dokumen { get; set; }
    [Parameter] public List<string> Lainnya { get; set; } = [];
    [Parameter] public string Kosong { get; set; } = "Belum ada dokumen.";
}
