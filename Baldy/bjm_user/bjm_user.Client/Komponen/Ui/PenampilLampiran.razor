@* Tampilan penuh satu lampiran, bisa digeser ke lampiran lain. *@
@inject Lampiran LampiranSvc

@if (Ids.Count > 0)
{
    <div class="animate-in-fade position-fixed top-0 start-0 end-0 bottom-0 d-flex flex-column" style="z-index:1150;background:rgba(0,0,0,.85)" @onclick="OnTutup" tabindex="-1" @onkeydown="Kunci">
        <div class="d-flex align-items-center justify-content-between px-4 py-2 text-white" @onclick:stopPropagation="true">
            <p class="m-0 fs-13 text-truncate">@(_info?.Name ?? "Memuat...") <span class="opacity-50">· @(_i + 1) / @Ids.Count</span></p>
            <button type="button" class="btn btn-link text-white p-1" aria-label="Tutup" @onclick="OnTutup"><IkonSvg Def="Ikon.Xmark" Size="18" /></button>
        </div>
        <div class="position-relative d-flex flex-grow-1 align-items-center justify-content-center px-5 pb-4" @onclick:stopPropagation="true">
            @if (_i > 0)
            {
                <button type="button" class="btn position-absolute start-0 ms-2 rounded-circle text-white" style="background:rgba(255,255,255,.1)" aria-label="Sebelumnya" @onclick="() => Ke(_i - 1)"><IkonSvg Def="Ikon.ChevronLeft" Size="20" /></button>
            }
            @if (_info is null)
            {
                <span class="spinner-border text-white-50"></span>
            }
            else if (_info.Gambar)
            {
                <img src="@_info.Url" alt="@_info.Name" class="rounded-2" style="max-height:100%;max-width:100%;object-fit:contain" />
            }
            else
            {
                <a href="@_info.Url" target="_blank" rel="noreferrer" class="rounded-3 bg-white px-4 py-3 fs-13 fw-medium text-ink text-decoration-none">@(_info.Type == "application/pdf" ? "Buka" : "Unduh") @_info.Name</a>
            }
            @if (_i < Ids.Count - 1)
            {
                <button type="button" class="btn position-absolute end-0 me-2 rounded-circle text-white" style="background:rgba(255,255,255,.1)" aria-label="Berikutnya" @onclick="() => Ke(_i + 1)"><IkonSvg Def="Ikon.ChevronRight" Size="20" /></button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public List<string> Ids { get; set; } = [];
    [Parameter] public int Awal { get; set; }
    [Parameter] public EventCallback OnTutup { get; set; }

    private int _i;
    private InfoLampiran? _info;

    protected override async Task OnParametersSetAsync() { _i = Math.Clamp(Awal, 0, Math.Max(0, Ids.Count - 1)); await Muat(); }
    private async Task Ke(int i) { _i = Math.Clamp(i, 0, Ids.Count - 1); await Muat(); }
    private async Task Muat() { _info = Ids.Count > 0 ? await LampiranSvc.InfoAsync(Ids[_i]) : null; }
    private async Task Kunci(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await OnTutup.InvokeAsync();
        else if (e.Key == "ArrowRight") await Ke(_i + 1);
        else if (e.Key == "ArrowLeft") await Ke(_i - 1);
    }
}
