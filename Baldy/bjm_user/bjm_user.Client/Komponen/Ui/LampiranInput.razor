@* Isian lampiran untuk form: berkas langsung tersimpan ke IndexedDB saat dipilih; form hanya menerima daftar id.
   Melepas lampiran hanya mengeluarkannya dari daftar (berkas dibersihkan saat aplikasi dimuat).
   Ringkas (Baldy 22 Okt 2026): thumbnail kecil + satu tombol Upload kecil, sama di semua form. *@
@inject Lampiran LampiranSvc

<div class="min-w-0">
    <div class="d-flex flex-wrap align-items-center gap-1">
        @for (var i = 0; i < Value.Count; i++)
        {
            var idx = i; var id = Value[i];
            <UbinLampiran Id="@id" Ukuran="34" OnBuka="() => _buka = idx" OnHapus="() => Hapus(id)" />
        }
        <label class="lampiran-tambah m-0" title="@(Nama is not null ? $"Upload {Nama}" : Label)">
            @if (_mengunggah) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
            else { <IkonSvg Def="Ikon.FileArrowUp" Size="13" /> }
            <span>@(_mengunggah ? "Menyimpan..." : Value.Count > 0 ? "Tambah" : "Upload")</span>
            <input id="@Id" type="file" accept="@(Accept == "" ? null : Accept)" multiple disabled="@_mengunggah" aria-label="@(Nama is not null ? $"Tambah berkas {Nama}" : Label)" @ref="_input" @onchange="Pilih" />
        </label>
    </div>
    @if (_galat is not null) { <p class="m-0 mt-1 fs-12 fw-medium" style="color:var(--critical)">@_galat</p> }
    @if (_buka is int b) { <PenampilLampiran Ids="Value" Awal="b" OnTutup="() => _buka = null" /> }
</div>

@code {
    [Parameter] public List<string> Value { get; set; } = [];
    [Parameter] public EventCallback<List<string>> ValueChanged { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Accept { get; set; } = Lampiran.TipeDiterima;
    /// <summary>Nama aksi untuk pembaca layar dan tooltip, mis. "Tambah bukti".</summary>
    [Parameter] public string Label { get; set; } = "Tambah gambar";
    /// <summary>Slot satu jenis dokumen (mis. "KTP"): dipakai di keterangan tombol.</summary>
    [Parameter] public string? Nama { get; set; }

    private ElementReference _input;
    private bool _mengunggah;
    private int? _buka;
    private string? _galat;

    private async Task Pilih()
    {
        _mengunggah = true; _galat = null;
        try
        {
            var baru = await LampiranSvc.SimpanDariInputAsync(_input);
            if (baru.Count > 0) await ValueChanged.InvokeAsync([.. Value, .. baru]);
        }
        catch (Exception e) { _galat = e.Message; }
        finally { _mengunggah = false; }
    }

    private Task Hapus(string id) => ValueChanged.InvokeAsync(Value.Where(v => v != id).ToList());
}
